   oboInOwl:hasDbXref "Wikipedia:Levator_claviculae_muscle"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011251 ;
   owl:annotatedProperty obo:UBPROP_0000001 ;
   owl:annotatedTarget "Cleidocervicalis is one of two muscles, which make up the cleidocephalic component of the complex brachiocephalic muscle. It is a thin triangular muscle which has a broad origin on the median raphe of the mid dorsal aspect of the neck. The muscle is bounded caudally by the trapezius and cranially by the occipital component of the sternocephalicus . The cleidocervicalis tapers as it passes ventrally across the side of the neck to insert into the clavicular tendon. It is innervated by the accessory nerve. The brachiocephalic complex advances the limb, extends the shoulder joint and fixes the neck." ;
   oboInOwl:source "MURDOCH:378"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011251 ;
   owl:annotatedProperty obo:UBPROP_0000008 ;
   owl:annotatedTarget "The levator claviculae is an infrequently recognized anatomical variant in humans, distinguished from, for example, cervical adenopathy or a thrombosed vein, but a normal muscle in lower mammals and anthropoids. In humans, when present, it often appears unilaterally, most commonly on the left side, or bilaterally." ;
   oboInOwl:source "WP"
 ] .

