###  http://purl.obolibrary.org/obo/UBERON_2000673
obo:UBERON_2000673 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001637 ;
                   obo:IAO_0000115 "A pair of HA are connect one to each AA1. They run rostromedially until at the extreme rostro-ventral midline the two vessels merge and then run straight caudally along the ventral midline until they reach the cranial end of the ventral aorta (VA). There, the single HA passes just dorsal to the rostral end of the VA and then immediately splits again into a pair of HA. The paired HA continue caudally just to either side of the ventral midline. The HA provide blood supply to the ventral branchial region and the heart.sogai et al. 2001." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0000673" ;
                   oboInOwl:hasExactSynonym "HA" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2000673" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "hypobranchial artery" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000673 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A pair of HA are connect one to each AA1. They run rostromedially until at the extreme rostro-ventral midline the two vessels merge and then run straight caudally along the ventral midline until they reach the cranial end of the ventral aorta (VA). There, the single HA passes just dorsal to the rostral end of the VA and then immediately splits again into a pair of HA. The paired HA continue caudally just to either side of the ventral midline. The HA provide blood supply to the ventral branchial region and the heart.sogai et al. 2001." ;
   oboInOwl:hasDbXref "ZFIN:curator"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000673 ;
   owl:annotatedProperty obo:UBPROP_0000004 ;
   owl:annotatedTarget "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
   oboInOwl:source "http://purl.obolibrary.org/obo/tao.owl"
 ] .

