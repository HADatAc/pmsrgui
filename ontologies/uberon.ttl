                                     core:pheno_slim ,
                                     core:uberon_slim ;
                   rdfs:label "portal triad" ;
                   foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/6/62/Portal_triad.JPG"^^xsd:anyURI .

