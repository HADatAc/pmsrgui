###  http://purl.obolibrary.org/obo/UBERON_0005816
obo:UBERON_0005816 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0005813 ,
                                   obo:UBERON_4100000 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0002413
                                   ] ;
                   obo:IAO_0000115 "The posterior arch of a cervical vertebra forms about two-fifths of the circumference of the ring: it ends behind in the posterior tubercle, which is the rudiment of a spinous process and gives origin to the Recti capitis posteriores minores. The diminutive size of this process prevents any interference with the movements between the atlas and the skull." ;
                   oboInOwl:hasDbXref "FMA:24128" ,
                                      "Wikipedia:Posterior_tubercle_of_cervical_vertebra" ;
                   oboInOwl:hasExactSynonym "posterior costal tubercle of transverse process of cervical vertebra" ,
                                            "posterior tubercle of cervical vertebra" ,
                                            "tuberculum cervicales posterius vertebrae" ;
                   oboInOwl:hasOBONamespace "uberon" ;
