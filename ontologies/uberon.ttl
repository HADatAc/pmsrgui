                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "ray_number" ;
                   oboInOwl:is_metadata_tag "true"^^xsd:boolean ;
                   oboInOwl:shorthand "ray_number" ;
                   rdfs:comment "The correct terminology is yet to be established; in tetrapods 'ray' might mean the mereological sum of the phalanges of a manual digit plus a metatarsal bone (or equivalent for hindlimb)" ;
                   rdfs:label "ray number" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBPROP_0000104 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "x ray_number N if and only if (i) x is a ray, and (ii) x is ancestrally associated with ray number N in a series of phalanges repeated along a radio-ulnar or equivalent axis, with ray_number 1 being the anteriormost ray." ;
   oboInOwl:hasDbXref "https://orcid.org/0000-0002-6601-2165"
 ] .


###  http://purl.obolibrary.org/obo/UBPROP_0000105
obo:UBPROP_0000105 rdf:type owl:AnnotationProperty ;
                   obo:IAO_0000115 "x phalanx_number N if and only if (i) x is a phalanx, and (ii) x is phalanx number N in a series of phalanges repeated along an prixomo-distal axis, with phalanx_number 1 being the proximalmost phalanx. Note that in humans, the distalmost phalanx has phlanax_number 3, except in ray_number 1, where the distalmost has phalanx_number 2." ;
                   obo:UBPROP_0000101 obo:BSPO_0000100 ;
                   oboInOwl:hasDbXref "UBPROP:0000105" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "phalanx_number" ;
                   oboInOwl:is_metadata_tag "true"^^xsd:boolean ;
                   oboInOwl:shorthand "phalanx_number" ;
                   rdfs:comment "Most land mammals including humans have a 2-3-3-3-3 formula in both the hands (or paws) and feet. Primitive reptiles typically had the formula 2-3-4-4-5, and this pattern, with some modification, remained in many later reptiles and in the mammal-like reptiles. The phalangeal formula in the flippers of cetaceans (marine mammals) is 2-12-8-1" ;
                   rdfs:label "phalanx number" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBPROP_0000105 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "x phalanx_number N if and only if (i) x is a phalanx, and (ii) x is phalanx number N in a series of phalanges repeated along an prixomo-distal axis, with phalanx_number 1 being the proximalmost phalanx. Note that in humans, the distalmost phalanx has phlanax_number 3, except in ray_number 1, where the distalmost has phalanx_number 2." ;
   oboInOwl:hasDbXref "Wikipedia:Phalanx_bone#Phalangeal_formula" ,
                      "https://orcid.org/0000-0002-6601-2165"
 ] .


###  http://purl.obolibrary.org/obo/UBPROP_0000106
obo:UBPROP_0000106 rdf:type owl:AnnotationProperty ;
                   obo:IAO_0000115 "x rib_number N if and only if (i) x is a rib, and (ii) x is rib number N in a series of ribs repeated along an anterior-posterior axis, with rib_number 1 being the anteriormost rib. Note that this property counts ribs, *not* the adjoining vertebrae." ;
                   obo:UBPROP_0000008 "In the early tetrapods, every vertebra bore a pair of ribs, although those on the thoracic vertebrae are typically the longest. In most subsequent forms, many of these early ribs have been lost, and in living amphibians and reptiles, there is great variation in rib structure and number. For example, turtles have only eight pairs of ribs, which are developed into a bony or cartilagenous carapace and plastron, while snakes have numerous ribs running along the full length of their trunk. Frogs typically have no ribs, aside from a sacral pair, which form part of the pelvis. Mammals usually also only have distinct ribs on the thoracic vertebra, although fixed cervical ribs are also present in monotremes. In marsupials and placental mammals, the cervical and lumbar ribs are found only as tiny remnants fused to the vertebrae, where they are referred to as transverse processes. In general, the structure and number of the true ribs in humans is similar to that in other mammals. Unlike reptiles, caudal ribs are never found in mammals." ;
                   obo:UBPROP_0000012 "Note that in TAO, ribs are numbered by *vertebrae*" ;
                   obo:UBPROP_0000100 obo:UBERON_0002228 ;
                   obo:UBPROP_0000101 obo:BSPO_0000096 ;
                   oboInOwl:hasDbXref "UBPROP:0000106" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "rib_number" ;
                   oboInOwl:is_metadata_tag "true"^^xsd:boolean ;
                   oboInOwl:shorthand "rib_number" ;
                   rdfs:label "rib number" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBPROP_0000106 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "x rib_number N if and only if (i) x is a rib, and (ii) x is rib number N in a series of ribs repeated along an anterior-posterior axis, with rib_number 1 being the anteriormost rib. Note that this property counts ribs, *not* the adjoining vertebrae." ;
   oboInOwl:hasDbXref "https://orcid.org/0000-0002-6601-2165"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBPROP_0000106 ;
   owl:annotatedProperty obo:UBPROP_0000012 ;
   owl:annotatedTarget "Note that in TAO, ribs are numbered by *vertebrae*" ;
   oboInOwl:external_ontology "TAO"
 ] .


