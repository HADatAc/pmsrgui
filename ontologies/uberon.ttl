                                      "Wikipedia:External_ear" ,
                                      "XAO:0000190" ;
                   oboInOwl:hasExactSynonym "auricular region of head" ,
                                            "outer ear" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "auris externa" ;
                   oboInOwl:id "UBERON:0001691" ;
                   oboInOwl:inSubset core:efo_slim ,
                                     core:human_subset ,
                                     core:mouse_subset ,
                                     core:pheno_slim ,
