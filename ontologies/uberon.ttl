                   rdfs:subClassOf obo:UBERON_0002542 ,
                                   obo:UBERON_0004756 ,
                                   obo:UBERON_3000961 ;
                   obo:IAO_0000115 "Dermal bone that is thin, flexible, and platelike, and that develops in overlapping skinfolds that cover the body and often the head of fish and the bases of the fins." ;
