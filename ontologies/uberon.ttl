###  http://purl.obolibrary.org/obo/UBERON_0000040
obo:UBERON_0000040 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004177 ,
                                   obo:UBERON_0005057 ,
                                   obo:UBERON_0005178 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0002390
                                   ] ;
                   obo:IAO_0000115 "A hemopoietic organ found in elasmobranchs. Along with the spleen and special tissue around the gonads, this structure produces red blood cells and it is nestled along the top and bottom of the esophagus." ;
                   obo:UBPROP_0000008 "Found in elasmobranchs (sharks and rays) but with some exceptions." ;
                   oboInOwl:hasDbXref "Wikipedia:Leydig's_organ" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0000040" ;
                   oboInOwl:inSubset core:uberon_slim ;
                   rdfs:comment "Phenotype notes: Leydig's organ can be quite large - a 1.6-kilogram (3.5-pound) one was reported from a 1.8-metre (6-foot) long Bluntnose Sixgill Shark (Hexanchus griseus). Structure notes: divided into dorsal and ventral patches, gradation varies between species. Lacks erythroblasts and fat cells[Honma 1983]" ;
                   rdfs:label "Leydig's organ" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0000040 ;
