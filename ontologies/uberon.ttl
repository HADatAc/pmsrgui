###  http://purl.obolibrary.org/obo/UBERON_0008245
obo:UBERON_0008245 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001630 ;
                   obo:IAO_0000115 "A pennate muscle (also called a penniform muscle) is a muscle with fascicles that attach obliquely (in a slanting position) to its tendon. These types of muscles generally allow better stabilization and force production but less flexibility. Individual muscle fibers are formed into bundles of fasciculi and these bundles of fasciculi are formed into bundles of fascicles which compose the entire muscle itself. In a pennate muscle, the fascicles will form an angle with its central tendon. If all the fascicles are on the same side of the tendon, the pennate muscle is called unipennate. Examples of this include certain muscles in the manus. If there are fascicles on both sides of the central tendon, the pennate muscle is called bipennate. The rectus femoris, a large muscle in the quadriceps, is typical. If the central tendon branches within a pennate muscle, the muscle is called multipennate, as seen in the deltoid muscle in the shoulder." ;
                   obo:IAO_0000116 "TODO add child classes" ;
                   obo:UBPROP_0000012 "the FMA class does not denote a muscle organ." ;
                   oboInOwl:hasDbXref "FMA:74993" ,
                                      "Wikipedia:Pennate_muscle" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "penniform muscle" ;
                   oboInOwl:id "UBERON:0008245" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "pennate muscle" ;
                   foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/1/14/Rectus_femoris.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008245 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A pennate muscle (also called a penniform muscle) is a muscle with fascicles that attach obliquely (in a slanting position) to its tendon. These types of muscles generally allow better stabilization and force production but less flexibility. Individual muscle fibers are formed into bundles of fasciculi and these bundles of fasciculi are formed into bundles of fascicles which compose the entire muscle itself. In a pennate muscle, the fascicles will form an angle with its central tendon. If all the fascicles are on the same side of the tendon, the pennate muscle is called unipennate. Examples of this include certain muscles in the manus. If there are fascicles on both sides of the central tendon, the pennate muscle is called bipennate. The rectus femoris, a large muscle in the quadriceps, is typical. If the central tendon branches within a pennate muscle, the muscle is called multipennate, as seen in the deltoid muscle in the shoulder." ;
   oboInOwl:hasDbXref "Wikipedia:Pennate_muscle"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008245 ;
   owl:annotatedProperty obo:UBPROP_0000012 ;
   owl:annotatedTarget "the FMA class does not denote a muscle organ." ;
   oboInOwl:external_ontology "FMA"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008245 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "penniform muscle" ;
   oboInOwl:hasDbXref "Wikipedia:Pennate_muscle"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0008247
obo:UBERON_0008247 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000026 ;
                   obo:IAO_0000115 "One of the numerous external, fluid-filled muscular tubes of echinoderms, such as the starfish or sea urchin, serving as organs of locomotion, food handling, and respiration[BTO]. Tube feet consist of two parts: ampulla and podia. Ampulla contain both circular muscles and longitudinal muscle, whereas the podia contain the latter only. Thus the podia use suction to attach to the substratum[WP]." ;
                   oboInOwl:hasDbXref "BTO:0001919" ,
                                      "Wikipedia:Tube_feet" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "tube feet" ;
                   oboInOwl:id "UBERON:0008247" ;
                   rdfs:label "tube foot" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008247 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0000026 ;
   oboInOwl:source "cjm"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008247 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "One of the numerous external, fluid-filled muscular tubes of echinoderms, such as the starfish or sea urchin, serving as organs of locomotion, food handling, and respiration[BTO]. Tube feet consist of two parts: ampulla and podia. Ampulla contain both circular muscles and longitudinal muscle, whereas the podia contain the latter only. Thus the podia use suction to attach to the substratum[WP]." ;
   oboInOwl:hasDbXref "BTO:0001919" ,
                      "Wikipedia:Tube_feet"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008247 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "tube feet" ;
   oboInOwl:hasDbXref "Wikipedia:Tube_feet" ;
   oboInOwl:hasSynonymType obo:OMO_0003004
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0008251
obo:UBERON_0008251 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000467 ;
                   obo:IAO_0000115 "The water vascular system is a hydraulic system used by echinoderms, such as sea stars and sea urchins, for locomotion, food and waste transportation, and respiration. The system is composed of canals connecting numerous tube feet. Echinoderms move by alternately contracting muscles that force water into the tube feet, causing them to extend and push against the ground, then relaxing to allow the feet to retract." ;
                   oboInOwl:hasDbXref "BTO:0002125" ,
                                      "Wikipedia:Water_vascular_system" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0008251" ;
                   rdfs:label "water vascular system" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008251 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The water vascular system is a hydraulic system used by echinoderms, such as sea stars and sea urchins, for locomotion, food and waste transportation, and respiration. The system is composed of canals connecting numerous tube feet. Echinoderms move by alternately contracting muscles that force water into the tube feet, causing them to extend and push against the ground, then relaxing to allow the feet to retract." ;
   oboInOwl:hasDbXref "Wikipedia:Water_vascular_system"
 ] .


