###  http://purl.obolibrary.org/obo/UBERON_0001490
obo:UBERON_0001490 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002217 ,
                                   obo:UBERON_0003839 ,
                                   obo:UBERON_0011139 ,
