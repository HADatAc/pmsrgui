obo:UBERON_0001666 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001383 ;
                   obo:IAO_0000115 "The Flexor digitorum longus is situated on the tibial side of the leg. At its origin it is thin and pointed, but it gradually increases in size as it descends. This muscle serves to curl the second, third, fourth, and fifth toes (flexion of phalanges II-V). [WP,unvetted]." ;
                   oboInOwl:hasDbXref "BTO:0000466" ,
                                      "EMAPA:36248" ,
                                      "FMA:51071" ,
                                      "MA:0002299" ,
                                      "NCIT:C52921" ,
                                      "SCTID:181703002" ,
