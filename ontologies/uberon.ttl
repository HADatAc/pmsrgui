###  http://purl.obolibrary.org/obo/UBERON_0011512
obo:UBERON_0011512 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001325 ,
                                   _:genid13175 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002372 ;
                                     owl:someValuesFrom obo:UBERON_0003699
                                   ] ;
                   obo:IAO_0000115 "The fibers which form a sling for the rectum are named the Puborectalis or Sphincter recti. They arise from the lower part of the symphysis pubis, and from the superior fascia of the urogenital diaphragm. They meet with the corresponding fibers of the opposite side around the lower part of the rectum, and form for it a strong sling. Relaxation reduces the angle between rectum and anus, allowing defecation in conjunction with relaxation of the internal and external sphincters. Puborectalis is part of the levator ani group of muscles." ;
                   oboInOwl:hasDbXref "FMA:19091" ,
                                      "SCTID:244962004" ,
                                      "Wikipedia:Puborectalis_muscle" ;
                   oboInOwl:hasExactSynonym "puborectalis" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "puborectalis" ,
                                              "sphincter recti" ;
                   oboInOwl:id "UBERON:0011512" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "puborectalis muscle" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011512 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid13175 ;
