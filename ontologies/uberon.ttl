###  http://purl.obolibrary.org/obo/UBERON_0007642
obo:UBERON_0007642 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0006591 ;
                   obo:IAO_0000115 "A small ligament attached to the superior surface of the pulmonary trunk and the inferior surface of the aortic arch. It is a nonfunctional vestige of the ductus arteriosus, and is formed within three weeks of birth. The ligamentum arteriosum is closely related to the left recurrent laryngeal nerve, a branch of the left vagus nerve. After splitting from the left vagus nerve, the left recurrent laryngeal loops around the aortic arch posterior to the ligamentum arteriosum, after which it ascends to the larynx[WP]." ;
                   oboInOwl:hasDbXref "FMA:13421" ,
                                      "SCTID:198009004" ,
                                      "Wikipedia:Ligamentum_arteriosum" ;
                   oboInOwl:hasExactSynonym "Botallo's duct" ,
                                            "Botallo's ligament" ,
                                            "Harvey's ligament" ,
                                            "ligamentum arteriosum (ductus arteriosus)" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "arterial ligament" ;
                   oboInOwl:id "UBERON:0007642" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "ligamentum arteriosum" .

