###  http://purl.obolibrary.org/obo/UBERON_0008937
obo:UBERON_0008937 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000475 ;
                   obo:IAO_0000115 "Mollusks have three distinct divisions of their body. The head contains the sensory equipment (eyes, antennae, etc) and the primitive brain. The visceral hump, which is the main body, contains most of the organs, including a complete digestive and excretory tract as well as the reproductive organs. The visceral hump also includes the two external flaps of tissue, which are known as the mantle." ;
                   oboInOwl:hasDbXref "BTO:0001448" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "visceral sac" ;
                   oboInOwl:id "UBERON:0008937" ;
                   rdfs:label "visceral hump" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008937 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Mollusks have three distinct divisions of their body. The head contains the sensory equipment (eyes, antennae, etc) and the primitive brain. The visceral hump, which is the main body, contains most of the organs, including a complete digestive and excretory tract as well as the reproductive organs. The visceral hump also includes the two external flaps of tissue, which are known as the mantle." ;
   oboInOwl:hasDbXref "BTO:0001448" ,
                      "http://www.britannica.com/EBchecked/topic/630349/visceral-hump"
 ] .

