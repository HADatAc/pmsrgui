                                            "retro-auricular lymph node" ,
                                            "retro-auricular node" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "mastoid glands" ,
                                              "posterior auricular glands" ,
                                              "retroauricular lymph nodes" ;
