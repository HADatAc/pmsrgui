###  http://purl.obolibrary.org/obo/UBERON_2001584
obo:UBERON_2001584 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_4000174 ;
                   obo:IAO_0000115 "Caudal fin lepidotrichium that form part of the anterior dorsal and ventral series of lepidotrichia of the caudal fin that may be associated with a neural spine or an epural or an uroneural (dorsal series) and with a haemal spine of a preural vertebra (ventral series). Caudal procurrent rays are shorter than the caudal principal rays. A caudal procurrent ray is an unpaired median bone." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0001584" ;
                   oboInOwl:hasExactSynonym "caudal precurrent ray" ,
                                            "caudal procurrent lepidotrichium" ,
                                            "caudal spiny ray" ,
                                            "rudimentary ray" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2001584" ;
                   rdfs:label "caudal procurrent ray" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2001584 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Caudal fin lepidotrichium that form part of the anterior dorsal and ventral series of lepidotrichia of the caudal fin that may be associated with a neural spine or an epural or an uroneural (dorsal series) and with a haemal spine of a preural vertebra (ventral series). Caudal procurrent rays are shorter than the caudal principal rays. A caudal procurrent ray is an unpaired median bone." ;
   oboInOwl:hasDbXref "TAO:Arratia_2008" ,
                      "TAO:GA_TG"
 ] .

