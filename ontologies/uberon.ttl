   owl:annotatedProperty oboInOwl:hasBroadSynonym ;
   owl:annotatedTarget "peristomium" ;
   oboInOwl:hasDbXref "Wikipedia:Peristomium"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0018651
