                                      "SCTID:181268008" ,
                                      "TAO:0000123" ,
                                      "UMLS:C0023884" ,
                                      "VHOG:0000257" ,
                                      "Wikipedia:Liver" ,
                                      "XAO:0000133" ,
                                      "ZFA:0000123" ,
                                      "galen:Liver" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "iecur" ,
                                              "jecur" ;
                   oboInOwl:id "UBERON:0002107" ;
