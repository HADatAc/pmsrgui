###  http://purl.obolibrary.org/obo/UBERON_0011264
obo:UBERON_0011264 rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( obo:UBERON_0000161
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:BFO_0000050 ;
                                                                owl:someValuesFrom obo:UBERON_0011263
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf obo:UBERON_0000161 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0011263
                                   ] ;
                   obo:IAO_0000115 "Femoral pores are a part of a holocrine secretory gland found on the inside of the thighs of certain lizards and amphisbaenians which releases pheromones to attract mates or mark territory. In certain species only the male has these pores and in other species, both sexes have them, with the males being larger.[1] Femoral pores appear as a series of pits or holes within a row of scales on the ventral portion of the animal's thigh." ;
                   obo:UBPROP_0000008 "Femoral pores are present in all genera in the families Cordylidae, Crotaphytidae, Hoplocercidae, Iguanidae, Phrynosomatidae, and Xantusiidae. They are absent in all genera in the Anguidae, Chamaeleonidae, Dibamidae, Helodermatidae, Scincidae, Xenosauridae, and Varanidae families.[1] They are present in other lizards and amphisbaenians quite variably, some geckoes, Phelsuma, for example have these pores, others in the same family do not" ;
                   oboInOwl:hasDbXref "Wikipedia:Femoral_pore" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0011264" ;
                   rdfs:label "femoral pore" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011264 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Femoral pores are a part of a holocrine secretory gland found on the inside of the thighs of certain lizards and amphisbaenians which releases pheromones to attract mates or mark territory. In certain species only the male has these pores and in other species, both sexes have them, with the males being larger.[1] Femoral pores appear as a series of pits or holes within a row of scales on the ventral portion of the animal's thigh." ;
   oboInOwl:hasDbXref "Wikipedia:Femoral_pore"
 ] .

[ rdf:type owl:Axiom ;
