                   rdfs:subClassOf obo:UBERON_0004375 ,
                                   obo:UBERON_0004376 ,
                                   obo:UBERON_0008907 ,
                                   obo:UBERON_0010741 ;
                   obo:IAO_0000115 "Pectoral axillary process is an elongate structure formed by one or more additional postcleithra or modified scales or a combination of both, that is firmly attached to a skin fold above the articular condyle of the uppermost pectoral fin ray or lepidotrichium 1." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2002087" ;
                   rdfs:comment "For additional information see Arratia (1997)." ;
                   rdfs:label "pectoral axillary process" .

