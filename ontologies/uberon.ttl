###  http://purl.obolibrary.org/obo/UBERON_0010373
obo:UBERON_0010373 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004119 ,
                                   obo:UBERON_0004529 ;
                   obo:IAO_0000115 "In the head of the pancreas, the angle of junction of the lower and left lateral borders forms a prolongation, termed the uncinate process. During the embryonic development of the distal foregut, the duodenum c-shape is formed while rotating the ventral pancreatic bud into the dorsal bud. The dorsal and ventral pancreatic buds fuse. The dorsal pancreatic bud becomes the body, tail, and isthmus of the pancreas and the ventral pancreatic bud forms the pancreatic head and uncinate process[WP]." ;
                   oboInOwl:hasBroadSynonym "processus uncinatus" ,
                                            "uncinate process" ;
                   oboInOwl:hasDbXref "EMAPA:17509" ,
                                      "FMA:15857" ,
                                      "NCIT:C62432" ,
                                      "SCTID:245383008" ,
                                      "UMLS:C0227580" ,
                                      "Wikipedia:Uncinate_process_of_pancreas" ;
                   oboInOwl:hasExactSynonym "Winslow's pancreas" ,
                                            "lesser pancreas" ,
                                            "processus uncinatus (pancreas)" ,
                                            "processus uncinatus pancreatis" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0010373" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
