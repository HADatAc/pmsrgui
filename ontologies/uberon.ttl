###  http://purl.obolibrary.org/obo/UBERON_0001396
obo:UBERON_0001396 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001637 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0001467
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002170 ;
                                     owl:someValuesFrom obo:UBERON_0001394
                                   ] ;
                   obo:IAO_0000115 "A blood vessel that supplies oxygenated blood to the lateral structures of the thorax and breast. It originates from the axillary artery and follows the lower border of the Pectoralis minor muscle to the side of the chest, supplies the serratus ventralis muscle and the Pectoralis major muscle, and sends branches across the axilla to the axillary lymph nodes and Subscapularis muscle. It anastomoses with the internal thoracic artery, subscapular, and intercostal arteries, and with the pectoral branch of the thoracoacromial artery. In the female it supplies an external mammary branch which turns round the free edge of the Pectoralis major and supplies the breasts. [WP,unvetted]." ;
                   oboInOwl:hasDbXref "EMAPA:37095" ,
                                      "FMA:22674" ,
                                      "MA:0001989" ,
                                      "NCIT:C52951" ,
                                      "SCTID:206135006" ,
                                      "UMLS:C0226421" ,
                                      "Wikipedia:Lateral_thoracic_artery" ;
                   oboInOwl:hasExactSynonym "external mammary artery" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "arteria thoracalis lateralis" ;
                   oboInOwl:id "UBERON:0001396" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ,
                                     core:uberon_slim ;
                   rdfs:label "lateral thoracic artery" ;
                   foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/4/4c/Axillary_branches.PNG"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001396 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A blood vessel that supplies oxygenated blood to the lateral structures of the thorax and breast. It originates from the axillary artery and follows the lower border of the Pectoralis minor muscle to the side of the chest, supplies the serratus ventralis muscle and the Pectoralis major muscle, and sends branches across the axilla to the axillary lymph nodes and Subscapularis muscle. It anastomoses with the internal thoracic artery, subscapular, and intercostal arteries, and with the pectoral branch of the thoracoacromial artery. In the female it supplies an external mammary branch which turns round the free edge of the Pectoralis major and supplies the breasts. [WP,unvetted]." ;
   oboInOwl:hasDbXref "Wikipedia:Lateral_thoracic_artery"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001396 ;
   owl:annotatedProperty oboInOwl:hasDbXref ;
   owl:annotatedTarget "EMAPA:37095" ;
   oboInOwl:source "MA:th"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001396 ;
   owl:annotatedProperty oboInOwl:hasDbXref ;
   owl:annotatedTarget "UMLS:C0226421" ;
   oboInOwl:source "ncithesaurus:Lateral_Thoracic_Artery"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001396 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "arteria thoracalis lateralis" ;
   oboInOwl:hasDbXref "Wikipedia:Lateral_thoracic_artery" ;
   oboInOwl:hasSynonymType obo:OMO_0003011
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0001397
obo:UBERON_0001397 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001637 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002170 ;
                                     owl:someValuesFrom obo:UBERON_0001394
                                   ] ;
                   obo:IAO_0000115 "The subscapular artery, the largest branch of the axillary artery, arises at the lower border of the Subscapularis, which it follows to the inferior angle of the scapula, where it anastomoses with the lateral thoracic and intercostal arteries and with the descending branch of the transverse cervical, and ends in the neighboring muscles. About 4 cm. from its origin it gives off two branches, first the scapular circumflex artery and then the thoracodorsal artery. [WP,unvetted]." ;
                   oboInOwl:hasDbXref "EMAPA:37116" ,
                                      "FMA:22677" ,
                                      "MA:0002050" ,
                                      "NCIT:C33650" ,
                                      "SCTID:244311006" ,
