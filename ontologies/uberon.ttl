   owl:annotatedProperty obo:UBPROP_0000002 ;
   owl:annotatedTarget "relationship loss: overlaps basioccipital-exoccipital joint (TAO:0002038)[TAO]" ;
   oboInOwl:date_retrieved "2012-08-14" ;
   oboInOwl:external_class "TAO:0000472" ;
   oboInOwl:ontology "TAO"
 ] .

