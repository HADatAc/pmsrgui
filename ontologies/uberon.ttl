###  http://purl.obolibrary.org/obo/UBERON_0011251
obo:UBERON_0011251 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002377 ,
                                   obo:UBERON_0004518 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0011364
                                   ] ,
                                   _:genid12976 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002372 ;
                                     owl:someValuesFrom obo:UBERON_0002413
                                   ] ,
                                   _:genid12979 ;
                   obo:IAO_0000115 "A skeletal muscle in the posterior triangle of the neck. It originates on the transverse processes of the upper cervical vertebrae and is inserted in the lateral half of the clavicle." ;
                   obo:UBPROP_0000001 "Cleidocervicalis is one of two muscles, which make up the cleidocephalic component of the complex brachiocephalic muscle. It is a thin triangular muscle which has a broad origin on the median raphe of the mid dorsal aspect of the neck. The muscle is bounded caudally by the trapezius and cranially by the occipital component of the sternocephalicus . The cleidocervicalis tapers as it passes ventrally across the side of the neck to insert into the clavicular tendon. It is innervated by the accessory nerve. The brachiocephalic complex advances the limb, extends the shoulder joint and fixes the neck." ;
                   obo:UBPROP_0000008 "The levator claviculae is an infrequently recognized anatomical variant in humans, distinguished from, for example, cervical adenopathy or a thrombosed vein, but a normal muscle in lower mammals and anthropoids. In humans, when present, it often appears unilaterally, most commonly on the left side, or bilaterally." ;
                   oboInOwl:hasDbXref "Wikipedia:Levator_claviculae_muscle" ;
                   oboInOwl:hasExactSynonym "cleidocervicalis" ,
                                            "cleidocervicalis muscle" ,
                                            "levator claviculae" ,
                                            "musculus levator claviculae" ,
                                            "omocervicalis" ,
                                            "tracheloacromial muscle" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "pars cervicalis" ;
                   oboInOwl:id "UBERON:0011251" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "levator claviculae muscle" .

_:genid12976 rdf:type owl:Restriction ;
              owl:onProperty obo:RO_0002372 ;
              owl:someValuesFrom obo:UBERON_0001077 .

_:genid12979 rdf:type owl:Restriction ;
              owl:onProperty obo:RO_0002373 ;
              owl:someValuesFrom obo:UBERON_0001105 .

