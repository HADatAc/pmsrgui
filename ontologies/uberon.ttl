###  http://purl.obolibrary.org/obo/UBERON_0010397
obo:UBERON_0010397 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001473 ;
                   obo:IAO_0000115 "Lymphatic vessel that exits the lymph node. The efferent lymphatic vessel commences from the lymph sinuses of the medullary portion of the lymph nodes and leave the lymph nodes either to veins or greater nodes. Efferent lymphatic vessels are also found in the thymus and spleen. This is in contrast to afferent lymphatic vessels, which are found only in lymph nodes." ;
                   oboInOwl:hasDbXref "MA:0000749" ,
                                      "Wikipedia:Efferent_lymph_vessel" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "efferent lymphatic vessel" ,
