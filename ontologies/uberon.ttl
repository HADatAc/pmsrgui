                   rdfs:comment "Resembles the subcommisural organ structurally, ultrastructurally and immunochemically[Niewenhuys] Gives rise to Reissner's fiber; however secretions are not identical to those of SCO [PMID:9550137][DOI:10.1007/BF00303086]" ;
                   rdfs:label "infundibular organ" .


###  http://purl.obolibrary.org/obo/UBERON_0011359
obo:UBERON_0011359 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002368 ,
                                   obo:UBERON_0004121 ,
                                   obo:UBERON_0005174 ,
                                   _:genid4496 ;
                   obo:IAO_0000115 "This is a neurosecretory organ rostral to the ampulla caudalis on the ventral surface of the distal end of the spinal cord. Receives axons from caudal neurosecretory nucleus, which contains Dahlgren cells that secrete urotensin I and II, implicated in osmotic regulation, cardiovascular function and reproduction[Butler]." ;
                   oboInOwl:hasDbXref "BTO:0001848" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0011359" ;
                   rdfs:comment "Shares characteristics with neurohypophysis" ;
                   rdfs:label "urophysis" .

