###  http://purl.obolibrary.org/obo/UBERON_0007268
obo:UBERON_0007268 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0007522 ;
                   obo:IAO_0000115 "The upper esophageal sphincter (UES) (also called the Pharyngoesophageal sphincter) refers to the superior portion of the esophagus. Unlike the lower esophageal sphincter, it consists of striated muscle and is under conscious control. The primary muscle of the UES is the cricopharyngeus portion of the inferior pharyngeal constrictor. During swallowing the upper esophageal sphincter opens so the bolus can pass into the esophagus. A secondary role of the UES is to reduce backflow from the esophagus into the pharynx." ;
                   oboInOwl:hasDbXref "FMA:265203" ,
                                      "MESH:D049631" ,
                                      "NCIT:C33836" ,
                                      "UMLS:C1451819" ,
                                      "Wikipedia:Upper_esophageal_sphincter" ;
                   oboInOwl:hasExactSynonym "pharyngoesophageal sphincter" ,
                                            "upper esophageal sphincter muscle" ,
                                            "upper oesophageal sphincter" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0007268" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "upper esophageal sphincter" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/2/22/Musculusconstrictorpharyngisinferior.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007268 ;
   owl:annotatedProperty oboInOwl:hasExactSynonym ;
   owl:annotatedTarget "upper oesophageal sphincter" ;
   oboInOwl:hasDbXref "Wikipedia:Upper_esophageal_sphincter"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007268 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The upper esophageal sphincter (UES) (also called the Pharyngoesophageal sphincter) refers to the superior portion of the esophagus. Unlike the lower esophageal sphincter, it consists of striated muscle and is under conscious control. The primary muscle of the UES is the cricopharyngeus portion of the inferior pharyngeal constrictor. During swallowing the upper esophageal sphincter opens so the bolus can pass into the esophagus. A secondary role of the UES is to reduce backflow from the esophagus into the pharynx." ;
   oboInOwl:hasDbXref "Wikipedia:Upper_esophageal_sphincter"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007268 ;
   owl:annotatedProperty oboInOwl:hasDbXref ;
   owl:annotatedTarget "MESH:D049631" ;
   sssom:author_id <https://orcid.org/0000-0001-9439-5346> ;
   sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration> ;
   sssom:mapping_provider "https://github.com/biopragmatics/biomappings"
 ] .

