###  http://purl.obolibrary.org/obo/UBERON_0004289
obo:UBERON_0004289 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000062 ;
                   obo:IAO_0000115 "An anatomical structure found in mollusks and used for feeding. It is a minutely toothed, chitinous ribbon. It is typically used for scraping or cutting food before the food enters the esophagus. The radula is unique to the molluscs, and is found in all classes of mollusks except for the bivalves." ;
                   oboInOwl:hasDbXref "BTO:0001506" ,
                                      "Wikipedia:Radula" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0004289" ;
                   rdfs:comment "The first bona fide radula dates to the Early Cambrian,[3] although trace fossils from the earlier Ediacaran have been suggested to have been made by the radula of the organism Kimberella.[WP]" ;
                   rdfs:label "radula" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0004289 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An anatomical structure found in mollusks and used for feeding. It is a minutely toothed, chitinous ribbon. It is typically used for scraping or cutting food before the food enters the esophagus. The radula is unique to the molluscs, and is found in all classes of mollusks except for the bivalves." ;
   oboInOwl:hasDbXref "Wikipedia:Radula"
 ] .


