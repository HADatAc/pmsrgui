###  http://purl.obolibrary.org/obo/UBERON_2002158
obo:UBERON_2002158 rdf:type owl:Class ;
                   obo:IAO_0000115 "Compound endochdondral and dermal bone that results from the fusion of the dermal dermopalatine and the endochondral autopalatine and forms the antero-lateral region of the palate. Commonly, it articulates with the maxilla antero-laterally and with the ethmoidal region medially. The palatine is paired." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2002158" ;
                   rdfs:comment "Depending on the teleostean group, the palatine may articulate with the entopterygoid posteriorly. The term palatine is usually used for the more advanced teleosts with a large autopalatine and a small dermopalatine represented by a few teeth." ;
                   rdfs:label "obsolete palatine" ;
                   owl:deprecated "true"^^xsd:boolean .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2002158 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Compound endochdondral and dermal bone that results from the fusion of the dermal dermopalatine and the endochondral autopalatine and forms the antero-lateral region of the palate. Commonly, it articulates with the maxilla antero-laterally and with the ethmoidal region medially. The palatine is paired." ;
   oboInOwl:hasDbXref "TAO:GA_TG"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2002158 ;
   owl:annotatedProperty obo:UBPROP_0000004 ;
   owl:annotatedTarget "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
   oboInOwl:source "http://purl.obolibrary.org/obo/tao.owl"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_2002159
obo:UBERON_2002159 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_2002082 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_4000167
                                   ] ;
                   obo:IAO_0000115 "Basal fulcrum that precedes a caudal fin lobe. Arratia, G. 2009. Identifying patterns of diversity of the actinopterygian fulcra. Acta Zoologica (Stockholm) 90 (Suppl. 1): 220-235." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasExactSynonym "caudal basal fulcra" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2002159" ;
                   rdfs:comment "Caudal basal fulcra precede the bases of both lobes of the caudal fin or only the dorsal one in basal teleosts. Most teleosts lack basal fulcra on the caudal fin. For additional information on basal fulcra see Arratia (2008, 2009)." ;
                   rdfs:label "caudal basal fulcrum" .

