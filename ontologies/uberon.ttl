###  http://purl.obolibrary.org/obo/UBERON_0003130
obo:UBERON_0003130 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0010000 ;
                   obo:IAO_0000115 "Ventral portion of a segment of an arthropod thorax or abdomen. In insects, the sterna are usually single, large sclerites, and external. However, they can sometimes be divided in two or more, in which case the subunits are called sternites, and may also be modified on the terminal abdominal segments so as to form part of the functional genitalia, in which case they are frequently reduced in size and development, and may become internalized and/or membranous." ;
                   obo:IAO_0000116 "this term should be ceded to the arthropod anatomy ontology" ;
                   oboInOwl:hasBroadSynonym "sternum" ;
                   oboInOwl:hasDbXref "FBbt:00004557" ,
                                      "HAO:0000956" ,
                                      "Wikipedia:Sternum_(arthropod)" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0003130" ;
                   rdfs:label "arthropod sternum" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0003130 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Ventral portion of a segment of an arthropod thorax or abdomen. In insects, the sterna are usually single, large sclerites, and external. However, they can sometimes be divided in two or more, in which case the subunits are called sternites, and may also be modified on the terminal abdominal segments so as to form part of the functional genitalia, in which case they are frequently reduced in size and development, and may become internalized and/or membranous." ;
   oboInOwl:hasDbXref "Wikipedia:Sternum_(arthropod)"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0003130 ;
   owl:annotatedProperty oboInOwl:hasDbXref ;
   owl:annotatedTarget "FBbt:00004557" ;
   sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0003131
