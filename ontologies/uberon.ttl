###  http://purl.obolibrary.org/obo/UBERON_0001388
obo:UBERON_0001388 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004256 ,
                                   _:genid2271 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
