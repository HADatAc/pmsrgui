###  http://purl.obolibrary.org/obo/UBERON_0004722
obo:UBERON_0004722 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002429 ,
                                   obo:UBERON_0015918 ;
                   obo:IAO_0000115 "The deep cervical lymph nodes are a group of cervical lymph nodes found near the internal jugular vein. They can be divided into upper and lower groups, or superior and inferior groups. Alternatively, they can be divided into deep anterior cervical lymph nodes and deep lateral cervical lymph nodes. They can also be divided into three groups: superior deep jugular, middle deep jugular, and 'inferior deep jugular'." ;
                   oboInOwl:hasDbXref "EMAPA:37510" ,
                                      "MA:0002885" ,
                                      "NCIT:C32431" ,
                                      "SCTID:279145002" ,
                                      "UMLS:C0458298" ,
                                      "Wikipedia:Deep_cervical_lymph_nodes" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "lower jugular nodes" ,
                                              "middle jugular nodes" ,
                                              "upper jugular nodes" ;
                   oboInOwl:id "UBERON:0004722" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "deep cervical lymph node" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/b/b6/Illu_lymph_chain02.jpg"^^xsd:anyURI .

