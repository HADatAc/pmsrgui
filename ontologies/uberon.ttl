   owl:annotatedProperty oboInOwl:hasBroadSynonym ;
   owl:annotatedTarget "rib skeletal element" ;
   oboInOwl:hasDbXref "https://github.com/obophenotype/uberon/wiki/Modeling-endochondral-elements-Design-Pattern"
 ] .

