###  http://purl.obolibrary.org/obo/UBERON_0007316
obo:UBERON_0007316 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001355 ,
                                   obo:UBERON_0004573 ,
                                   obo:UBERON_0013137 ,
                                   _:genid10025 ,
                                   _:genid10027 ,
                                   _:genid10029 ;
                   obo:IAO_0000115 "The deep external pudendal artery (deep external pudic artery), more deeply seated than the superficial external pudendal artery, passes medialward across the Pectineus and the Adductor longus muscles; it is covered by the fascia lata, which it pierces at the medial side of the thigh, and is distributed, in the male, to the integument of the scrotum and perineum, in the female to the labium majus; its branches anastomose with the scrotal (or labial) branches of the perineal artery." ;
                   oboInOwl:hasDbXref "FMA:20739" ,
                                      "SCTID:31708008" ,
                                      "Wikipedia:Deep_external_pudendal_artery" ;
                   oboInOwl:hasExactSynonym "arteria pudenda externa profunda" ,
