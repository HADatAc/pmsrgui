###  http://purl.obolibrary.org/obo/UBERON_0011967
obo:UBERON_0011967 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002292 ,
                                   _:genid1218 ;
                   obo:IAO_0000115 "The facet of the tubercle of the rib forms an articulation with the adjacent transverse process of a thoracic vertebra. This is a plane type synovial joint called the costotransverse joint. This articulation is present in all but the eleventh and twelfth ribs. Ribs 1 to 10 have two joints in close proximity posteriorly; the costovertebral joints and the costotranseverse joints. This arrangement restrains the motion of the ribs allowing them to work in a parallel fashion during breathing. If a typical rib had only one joint posteriorly the resultant swivel action would allow a rib to be non-parallel with respect to the neighboring ribs making for a very inefficient respiratory mechanism. The ventral rami innervate the costotransverse joints. Therefore, therapeutic medial branch blocks are ineffectual. The ligaments of the joint are: Articular capsule Posterior costotransverse Anterior costotransverse Ligament of the neck of the rib Ligament of the tubercle of the rib." ;
                   oboInOwl:hasDbXref "FMA:7952" ,
                                      "SCTID:263328007" ,
                                      "Wikipedia:Costotransverse_joint" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "costotransverse articulation" ;
                   oboInOwl:id "UBERON:0011967" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "costotransverse joint" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011967 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0002292 ;
   oboInOwl:source "FMA"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011967 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1218 ;
   oboInOwl:source "FMA"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011967 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The facet of the tubercle of the rib forms an articulation with the adjacent transverse process of a thoracic vertebra. This is a plane type synovial joint called the costotransverse joint. This articulation is present in all but the eleventh and twelfth ribs. Ribs 1 to 10 have two joints in close proximity posteriorly; the costovertebral joints and the costotranseverse joints. This arrangement restrains the motion of the ribs allowing them to work in a parallel fashion during breathing. If a typical rib had only one joint posteriorly the resultant swivel action would allow a rib to be non-parallel with respect to the neighboring ribs making for a very inefficient respiratory mechanism. The ventral rami innervate the costotransverse joints. Therefore, therapeutic medial branch blocks are ineffectual. The ligaments of the joint are: Articular capsule Posterior costotransverse Anterior costotransverse Ligament of the neck of the rib Ligament of the tubercle of the rib." ;
   oboInOwl:hasDbXref "Wikipedia:Costotransverse_joint"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011967 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "costotransverse articulation" ;
   oboInOwl:hasDbXref "Wikipedia:Costotransverse_joint"
 ] .


