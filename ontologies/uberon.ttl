   owl:annotatedSource obo:UBERON_2002087 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Pectoral axillary process is an elongate structure formed by one or more additional postcleithra or modified scales or a combination of both, that is firmly attached to a skin fold above the articular condyle of the uppermost pectoral fin ray or lepidotrichium 1." ;
   oboInOwl:hasDbXref "TAO:GA_TG" ,
