                                     core:pheno_slim ,
                                     core:uberon_slim ,
                                     core:vertebrate_core ;
                   rdfs:label "ciliary body" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/1/1e/Schematic_diagram_of_the_human_eye_en.svg"^^xsd:anyURI .

