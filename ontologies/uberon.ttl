###  http://purl.obolibrary.org/obo/UBERON_0001398
obo:UBERON_0001398 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001637 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002170 ;
                                     owl:someValuesFrom obo:UBERON_0001394
                                   ] ;
                   obo:IAO_0000115 "The brachial artery is the major blood vessel of the (upper) arm. It is the continuation of the axillary artery beyond the lower margin of teres major muscle. It continues down the ventral surface of the arm until it reaches the cubital fossa at the elbow. It then divides into the radial and ulnar arteries which run down the forearm. In some individuals, the bifurcation occurs much earlier and the ulnar and radial arteries extend through the upper arm. The pulse of the brachial artery is palpable on the anterior aspect of the elbow, medial to the tendon of the biceps, and, with the use of a stethoscope and sphygmomanometer (blood pressure cuff) often used to measure the blood pressure. The brachial artery is closely related to the median nerve; in proximal regions, the median nerve is immediately lateral to the brachial artery. Distally, the median nerve crosses the medial side of the brachial artery and lies anterior to the elbow joint. [WP,unvetted]." ;
                   obo:UBPROP_0000001 "Part of the subclavian artery which supplies blood to the forelimb.[AAO]" ;
                   oboInOwl:hasDbXref "AAO:0010504" ,
                                      "EFO:0004231" ,
                                      "FMA:22689" ,
                                      "GAID:475" ,
                                      "MA:0001921" ,
                                      "MESH:D001916" ,
                                      "NCIT:C12681" ,
                                      "SCTID:181322008" ,
                                      "UMLS:C0006087" ,
                                      "Wikipedia:Brachial_artery" ,
                                      "galen:BrachialArtery" ;
                   oboInOwl:hasExactSynonym "brachial part of trunk of subclavian artery" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "arteria brachialis" ;
                   oboInOwl:id "UBERON:0001398" ;
                   oboInOwl:inSubset core:efo_slim ,
                                     core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ,
                                     core:uberon_slim ;
                   rdfs:label "brachial artery" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/7/7d/Gray525.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001398 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The brachial artery is the major blood vessel of the (upper) arm. It is the continuation of the axillary artery beyond the lower margin of teres major muscle. It continues down the ventral surface of the arm until it reaches the cubital fossa at the elbow. It then divides into the radial and ulnar arteries which run down the forearm. In some individuals, the bifurcation occurs much earlier and the ulnar and radial arteries extend through the upper arm. The pulse of the brachial artery is palpable on the anterior aspect of the elbow, medial to the tendon of the biceps, and, with the use of a stethoscope and sphygmomanometer (blood pressure cuff) often used to measure the blood pressure. The brachial artery is closely related to the median nerve; in proximal regions, the median nerve is immediately lateral to the brachial artery. Distally, the median nerve crosses the medial side of the brachial artery and lies anterior to the elbow joint. [WP,unvetted]." ;
   oboInOwl:hasDbXref "Wikipedia:Brachial_artery"
 ] .

