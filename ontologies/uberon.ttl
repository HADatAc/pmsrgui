###  http://purl.obolibrary.org/obo/UBERON_0009554
obo:UBERON_0009554 rdf:type owl:Class ;
                   obo:IAO_0000115 "The bottommost bone in the equine leg and is encased by the hoof capsule. The distal phalanx articulates with both the middle phalanx and the distal sesamoid, forming the distal interphalangeal joint." ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0009554" ;
                   rdfs:comment "Was made obsolete in favor of the more generic grouping" ;
                   rdfs:label "obsolete coffin bone" ;
                   owl:deprecated "true"^^xsd:boolean .

