obo:UBERON_0007722 rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( obo:UBERON_0006658
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:BFO_0000050 ;
