###  http://purl.obolibrary.org/obo/UBERON_7500071
obo:UBERON_7500071 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000475 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0003128
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0004089
                                   ] ;
                   obo:IAO_0000115 "An anatomical structure that protrudes from the head region. In vertebrates, this includes the part of the cranium (skull) in front of the zygomatic arches that also holds the teeth, palat, and nasal cavity. In invertebrates it is the forward extension of the carapace and/or the piercing mouthparts." ;
                   terms:contributor <https://orcid.org/0000-0003-2699-3066> ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "beak" ,
                                              "muzzle" ,
                                              "snout" ;
                   oboInOwl:id "UBERON:7500071" ;
                   oboInOwl:inSubset core:mouse_subset ;
                   rdfs:label "rostrum" .

