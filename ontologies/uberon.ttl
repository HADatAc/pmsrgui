                   oboInOwl:is_metadata_tag "true"^^xsd:boolean ;
                   oboInOwl:shorthand "appendage_segment_number" ;
                   rdfs:comment "Examples: in dropsphila coxa=1, trochanter=2, femur=3, tibia=4, tarsal segments 1-5=5-9, pretarsus=10" ;
                   rdfs:label "appendage segment number" .

[ rdf:type owl:Axiom ;
