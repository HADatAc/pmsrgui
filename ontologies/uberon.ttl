###  http://purl.obolibrary.org/obo/UBERON_0008815
obo:UBERON_0008815 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004119 ,
                                   obo:UBERON_0013765 ;
                   obo:IAO_0000115 "An organ formed from the perforation between the point of contact between ectoderm and endoderm in the pharynx. The slits assist in filtering food particles from the water." ;
                   obo:IAO_0000116 "requires review. Kardong uses the term pharyngeal slit for Chondrichthyans. 'branchial slit' may also be used for amniote structures." ;
                   obo:UBPROP_0000008 "Some hemichordate species can have as many as 200 gill slits" ,
                                      "homologous to pharyngeal pouches" ,
                                      "may have been present in deuterostome ancestor[PMID:11961109]" ;
                   oboInOwl:hasDbXref "Wikipedia:Pharyngeal_slit" ;
