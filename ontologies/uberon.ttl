###  http://purl.obolibrary.org/obo/UBERON_0015878
obo:UBERON_0015878 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0015877 ;
                   obo:IAO_0000115 "The external iliac lymph nodes, from eight to ten in number, lie along the external iliac vessels. They are arranged in three groups, one on the lateral, another on the medial, and a third on the anterior aspect of the vessels; the third group is, however, sometimes absent. Their principal afferents are derived from the inguinal lymph nodes, the deep lymphatics of the abdominal wall below the umbilicus and of the adductor region of the thigh, and the lymphatics from the glans penis vel clitoridis, the membranous urethra, the prostate, the fundus of the urinary bladder, the cervix uteri, and upper part of the vagina." ;
                   oboInOwl:hasDbXref "FMA:12806" ,
                                      "MA:0003066" ,
                                      "NCIT:C32761" ,
                                      "SCTID:314889004" ,
                                      "UMLS:C0229807" ,
                                      "Wikipedia:External_iliac_lymph_nodes" ;
                   oboInOwl:hasExactSynonym "common iliac node" ,
                                            "iliac lymph node" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "external iliac glands" ,
                                              "external iliac lymph gland" ,
                                              "iliac lymph node" ,
                                              "noduli iliaci superficiales" ;
                   oboInOwl:id "UBERON:0015878" ;
