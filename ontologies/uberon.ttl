###  http://purl.obolibrary.org/obo/UBERON_0017653
obo:UBERON_0017653 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001044 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0007375
                                   ] ;
                   obo:IAO_0000115 "A gland located at the pre-nasal area being divided anteriorly by the ascendent processes of the intermaxillary bone." ;
                   obo:RO_0002175 obo:NCBITaxon_377294 ;
                   obo:UBPROP_0000008 "The intermaxillary gland is the first salivary gland to appear in the vertebrate evolution. Its duct system is uniformly lined by ciliated cells and scattered secretory cells. This indicates that in the evolution, of salivary glands, there was a diversification of the duct system, together with progressxve concentration of secretory cells in special áreas of this system" ;
                   obo:UBPROP_0000009 "Although usually described in the literature as mucous, the secretory cells of the intermaxillary gland have serous characteristics." ;
                   oboInOwl:hasBroadSynonym "intermaxillary gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0017653" ;
                   rdfs:label "intermaxillary salivary gland" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0017653 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A gland located at the pre-nasal area being divided anteriorly by the ascendent processes of the intermaxillary bone." ;
   oboInOwl:hasDbXref "DOI:10.1590/S0101-81751988000400003"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0017653 ;
   owl:annotatedProperty obo:UBPROP_0000008 ;
   owl:annotatedTarget "The intermaxillary gland is the first salivary gland to appear in the vertebrate evolution. Its duct system is uniformly lined by ciliated cells and scattered secretory cells. This indicates that in the evolution, of salivary glands, there was a diversification of the duct system, together with progressxve concentration of secretory cells in special áreas of this system" ;
   oboInOwl:source "DOI:10.1590/S0101-81751988000400003"
 ] .


