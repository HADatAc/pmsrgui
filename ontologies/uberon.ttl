obo:RO_0002286 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002384 ;
               obo:IAO_0000115 "Inverse of developmentally preceded by" ;
               rdfs:label "developmentally succeeded by"@en .


