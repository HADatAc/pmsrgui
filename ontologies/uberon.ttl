                   foaf:depiction "https://cdn.humanatlas.io/digital-objects/ref-organ/liver-female/v1.2/assets/3d-vh-f-liver.glb"^^xsd:anyURI ,
                                  "https://cdn.humanatlas.io/digital-objects/ref-organ/liver-male/v1.2/assets/3d-vh-m-liver.glb"^^xsd:anyURI ,
                                  "https://upload.wikimedia.org/wikipedia/commons/6/64/Leber_Schaf.jpg"^^xsd:anyURI .

