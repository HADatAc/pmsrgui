                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0008440
                                   ] ;
                   obo:IAO_0000115 "A membranous region of skin between the digits." ;
                   obo:UBPROP_0000008 "Normally in mammals, webbing is present in the embryo but resorbed later in development, but in various mammal species it occasionally persists in adulthood In humans, it can be found in those suffering from LEOPARD syndrome and from Aarskog-Scott syndrome. Webbing between the digits of the hindfoot is also present in several mammals that spend part of their time in the water" ;
                   obo:UBPROP_0000009 "Webbing accommodates movement in the water[WP]" ;
                   oboInOwl:hasBroadSynonym "web" ;
                   oboInOwl:hasDbXref "Wikipedia:Interdigital_webbing" ;
                   oboInOwl:hasExactSynonym "interdigital webbing" ,
                                            "syndactylous interdigital region" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0006015" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "webbed interdigital region" .

