                   obo:IAO_0000116 "Can be subclassed based on position relative to terminal branches of the vessel. Consider adding subclasses for these: (a) ileal, in relation to the ileal branch of the artery;(b) anterior ileocolic, usually of three glands, in the ileocolic fold, near the wall of the cecum;(c) posterior ileocolic, mostly placed in the angle between the ileum and the colon, but partly lying behind the cecum at its junction with the ascending colon;(d) a single gland, between the layers of the mesenteriole of the vermiform process;(e) right colic, along the medial side of the ascending colon." ;
                   obo:UBPROP_0000001 "A lymph node at the ileocecocolic junction." ;
                   oboInOwl:hasDbXref "FMA:16611" ,
                                      "MA:0003065" ,
                                      "NCIT:C77653" ,
                                      "SCTID:29180003" ,
                                      "UMLS:C2697661" ,
                                      "Wikipedia:Ileocolic_lymph_nodes" ;
                   oboInOwl:hasExactSynonym "nodi lymphoidei ileocolici" ;
                   oboInOwl:hasNarrowSynonym "ileocecocolic lymph node" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "ileocolic node" ;
                   oboInOwl:id "UBERON:0016378" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "ileocolic lymph node" .

