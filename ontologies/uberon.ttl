###  http://purl.obolibrary.org/obo/UBERON_0011117
obo:UBERON_0011117 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0011112 ;
                   obo:IAO_0000115 "The superior tibiofibular articulation is an arthrodial joint between the lateral condyle of the tibia and the head of the fibula. The contiguous surfaces of the bones present flat, oval facets covered with cartilage and connected together by an articular capsule and by anterior and posterior ligaments. When the term 'tibiofibular articulation' is used without a modifier, it refers to the superior, and not the inferior tibiofibular articulation." ;
                   oboInOwl:hasBroadSynonym "tibiofibular joint" ;
                   oboInOwl:hasDbXref "FMA:35184" ,
                                      "MESH:D007719" ,
                                      "SCTID:182208008" ,
                                      "Wikipedia:Superior_tibiofibular_joint" ;
                   oboInOwl:hasExactSynonym "proximal tibiofibular joint" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "articulatio tibiofibularis" ,
                                              "proximal tibiofibular joint" ,
                                              "proximal tibiofibular syndesmosis" ,
                                              "superior tibiofibular articulation" ;
                   oboInOwl:id "UBERON:0011117" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "superior tibiofibular joint" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/a/a8/Gray347.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
