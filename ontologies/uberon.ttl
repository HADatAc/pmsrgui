                                   _:genid10036 ;
                   obo:IAO_0000115 "An artery that arises from the medial side of the femoral artery, close to the superficial epigastric artery and superficial iliac circumflex artery." ;
                   oboInOwl:hasDbXref "FMA:20738" ,
                                      "SCTID:47954000" ,
                                      "Wikipedia:Superficial_external_pudendal_artery" ;
