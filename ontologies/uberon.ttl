###  http://purl.obolibrary.org/obo/UBERON_0005306
obo:UBERON_0005306 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0007567 ;
                   obo:IAO_0000115 "A blastema is a mass of cells capable of growth and regeneration into organs or body parts. Historically blastema have been thought to be composed of undifferentiated pluripotent cells, but recent research indicates that in some organisms blastema may retain memory of tissue origin.[1] Blastemata are typically found in the early stages of an organism's development such as in embryos, and in the regeneration of tissues, organs and bone[WP]. A regenerating tissue composed of a proliferative mass of undifferentiated progenitor cells from which new differentiated structures arise[ZFA]." ;
                   obo:UBPROP_0000012 "the ZFA class called 'blastema' belongs with the subclass, blastema of regenerating fin/limb" ;
                   oboInOwl:hasDbXref "BTO:0001638" ,
                                      "EFO:0003658" ,
                                      "TAO:0001270" ,
                                      "Wikipedia:Blastema" ,
                                      "XAO:0004060" ;
                   oboInOwl:hasExactSynonym "blastemata" ,
                                            "regeneration blastema" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0005306" ;
                   oboInOwl:inSubset core:efo_slim ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "blastema" .

