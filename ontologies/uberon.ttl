###  http://purl.obolibrary.org/obo/UBERON_0010229
obo:UBERON_0010229 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004111 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty core:channel_for ;
                                     owl:someValuesFrom obo:UBERON_0001913
                                   ] ;
                   obo:IAO_0000115 "A muscular structure at the lower end of the esophagus that, when closed, forms a tube allowing milk to go directly into the abomasum. (This prevents milk from being fermented or soured by the ruminal microorganisms)." ;
                   oboInOwl:hasBroadSynonym "esophageal groove" ,
                                            "reticular groove" ;
                   oboInOwl:hasDbXref "BTO:0004789" ,
                                      "SCTID:86149002" ;
                   oboInOwl:hasExactSynonym "ruminant reticular groove" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0010229" ;
                   rdfs:comment "The formation of the esophageal groove is controlled by neural stimulation from suckling and milk proteins. This means milk, colostrum, and milk replacer bypass the rumen, while water enters it. This is modelled as the structure itself, rather that the space of the groove, see https://github.com/obophenotype/uberon/pull/2691 for more information." ;
                   rdfs:label "ruminant esophageal groove" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0010229 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A muscular structure at the lower end of the esophagus that, when closed, forms a tube allowing milk to go directly into the abomasum. (This prevents milk from being fermented or soured by the ruminal microorganisms)." ;
   oboInOwl:hasDbXref "http://www.extension.org/pages/16468/esophageal-groove"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0010229 ;
   owl:annotatedProperty oboInOwl:hasBroadSynonym ;
   owl:annotatedTarget "esophageal groove" ;
   oboInOwl:hasSynonymType core:SENSU
 ] .

[ rdf:type owl:Axiom ;
