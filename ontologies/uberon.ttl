###  http://purl.obolibrary.org/obo/UBERON_0011619
obo:UBERON_0011619 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002513 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0010272
                                   ] ;
                   obo:IAO_0000115 "This is the paired bone that makes up the segment of the mammalian hyoid apparatus connecting the epihyoids with the skull via the tympanohyoid cartilages on each side. Ventrally, it defines the medial and lateral compartments of the guttural pouch in the horse." ;
                   obo:UBPROP_0000008 "The stylohyoid bone is one of the four bones ( stylohyoid, ceratohyoid, basihyoid, thyrohyoid) of the hyoid apparatus in the horse. Other species have five bones, the fifth being the epihyoid that is not present in the horse. The stylohyoid bone in the horse is significantly larger compared to other bones of the hyoid apparatus and divides the guttural pouch into two chambers, medial and lateral. The hyoid apparatus consists of a series of bony rods, jointed together and forming a means of suspending the tongue and larynx from the skull" ;
                   oboInOwl:hasDbXref "SCTID:370715004" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0011619" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "stylohyoid bone" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011619 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "This is the paired bone that makes up the segment of the mammalian hyoid apparatus connecting the epihyoids with the skull via the tympanohyoid cartilages on each side. Ventrally, it defines the medial and lateral compartments of the guttural pouch in the horse." ;
   oboInOwl:hasDbXref "MURDOCH:1758"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011619 ;
   owl:annotatedProperty obo:UBPROP_0000008 ;
   owl:annotatedTarget "The stylohyoid bone is one of the four bones ( stylohyoid, ceratohyoid, basihyoid, thyrohyoid) of the hyoid apparatus in the horse. Other species have five bones, the fifth being the epihyoid that is not present in the horse. The stylohyoid bone in the horse is significantly larger compared to other bones of the hyoid apparatus and divides the guttural pouch into two chambers, medial and lateral. The hyoid apparatus consists of a series of bony rods, jointed together and forming a means of suspending the tongue and larynx from the skull" ;
   oboInOwl:source "MURDOCH"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0011620
obo:UBERON_0011620 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004530 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0011618
                                   ] ;
                   obo:IAO_0000115 "A projection on the basihyal bone. Laterally the lingual process is compressed. It has a blunt pointed free end, and its lateral surfaces are slightly concave. The dorsal border is thin and irregular, and the ventral border is thick and rough. In the living animal the lingual process is embedded within the root of the tongue." ;
                   oboInOwl:hasExactSynonym "lingual process of basihyoid" ,
                                            "lingual process of basihyoid bone" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "lingual process of hyoid" ;
                   oboInOwl:id "UBERON:0011620" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "basihyal lingual process" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011620 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A projection on the basihyal bone. Laterally the lingual process is compressed. It has a blunt pointed free end, and its lateral surfaces are slightly concave. The dorsal border is thin and irregular, and the ventral border is thick and rough. In the living animal the lingual process is embedded within the root of the tongue." ;
   oboInOwl:hasDbXref "MURDOCH:1080"
 ] .


