obo:UBERON_2002124 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0003102 ;
                   obo:IAO_0000115 "Surface structure that is a small protuberance on the surface of the body. Nuptial tubercles primarily function to facilitate contact between individuals for breeding." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasExactSynonym "breeding tubercle" ,
