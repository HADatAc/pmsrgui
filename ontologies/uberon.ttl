###  http://purl.obolibrary.org/obo/UBERON_0013725
obo:UBERON_0013725 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0011970 ;
                   owl:disjointWith obo:UBERON_0013726 ;
                   obo:IAO_0000115 "The anterior talofibular ligament is a ligament in the ankle. It passes from the anterior margin of the fibular malleolus, anteriorly and medially, to the talus bone, in front of its lateral articular facet. It is one of the lateral ligaments of the ankle and prevents the foot from sliding forward in relation to the shin." ;
                   oboInOwl:hasDbXref "FMA:44083" ,
                                      "SCTID:242467001" ,
                                      "Wikipedia:Anterior_talofibular_ligament" ;
                   oboInOwl:hasExactSynonym "ligamentum talofibulare anterius" ;
