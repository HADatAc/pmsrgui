   owl:annotatedSource obo:UBERON_0000016 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "endocrine part of pancreas" ;
   oboInOwl:hasDbXref "BTO:0000650"
 ] .


