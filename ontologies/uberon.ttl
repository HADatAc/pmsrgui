                                        obo:RO_0002157
                                      ) ;
               obo:IAO_0000115 "two individual entities d1 and d2 stand in a shares_ancestor_with relation if and only if there exists some a such that d1 derived_by_descent_from a and d2 derived_by_descent_from a." ;
