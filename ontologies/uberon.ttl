###  http://purl.obolibrary.org/obo/UBERON_0001315
obo:UBERON_0001315 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001637 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002252 ;
                                     owl:someValuesFrom obo:UBERON_0001309
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0020101 ;
                                     owl:someValuesFrom obo:UBERON_0001369
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0020101 ;
                                     owl:someValuesFrom obo:UBERON_0008529
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0020101 ;
                                     owl:someValuesFrom obo:UBERON_0011048
                                   ] ;
                   obo:IAO_0000115 "The superior gluteal artery (gluteal artery) is the largest branch of the internal iliac artery, and appears to be the continuation of the posterior division of that vessel. It is a short artery which runs backward between the lumbosacral trunk and the first sacral nerve, and, passing out of the pelvis above the upper border of the Piriformis, immediately divides into a superficial and a deep branch. Within the pelvis it gives off a few branches to the Iliacus, Piriformis, and Obturator internus, and just previous to quitting that cavity, a nutrient artery which enters the ilium. [WP,unvetted]." ;
                   oboInOwl:hasDbXref "EMAPA:37120" ,
                                      "FMA:18868" ,
                                      "MA:0002054" ,
                                      "NCIT:C32688" ,
                                      "SCTID:181354004" ,
                                      "UMLS:C0226371" ,
                                      "Wikipedia:Superior_gluteal_artery" ;
                   oboInOwl:hasExactSynonym "arteria glutealis superior" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "arteria glutea superior" ;
                   oboInOwl:id "UBERON:0001315" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ,
                                     core:uberon_slim ;
                   rdfs:label "superior gluteal artery" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/3/3a/Gray1244.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001315 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The superior gluteal artery (gluteal artery) is the largest branch of the internal iliac artery, and appears to be the continuation of the posterior division of that vessel. It is a short artery which runs backward between the lumbosacral trunk and the first sacral nerve, and, passing out of the pelvis above the upper border of the Piriformis, immediately divides into a superficial and a deep branch. Within the pelvis it gives off a few branches to the Iliacus, Piriformis, and Obturator internus, and just previous to quitting that cavity, a nutrient artery which enters the ilium. [WP,unvetted]." ;
   oboInOwl:hasDbXref "Wikipedia:Superior_gluteal_artery"
 ] .

