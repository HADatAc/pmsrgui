###  http://purl.obolibrary.org/obo/UBERON_0001394
obo:UBERON_0001394 rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( obo:UBERON_0001637
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:RO_0020101 ;
                                                                owl:someValuesFrom obo:UBERON_0009472
                                                              ]
                                                            ) ;
