                                      "MESH:D005333" ,
                                      "NCIT:C13235" ,
                                      "SCTID:83418008" ,
                                      "UMLS:C0015965" ;
                   oboInOwl:hasNarrowSynonym "fetus" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "embryo late growth stage" ,
                                              "embryo late stage" ;
