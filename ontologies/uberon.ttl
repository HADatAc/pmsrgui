                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "abductor hallucis muscle" ;
                   foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/b/bf/Abductor_hallucis.png"^^xsd:anyURI .

