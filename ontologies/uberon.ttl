###  http://purl.obolibrary.org/obo/UBERON_0007800
obo:UBERON_0007800 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002413 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BSPO_0000096 ;
                                     owl:someValuesFrom obo:UBERON_0001092
                                   ] ;
                   obo:IAO_0000115 "A small, paired bony element (more rarely, having fused parts) located between the skull and the atlas in tuataras, crocodiles, chameleons, and many fossil reptiles; it is uncommon in turtles and mammals (hedgehog). The proatlas apparently develops from the ossified neural part of the sclerotome. Externally it resembles the neural arch of the vertebra, since it articulates anteriorly with the lateral occipital bone and posteriorly with the anterior articular process of the atlas." ;
                   obo:UBPROP_0000008 "sometimes seen in humans as an anomaly." ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0007800" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "proatlas" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007800 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A small, paired bony element (more rarely, having fused parts) located between the skull and the atlas in tuataras, crocodiles, chameleons, and many fossil reptiles; it is uncommon in turtles and mammals (hedgehog). The proatlas apparently develops from the ossified neural part of the sclerotome. Externally it resembles the neural arch of the vertebra, since it articulates anteriorly with the lateral occipital bone and posteriorly with the anterior articular process of the atlas." ;
   oboInOwl:hasDbXref "http://encyclopedia2.thefreedictionary.com/Proatlas"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0007801
obo:UBERON_0007801 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001474 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0001130
                                   ] ;
                   obo:IAO_0000115 "Pygostyle refers to a number of the final few caudal vertebrae fused into a single ossification, supporting the tail feathers and musculature. In modern birds, the rectrices attach to these[WP]." ;
                   oboInOwl:hasDbXref "SCTID:416894001" ,
                                      "Wikipedia:Pygostyle" ,
                                      "http://people.eku.edu/ritchisong/birdskeleton.gif" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0007801" ;
                   oboInOwl:inSubset core:organ_slim ;
                   rdfs:label "pygostyle" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007801 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Pygostyle refers to a number of the final few caudal vertebrae fused into a single ossification, supporting the tail feathers and musculature. In modern birds, the rectrices attach to these[WP]." ;
   oboInOwl:hasDbXref "Wikipedia:Pygostyle"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0007802
obo:UBERON_0007802 rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( obo:UBERON_0002365
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:RO_0003000 ;
                                                                owl:someValuesFrom obo:UBERON_0007803
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf obo:UBERON_0002365 ,
                                   _:genid10425 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0003000 ;
                                     owl:someValuesFrom obo:UBERON_0007803
                                   ] ;
                   obo:IAO_0000115 "A large gland at the base of a bird's tail dorsal to the cloaca at the end of the pygostyle that secretes an oil used in preening. It opens through a caudally directed nipple." ;
                   oboInOwl:hasDbXref "BTO:0001420" ,
                                      "SCTID:48626006" ,
                                      "Wikipedia:Uropygial_gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "oil gland" ,
                                              "preen gland" ,
                                              "preen oil gland" ;
                   oboInOwl:id "UBERON:0007802" ;
                   oboInOwl:inSubset core:organ_slim ;
                   rdfs:comment "The gland is found near the base of the tail and is shaped into two symmetric parts. The oil of each part of the gland is secreted through the surface of the skin through a grease nipple-like nub. A bird will typically transfer this oil to its feathers by rubbing its head against the oil and then around the rest of the body. Tailward areas are usually preened utilizing the beak. Not all birds have a uropygial gland. Exceptions include the emu, ostrich, and bustards. These typically find other means to stay clean and dry, such as taking a dust bath" ;
                   rdfs:label "uropygial gland" .

_:genid10425 rdf:type owl:Restriction ;
              owl:onProperty obo:BFO_0000050 ;
              owl:someValuesFrom obo:UBERON_0002415 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007802 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0002365 ;
   oboInOwl:source "BTO"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007802 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid10425 ;
   oboInOwl:source "BTO"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007802 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A large gland at the base of a bird's tail dorsal to the cloaca at the end of the pygostyle that secretes an oil used in preening. It opens through a caudally directed nipple." ;
   oboInOwl:hasDbXref "BTO:0001420" ,
                      "Wikipedia:Uropygial_gland" ,
                      "http://en.wikivet.net"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007802 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "oil gland" ;
   oboInOwl:hasDbXref "BTO:0001420"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0007803
obo:UBERON_0007803 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000456 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0003001 ;
                                     owl:someValuesFrom obo:UBERON_0007802
                                   ] ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "preen gland secretion" ,
                                              "uropygial gland secretion" ;
                   oboInOwl:id "UBERON:0007803" ;
                   rdfs:comment "The uropygial gland is involved in maintaining feather condition and secretions spread by preening. It serves a waterproofing function. The secretions contain a pro-vitamin D, converted by UV light to active vitamin D. The secretions are also believed to suppress the growth of micro-organisms, serving an anti-bacterial function. [http://en.wikivet.net]" ;
                   rdfs:label "preen oil" .


###  http://purl.obolibrary.org/obo/UBERON_0007805
obo:UBERON_0007805 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001474 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0001130
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002131 ;
                                     owl:someValuesFrom obo:UBERON_0006075
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002374 ;
                                     owl:someValuesFrom obo:UBERON_0002412
                                   ] ;
                   obo:IAO_0000115 "A region of the lower vertebral column formed from the fusion of vertebrae." ;
                   obo:UBPROP_0000001 "Complex of synostotically fused vertebrae supporting the pelvic girdle. In anurans, the synsacrum is formed by two vertebrae and the urostyle is fused to its posterior end.[AAO]" ;
                   obo:UBPROP_0000002 "relationship loss: subclass portion of (AAO:0010428)[AAO]" ;
                   obo:UBPROP_0000008 "In amphibians, a complex of synostotically fused vertebrae supporting the pelvic girdle. In anurans, the synsacrum is formed by two vertebrae and the urostyle is fused to its posterior end[AAO:Pugener_2002]" ,
                                      "In birds and dinosaurs, the sacrum is extended by incorporation of additional fused or partially-fused caudal or lumbar vertebrae. The ilium of the pelvis is attached to the synsacrum and, in some species, may also be fused to it. Together with the pelvis this forms a rigid structure which carries the weight of the hind end of the animal. In living and some prehistoric birds, posterior to the synsacrum there are usually only a few free caudal vertebrae, on the end of which lies the pygostyle[Wikipedia:Synsacrum]" ;
                   oboInOwl:hasDbXref "AAO:0000740" ,
                                      "SCTID:67943001" ,
                                      "Wikipedia:Synsacrum" ,
                                      "http://people.eku.edu/ritchisong/birdskeleton.gif" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0007805" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "produced by fusion of last thoracics, all lumbars, all sacrals, & first few caudals;" ;
                   rdfs:label "synsacrum" .

