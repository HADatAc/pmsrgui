###  http://purl.obolibrary.org/obo/UBERON_0004758
obo:UBERON_0004758 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002530 ;
                   obo:IAO_0000115 "An organ for excreting excess salts. It is found in elasmobranchs, seabirds, and some reptiles.[WP]." ;
                   obo:UBPROP_0000008 "In sharks, salt glands are found in the rectum, but in birds and reptiles, they are found in or on the skull, in the area of the eyes, nostrils or mouth. In crocodiles, the salt is excreted through the tongue. Such glands work by active transport via sodium-potassium pump that moves salt from the blood into the gland, where it can be excreted as a concentrated solution. Salt glands function to keep salt balance, and allow marine vertebrates to drink seawater" ;
                   oboInOwl:hasDbXref "BTO:0001204" ,
                                      "GAID:1235" ,
                                      "MESH:D012491" ,
                                      "Wikipedia:Salt_gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0004758" ;
                   oboInOwl:inSubset core:functional_classification ,
                                     core:organ_slim ;
                   rdfs:label "salt gland" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0004758 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An organ for excreting excess salts. It is found in elasmobranchs, seabirds, and some reptiles.[WP]." ;
   oboInOwl:hasDbXref "Wikipedia:Salt_gland"
 ] .


