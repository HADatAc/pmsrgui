###  http://purl.obolibrary.org/obo/UBERON_0008959
obo:UBERON_0008959 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004530 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0001690
                                   ] ,
                                   _:genid678 ;
                   obo:IAO_0000115 "A hollow bony structure on the ventral, posterior portion of the skull of placental mammals that encloses parts of the middle and inner ear. In most species, it is formed by the tympanic part of the temporal bone." ;
                   obo:UBPROP_0000008 "In extant primates, the structure is found in tarsiers, lemurs, and lorises[WP]. When present in marsupials, it usually forms the alisphenoid; in placentals variously constructed of ectotympanic, entotympanic, petrosal, or a combination of these and others" ;
                   obo:UBPROP_0000011 "may be formed from entotympanic and ectotympanic" ;
                   oboInOwl:hasBroadSynonym "bulla" ;
                   oboInOwl:hasDbXref "EMAPA:37433" ,
                                      "NCIT:C112425" ,
                                      "Wikipedia:Auditory_bulla" ;
                   oboInOwl:hasNarrowSynonym "sigmoid process" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "auditory bullae" ,
                                              "bulla tympanica" ,
                                              "tympanic bulla" ;
                   oboInOwl:id "UBERON:0008959" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "auditory bulla" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/a/af/Toothed_whale_sound_production.png"^^xsd:anyURI .

