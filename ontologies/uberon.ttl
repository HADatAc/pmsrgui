###  http://purl.obolibrary.org/obo/UBERON_0015869
obo:UBERON_0015869 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0012311 ;
                   obo:IAO_0000115 "The retropharyngeal lymph nodes, from one to three in number, lie in the buccopharyngeal fascia, behind the upper part of the pharynx and in front of the arch of the atlas, being separated, however, from the latter by the Longus capitis. Their afferents drain the nasal cavities, the nasal part of the pharynx, and the auditory tubes. Their efferents pass to the superior deep cervical glands. They are in the retropharyngeal space." ;
                   oboInOwl:hasDbXref "EMAPA:37724" ,
                                      "FMA:61237" ,
                                      "MA:0003070" ,
                                      "NCIT:C77649" ,
                                      "SCTID:167263004" ,
                                      "UMLS:C0229737" ,
                                      "Wikipedia:Retropharyngeal_lymph_nodes" ;
                   oboInOwl:hasExactSynonym "retropharyngeal node" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "retropharyngeal glands" ,
                                              "retropharyngeal lymph node" ;
                   oboInOwl:id "UBERON:0015869" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "retropharyngeal lymph node" .

