                                      "neuronames:1571" ;
                   oboInOwl:hasExactSynonym "ocular ciliary body" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "anterior uvea" ,
                                              "ciliary bodies" ,
                                              "corpus ciliare" ;
                   oboInOwl:id "UBERON:0001775" ;
