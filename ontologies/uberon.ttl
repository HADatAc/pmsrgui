###  http://purl.obolibrary.org/obo/UBERON_0013119
obo:UBERON_0013119 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002075 ,
                                   obo:UBERON_0004177 ,
                                   obo:UBERON_0005057 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002202 ;
                                     owl:someValuesFrom obo:UBERON_0001637
                                   ] ;
                   obo:IAO_0000115 "A lymphoid organ found in various mammals and some birds." ;
                   oboInOwl:hasDbXref "Wikipedia:Haemal_nodes" ;
                   oboInOwl:hasExactSynonym "hemal node" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0013119" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "Hemal nodes are characterized by the presence of large numbers of erythrocytes. Lymph nodes (see below) and hemal nodes share some similarities of structure, but really are fundamentally different organs both qualitatively and quantitatively. Both lymph and hemal nodes contain diffuse lymphatic tissue, and in most cases have nodular tissue in the form of germinal centers, as well. Like the lymph node, the hemal node has a cortex and a medulla, and germinal centers are frequently seen. There's a distinct capsule, and hemal nodes are served at the hilus by an afferent arteriole. [http://www.vetmed.vt.edu/education/curriculum/vm8054/labs/lab13/lab13.htm]" ;
                   rdfs:label "haemal node" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013119 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A lymphoid organ found in various mammals and some birds." ;
   oboInOwl:hasDbXref "Wikipedia:Haemal_nodes"
 ] .


