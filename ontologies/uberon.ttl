###  http://purl.obolibrary.org/obo/UBERON_0000341
obo:UBERON_0000341 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0034929 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0000974
                                   ] ;
                   obo:IAO_0000115 "In anatomy, the throat is the anterior part of the neck, in front of the vertebral column. It consists of the pharynx and larynx. An important feature of the throat is the epiglottis, a flap which separates the esophagus from the trachea and prevents inhalation of food or drink. The throat contains various blood vessels, various pharyngeal muscles, the trachea (windpipe) and the esophagus. The hyoid bone and the clavicle are the only bones located in the throat of mammals. It is sometimes considered a synonym for fauces. [WP,unvetted]." ;
                   obo:UBPROP_0000007 "gular" ;
                   obo:UBPROP_0000008 "The hyoid bone and the clavicle are the only bones located in the throat of mammals." ;
                   oboInOwl:hasDbXref "BTO:0000828" ,
                                      "EMAPA:37973" ,
                                      "FMA:228738" ,
                                      "NCIT:C54272" ,
                                      "UMLS:C0230069" ,
                                      "Wikipedia:Throat" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "gula" ;
                   oboInOwl:id "UBERON:0000341" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ,
                                     core:pheno_slim ;
                   rdfs:label "throat" ;
                   foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/1/16/Throat_Diagram.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0000341 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "In anatomy, the throat is the anterior part of the neck, in front of the vertebral column. It consists of the pharynx and larynx. An important feature of the throat is the epiglottis, a flap which separates the esophagus from the trachea and prevents inhalation of food or drink. The throat contains various blood vessels, various pharyngeal muscles, the trachea (windpipe) and the esophagus. The hyoid bone and the clavicle are the only bones located in the throat of mammals. It is sometimes considered a synonym for fauces. [WP,unvetted]." ;
   oboInOwl:hasDbXref "Wikipedia:Throat"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0000341 ;
   owl:annotatedProperty oboInOwl:hasDbXref ;
   owl:annotatedTarget "EMAPA:37973" ;
   oboInOwl:source "MA:th"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0000341 ;
   owl:annotatedProperty oboInOwl:hasDbXref ;
   owl:annotatedTarget "UMLS:C0230069" ;
   oboInOwl:source "ncithesaurus:Throat"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0000341 ;
