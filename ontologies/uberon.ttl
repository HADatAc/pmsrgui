                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002373 ;
                                     owl:someValuesFrom obo:UBERON_0009118
                                   ] ;
                   obo:IAO_0000115 "A muscle that originates on the anterior iliac spine that passes through the inguinal canal before dividing into four branches, each attaching to a pouch nipple." ;
                   obo:UBPROP_0000009 "Associated with lumbar musculature. originally postulated to be involved in milk ejection, or for mammary support and for retraction of the teats." ,
                                      "In pouched marsupials, the ilio-marsupialis is less well developed, but may help in gland contraction to express milk during suckling (Griffiths & Slater, 1988) and it carries the genitofemoral nerve that innervates the mammary gland (Renfree, 1979) [DOI:10.1046/j.1469-7580.2002.00087.x]" ,
                                      "in pouchless marsupials provides mechanical support for the attached young [DOI:10.1046/j.1469-7580.2002.00087.x]" ;
                   oboInOwl:hasExactSynonym "M. ilio-marsupialis" ,
                                            "ilio-marsupialis" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "M. compressor mammae" ,
                                              "compressor mammae" ;
                   oboInOwl:id "UBERON:0013715" ;
                   rdfs:label "ilio-marsupialis muscle" .

