                   oboInOwl:hasExactSynonym "scapulocoracoideum" ;
                   oboInOwl:hasNarrowSynonym "coraco-scapular cartilage" ,
                                             "scapulo-coracoid cartilage" ,
                                             "scapulocoracoid cartilage" ;
                   oboInOwl:hasOBONamespace "uberon" ;
