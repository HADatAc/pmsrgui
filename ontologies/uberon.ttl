obo:UBERON_0001476 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001482 ,
                                   obo:UBERON_0004120 ,
                                   obo:UBERON_0034908 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002371 ;
