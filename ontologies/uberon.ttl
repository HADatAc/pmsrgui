###  http://purl.obolibrary.org/obo/UBERON_0008942
obo:UBERON_0008942 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000045 ;
                   obo:IAO_0000115 "The cerebral ganglia are primarily sensual centres, that compute information from the eyes as well as from the tactile and position sensors (statocystes). Besides coordination they also serve the locational memory of a snail." ;
