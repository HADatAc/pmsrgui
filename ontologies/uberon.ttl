###  http://purl.obolibrary.org/obo/UBERON_2000734
obo:UBERON_2000734 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001095 ,
                                   obo:UBERON_0004376 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_4000167
                                   ] ;
                   obo:IAO_0000115 "Caudal vertebra that is one of the last caudal vertebrae anterior to the ural vertebrae that with its neural and haemal spines supports the procurrent caudal fin rays or lepidotrichia. The numbering of preural vertebrae is from caudal to rostral direction." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0000734" ;
                   oboInOwl:hasExactSynonym "caudal fin vertebra" ,
                                            "specialized centra/vertebrae" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2000734" ;
                   rdfs:comment "The term preural vertebra was created by Nybelin (1963) for those vertebrae supporting caudal procurrent rays. For additional information see Arratia and Schultze (1992). Their neural and hemal arches may or may not be fused to their corresponding autocentrum. Fusion or separation of certain neural and/or haemal arches of preural centra is characteristic or certain teleosts subgroup. The boundary between preural and ural region is determined by the bifurcation of the four or five blood vessels running inside the hemal arches of the preural vertebrae (primary caudal artery, two secondary arterial trunks, primary caudal vein, and secondary subvertebral vein) (for details see Schultze & Arratia, 1989). The bifurcation of the caudal artery and vein was proposed as a landmark to homologize preural centrum 1 throughout actinopterygians (Nybelin, 1963)." ;
                   rdfs:label "preural vertebra" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000734 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Caudal vertebra that is one of the last caudal vertebrae anterior to the ural vertebrae that with its neural and haemal spines supports the procurrent caudal fin rays or lepidotrichia. The numbering of preural vertebrae is from caudal to rostral direction." ;
   oboInOwl:hasDbXref "TAO:GA_TG"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000734 ;
   owl:annotatedProperty obo:UBPROP_0000004 ;
   owl:annotatedTarget "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
   oboInOwl:source "http://purl.obolibrary.org/obo/tao.owl"
 ] .

