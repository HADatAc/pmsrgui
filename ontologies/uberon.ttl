                   rdfs:subClassOf obo:UBERON_0004529 ,
                                   obo:UBERON_4100000 ,
                                   _:genid13402 ;
                   obo:IAO_0000115 "Paired processes that arise near the midpoint of the neural arch lamina, for the attachment of the tuberculum of two-headed ribs. Also called transverse processes. In anurans, the term diapophysis is used in reference to the modified transverse processes of the sacral vertebra elaborated for support of the pelvic girdle." ;
                   obo:IAO_0000116 "taken from AAO, requires attention of amphibian anatomy experts, in particular, relationship to transverse processes" ;
                   oboInOwl:hasBroadSynonym "diapophysis" ,
                                            "transverse process" ;
                   oboInOwl:hasDbXref "AAO:0000706" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0011653" ;
