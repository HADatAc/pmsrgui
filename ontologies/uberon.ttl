###  http://purl.obolibrary.org/obo/UBERON_8480065
obo:UBERON_8480065 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001830 ;
                   obo:IAO_0000115 "The labial gland is one of the minor salivary glands, located mainly under the mucosal epithelium of the upper and lower lip and within the orbicularis oris muscle fibers. The labial gland secrete mucous and serous substances to maintain oral health. In particular, the inferior labial gland not only promotes moisturization in the oral cavity but also secretes substances with antibacterial effects." ;
                   terms:contributor <https://orcid.org/0000-0002-0819-0473> ;
                   terms:date "2023-06-19T12:41:05Z"^^xsd:dateTime ;
                   oboInOwl:hasDbXref "BTO:0001548" ;
                   oboInOwl:hasExactSynonym "labial minor salivary gland" ,
                                            "labial salivary gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:8480065" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "labial gland" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8480065 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The labial gland is one of the minor salivary glands, located mainly under the mucosal epithelium of the upper and lower lip and within the orbicularis oris muscle fibers. The labial gland secrete mucous and serous substances to maintain oral health. In particular, the inferior labial gland not only promotes moisturization in the oral cavity but also secretes substances with antibacterial effects." ;
   oboInOwl:hasDbXref "PMID:34422599"
 ] .

