                                      "VHOG:0000017" ,
                                      "Wikipedia:Nasal_septum" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "septal cartilage" ,
                                              "septum mobile nasi" ,
                                              "septum nasi" ,
                                              "septum of the nose" ;
                   oboInOwl:id "UBERON:0001706" ;
                   oboInOwl:inSubset core:human_subset ,
