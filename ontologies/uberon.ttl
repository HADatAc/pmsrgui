###  http://purl.obolibrary.org/obo/UBERON_0013635
obo:UBERON_0013635 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002377 ;
                   obo:UBPROP_0000010 "The m. sphincter in the head region can be divided into 2 layers: M. sphincter colli profundus and superficialis; in studied placentals, the deepest layer has circular fibers, while the superficial layer has oblique and longitudinal fibers. In non-mammalian vertebrates (if differentiated) and in monotremes both the superficialis and the profundus layers are circular ('sphincter') muscles (Shumacher, 1956; Saban, 1971)." ;
                   oboInOwl:hasExactSynonym "sphincter colli" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0013635" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "sphincter colli muscle" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013635 ;
   owl:annotatedProperty obo:UBPROP_0000010 ;
   owl:annotatedTarget "The m. sphincter in the head region can be divided into 2 layers: M. sphincter colli profundus and superficialis; in studied placentals, the deepest layer has circular fibers, while the superficial layer has oblique and longitudinal fibers. In non-mammalian vertebrates (if differentiated) and in monotremes both the superficialis and the profundus layers are circular ('sphincter') muscles (Shumacher, 1956; Saban, 1971)." ;
   oboInOwl:source "MorphoBank"
 ] .


