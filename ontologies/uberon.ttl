###  http://purl.obolibrary.org/obo/UBERON_0035094
obo:UBERON_0035094 rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( obo:UBERON_0035093
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:RO_0002372 ;
                                                                owl:someValuesFrom obo:UBERON_0001076
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:RO_0002373 ;
                                                                owl:someValuesFrom obo:UBERON_0003861
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf obo:UBERON_0035093 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002372 ;
                                     owl:someValuesFrom obo:UBERON_0001076
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002373 ;
                                     owl:someValuesFrom obo:UBERON_0003861
                                   ] ;
                   obo:IAO_0000115 "A muscle that originates via thin tendons from the distal and dorsal aspects of the neural spines. The tendons course proximomedially to distolaterally and give rise to fleshy fibers that insert onto the lateral aspect of the neural arches of each of the vertebrae it crosses. The m. extensor caudae medialis is a continuation of m. semispinalis dorsi into the tail." ;
                   oboInOwl:hasExactSynonym "M. externsor caudae medialis" ,
                                            "extensor caudae medialis" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0035094" ;
                   oboInOwl:inSubset core:mouse_subset ;
                   rdfs:label "extensor caudae medialis muscle" .

