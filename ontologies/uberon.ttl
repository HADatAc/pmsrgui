                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0007316" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "deep external pudendal artery" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/4/43/Gray549.png"^^xsd:anyURI .

