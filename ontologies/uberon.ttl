###  http://purl.obolibrary.org/obo/UBERON_4100121
obo:UBERON_4100121 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0034768 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0007812
                                   ] ;
                   obo:IAO_0000115 "The distinctive arrangement of four to ten spikes on the tails of stegosaurid dinosaurs. These spikes are believed to have been a defensive measure against predators." ;
                   oboInOwl:hasBroadSynonym "tail spikes" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:4100121" ;
                   rdfs:comment "The arrangement of spikes originally had no distinct name; the term Thagomizer was coined in 1982 by cartoonist Gary Larson in his comic 'The Far Side', and thereafter became gradually adopted as an informal term within scientific circles, research, and education." ;
                   rdfs:label "thagomizer" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_4100121 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The distinctive arrangement of four to ten spikes on the tails of stegosaurid dinosaurs. These spikes are believed to have been a defensive measure against predators." ;
   oboInOwl:hasDbXref "https://en.wikipedia.org/wiki/Thagomizer"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_4100121 ;
