                                              "primary interventricular foramen" ;
                   oboInOwl:id "UBERON:0013152" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "Phenotype notes: In some individuals, the foramen fails to close, leading to an interventricular septal defect known as a patent interventricular foramen" ;
                   rdfs:label "interventricular foramen of heart" .

