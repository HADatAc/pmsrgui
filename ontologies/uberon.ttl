###  http://purl.obolibrary.org/obo/UBERON_0011246
obo:UBERON_0011246 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002513 ,
                                   obo:UBERON_0007829 ,
                                   obo:UBERON_0011248 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002202 ;
                                     owl:someValuesFrom obo:UBERON_0011247
                                   ] ;
                   obo:IAO_0000116 "VSAO sais that the procoracoid+coracoid are homologous to the teleost coracoid. Consider adding a separate class for posterior coracoid." ;
                   obo:UBPROP_0000003 "Kardong states that the procoracoid (or the anterior part of the procoracoid) is homologous to the coracoid, but this is controversial" ;
                   obo:UBPROP_0000008 "In primitive synapsis 3 centers develop in the shoulder: the dorsal center gives rise to the scapula and the two ventral centers produce an anterior coracoid (procoracoid) and posterior coracoid (coracoid)" ;
                   dc:contributor <https://github.com/alex-dececchi> ;
                   oboInOwl:hasNarrowSynonym "procoracoid process" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "anterior coracoid" ,
                                              "anterior coracoid bone" ,
                                              "precoracoid" ,
