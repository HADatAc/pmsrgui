###  http://purl.obolibrary.org/obo/UBERON_0000050
obo:UBERON_0000050 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000047 ,
                                   _:genid455 ;
                   obo:IAO_0000115 "Simple eye that has two or more lenses. Some marine organisms bear more than one lens; for instance the copeopod Pontella has three. The outer has a parabolic surface, countering the effects of spherical aberration while allowing a sharp image to be formed. Copilla's eyes have two lenses, which move in and out like a telescope." ;
                   oboInOwl:hasDbXref "Wikipedia:Eye#Multiple_lenses" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0000050" ;
                   oboInOwl:inSubset core:grouping_class ,
                                     core:uberon_slim ;
                   rdfs:label "simple eye with multiple lenses" .

