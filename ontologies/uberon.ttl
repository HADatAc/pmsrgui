###  http://purl.obolibrary.org/obo/UBERON_0007381
obo:UBERON_0007381 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002542 ,
                                   obo:UBERON_0004121 ,
                                   obo:UBERON_3000961 ;
                   obo:IAO_0000115 "A fold in the surface epidermis composed of keratin[Kardong]." ;
                   obo:UBPROP_0000008 "Archosaurian (crocodilian and avian) scales and turtle scutes develop from local epithelial thickenings called placodes, though the scales of lizards and snakes (Lepidosauria) develop without placodes as skin folds (Maderson, '65; Sawyer, '72; Harris et al., 2002; Cherepanov, '89, 2006; Alibardi and Minelli, 2014; Moustakas- Verho et al., 2014; we do not consider crocodilian osteoderms, which have been called scutes by some workers, to be homologous to the skin appendages we discuss)[PMID:25877335]" ;
                   oboInOwl:hasDbXref "Wikipedia:Reptile_scale" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0007381" ;
                   rdfs:label "epidermal scale" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0007381 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A fold in the surface epidermis composed of keratin[Kardong]." ;
   oboInOwl:hasDbXref "ISBN:0073040584" ,
                      "Wikipedia:Reptile_scale"
 ] .


