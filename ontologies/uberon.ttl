###  http://purl.obolibrary.org/obo/UBERON_0011252
obo:UBERON_0011252 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002365 ;
                   obo:IAO_0000115 "Scent glands are exocrine glands found in most mammals. They produce semi-viscous secretions which contain pheromones and other semiochemical compounds. These odor-messengers indicate information such as status, territory marking, mood, and sexual power. The odor may be subliminal-not consciously detectable. Though it is not their primary function, the salivary glands may also function as scent glands in some animals." ;
                   obo:UBPROP_0000001 "Exocrine glands in animals which secrete scents which either repel or attract other animals, e.g. perianal glands of skunks, anal glands of weasels, musk glands of foxes, ventral glands of wood rats, and dorsal glands of peccaries[MESH:A13.820]." ;
                   oboInOwl:hasDbXref "BTO:0002068" ,
                                      "MESH:D012543" ,
                                      "Wikipedia:Scent_gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0011252" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "scent gland" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/8/85/Civetglands.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011252 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Scent glands are exocrine glands found in most mammals. They produce semi-viscous secretions which contain pheromones and other semiochemical compounds. These odor-messengers indicate information such as status, territory marking, mood, and sexual power. The odor may be subliminal-not consciously detectable. Though it is not their primary function, the salivary glands may also function as scent glands in some animals." ;
   oboInOwl:hasDbXref "Wikipedia:Scent_gland"
 ] .

[ rdf:type owl:Axiom ;
