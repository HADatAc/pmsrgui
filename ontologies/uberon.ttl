###  http://purl.obolibrary.org/obo/UBERON_0001221
obo:UBERON_0001221 rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( obo:UBERON_0014892
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:BFO_0000050 ;
                                                                owl:someValuesFrom obo:UBERON_0006635
                                                              ]
