###  http://purl.obolibrary.org/obo/UBERON_0018650
obo:UBERON_0018650 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000914 ;
                   obo:IAO_0000115 "The peristomium is the second body segment in an annelid worm's body in the anterior end. It is directly behind the prostomium and contains the mouth, tentacular cirri, and sometimes feeding palps, which may instead occur on the prostomium. If an eversible pharynx is present, it is contained in this segment as well, and can fill up to 20 segments when inverted, depending on the species." ;
                   oboInOwl:hasBroadSynonym "peristomium" ;
                   oboInOwl:hasDbXref "Wikipedia:Peristomium" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0018650" ;
                   rdfs:label "annelid peristomium" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0018650 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The peristomium is the second body segment in an annelid worm's body in the anterior end. It is directly behind the prostomium and contains the mouth, tentacular cirri, and sometimes feeding palps, which may instead occur on the prostomium. If an eversible pharynx is present, it is contained in this segment as well, and can fill up to 20 segments when inverted, depending on the species." ;
   oboInOwl:hasDbXref "Wikipedia:Peristomium"
 ] .

[ rdf:type owl:Axiom ;
