 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0004743 ;
   owl:annotatedProperty obo:UBPROP_0000005 ;
   owl:annotatedTarget "The coracoid is a triangular shaped-bone that usually has an anteriorly directed long process that may joins its counterpart in some fish groups. It may be perforated by the coracoid foramen or it may be notched dorsally and forms the scapulo-coracoid foramen together with a similar notch of the ventral margin of the scapula.[TAO]" ;
   oboInOwl:date_retrieved "2012-09-06" ;
   oboInOwl:external_class "TAO:0000332" ;
   oboInOwl:ontology "TAO" ;
   oboInOwl:source "Curator"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0004743 ;
   owl:annotatedProperty obo:UBPROP_0000008 ;
   owl:annotatedTarget "In Theria, coracoid bones non-existent or fused with the shoulder blades to form coracoid processes[WP]. Procoracoid+coracoid are homologuous with coracoid of teleostomi. The coracoid is a triangular shaped-bone that usually has an anteriorly directed long process that may joins its counterpart in some fish groups. It may be perforated by the coracoid foramen or it may be notched dorsally and forms the scapulo-coracoid foramen together with a similar notch of the ventral margin of the scapula" ;
   oboInOwl:source "VSAO" ,
                   "WP"
 ] .

