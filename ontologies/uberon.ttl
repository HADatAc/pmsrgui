###  http://purl.obolibrary.org/obo/UBERON_0004748
obo:UBERON_0004748 rdf:type owl:Class ;
                   obo:UBPROP_0000001 "Sliver of bone that invest part of or all the posterior aspect of each antorbital plane.[AAO]" ,
                                      "The cartilaginous autopalatine forms from the anterior palatoquadrate arch. The first sign of ossification is visible at the anterior tip where it articulates with the maxilla (7.6 mm). In adults there are three processes at the anterior portion of the palatine: a ventromedial process, which forms the socket of the small ball- and- socket joint with the preethmoid; a dorsomedial process, which is connected by a short ligament to the ethmoid; and a lateral process, which extends toward the first infraorbital. Possession of a dorsomedial process, which abuts the ethmoid, is a unique feature shared by Cypriniformes (Fink and Fink, 1981). The palatine has two components, the autopalatine (derived from pars autopalatine) and the dermal component having teeth, the dermopalatine Arratia & Schultze 1990. The element in cypriniforms is only the cartilage part, so that it is more correct to name it autopalatine and not as palatine in general that it implies a fusion of elements (as in perciforms).[ZFA]" ;
                   oboInOwl:consider obo:AAO_0000372 ,
                                     obo:ZFA_0000620 ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0004748" ;
                   rdfs:label "obsolete autopalatine" ;
                   owl:deprecated "true"^^xsd:boolean .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0004748 ;
   owl:annotatedProperty obo:UBPROP_0000001 ;
   owl:annotatedTarget "Sliver of bone that invest part of or all the posterior aspect of each antorbital plane.[AAO]" ;
   oboInOwl:date_retrieved "2012-06-20" ;
   oboInOwl:external_class "AAO:0000372" ;
   oboInOwl:ontology "AAO" ;
   oboInOwl:source "AAO:LAP"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0004748 ;
   owl:annotatedProperty obo:UBPROP_0000001 ;
   owl:annotatedTarget "The cartilaginous autopalatine forms from the anterior palatoquadrate arch. The first sign of ossification is visible at the anterior tip where it articulates with the maxilla (7.6 mm). In adults there are three processes at the anterior portion of the palatine: a ventromedial process, which forms the socket of the small ball- and- socket joint with the preethmoid; a dorsomedial process, which is connected by a short ligament to the ethmoid; and a lateral process, which extends toward the first infraorbital. Possession of a dorsomedial process, which abuts the ethmoid, is a unique feature shared by Cypriniformes (Fink and Fink, 1981). The palatine has two components, the autopalatine (derived from pars autopalatine) and the dermal component having teeth, the dermopalatine Arratia & Schultze 1990. The element in cypriniforms is only the cartilage part, so that it is more correct to name it autopalatine and not as palatine in general that it implies a fusion of elements (as in perciforms).[ZFA]" ;
   oboInOwl:date_retrieved "2012-08-08" ;
   oboInOwl:external_class "ZFA:0000620" ;
   oboInOwl:ontology "ZFA" ;
   oboInOwl:source "ZFIN:curator"
 ] .


