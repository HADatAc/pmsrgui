###  http://purl.obolibrary.org/obo/UBERON_8410003
obo:UBERON_8410003 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004119 ,
                                   obo:UBERON_0010000 ;
                   obo:IAO_0000115 "In human, ductal plate is a double-layered cylindrical structure of bile duct epithelium that surrounds the portal ramifications by the eighth gestational week. After approximately the 12th gestational week, remodelling of ductal plate begins, and maturity is attained by the end of gestation or early postnatal period." ;
                   obo:UBPROP_0000008 "Temporal stages still need to be fully researched across species." ;
                   terms:contributor <https://orcid.org/0000-0002-2825-0621> ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:8410003" ;
                   oboInOwl:inSubset core:added_for_HCA ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "ductal plate" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8410003 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "In human, ductal plate is a double-layered cylindrical structure of bile duct epithelium that surrounds the portal ramifications by the eighth gestational week. After approximately the 12th gestational week, remodelling of ductal plate begins, and maturity is attained by the end of gestation or early postnatal period." ;
   oboInOwl:hasDbXref "PMID:28515578" ,
                      "http://orcid.org/0000-0002-7073-9172"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_8410022
obo:UBERON_8410022 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001637 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002252 ;
                                     owl:someValuesFrom obo:UBERON_0001183
                                   ] ;
                   obo:IAO_0000115 "The first branch of the inferior mesenteric artery (IMA) is the left colic artery. The left colic artery supplies blood flow to the distal third of the transverse colon and the entirety of the descending colon. Once diverging from the IMA, the left colic artery runs anterior to the left ureter, left internal spermatic vessels (males), and psoas major before branching into its ascending and descending segments." ;
                   terms:contributor <https://orcid.org/0000-0002-2825-0621> ;
                   oboInOwl:hasDbXref "FMA:14826" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:8410022" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "left colic artery" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8410022 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The first branch of the inferior mesenteric artery (IMA) is the left colic artery. The left colic artery supplies blood flow to the distal third of the transverse colon and the entirety of the descending colon. Once diverging from the IMA, the left colic artery runs anterior to the left ureter, left internal spermatic vessels (males), and psoas major before branching into its ascending and descending segments." ;
   oboInOwl:hasDbXref "PMID:29489246" ,
                      "https://orcid.org/0000-0003-4183-8865"
 ] .


