                                      "Wikipedia:Tracheoesophageal_septum" ;
                   oboInOwl:hasExactSynonym "esophagotracheal septum" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "tracheoesophageal ridges" ;
                   oboInOwl:id "UBERON:0036070" ;
