[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0015878 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0015877 ;
   oboInOwl:source "FMA"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0015878 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The external iliac lymph nodes, from eight to ten in number, lie along the external iliac vessels. They are arranged in three groups, one on the lateral, another on the medial, and a third on the anterior aspect of the vessels; the third group is, however, sometimes absent. Their principal afferents are derived from the inguinal lymph nodes, the deep lymphatics of the abdominal wall below the umbilicus and of the adductor region of the thigh, and the lymphatics from the glans penis vel clitoridis, the membranous urethra, the prostate, the fundus of the urinary bladder, the cervix uteri, and upper part of the vagina." ;
   oboInOwl:hasDbXref "Wikipedia:External_iliac_lymph_nodes"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0015878 ;
   owl:annotatedProperty oboInOwl:hasExactSynonym ;
   owl:annotatedTarget "common iliac node" ;
   oboInOwl:hasDbXref "FMA:12806"
 ] .

[ rdf:type owl:Axiom ;
