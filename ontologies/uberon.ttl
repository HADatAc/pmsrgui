###  http://purl.obolibrary.org/obo/UBERON_0001038
obo:UBERON_0001038 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000020 ;
                   obo:IAO_0000115 "Chordotonal organs are arthropod sensory structures consisting of special sensilla called the scolopidia, which are mechano-transducers and respond mainly to stretch or flexion. In insects, they consist of bundles of internal sensilla, each of which has a cap cell, an enveloping cell and one or more sense cells. The distal end of the organ is usually attached to the cuticle of the body wall, marked by a pit, a thickened disc or a nodule of chitin, and the base of the organ is connected with the hypodermis, often by a special ligament." ;
                   oboInOwl:hasDbXref "EFO:0000940" ,
                                      "FBbt:00005215" ,
                                      "MAT:0000209" ,
                                      "MIAA:0000209" ,
                                      "Wikipedia:Chordotonal_organ" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "ch" ,
                                              "scolopophorous organ" ;
                   oboInOwl:id "UBERON:0001038" ;
                   oboInOwl:inSubset core:efo_slim ,
                                     core:organ_slim ,
                                     core:uberon_slim ;
                   rdfs:comment "To be ceded to Arthropod anatomy ontology" ;
                   rdfs:label "chordotonal organ" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001038 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Chordotonal organs are arthropod sensory structures consisting of special sensilla called the scolopidia, which are mechano-transducers and respond mainly to stretch or flexion. In insects, they consist of bundles of internal sensilla, each of which has a cap cell, an enveloping cell and one or more sense cells. The distal end of the organ is usually attached to the cuticle of the body wall, marked by a pit, a thickened disc or a nodule of chitin, and the base of the organ is connected with the hypodermis, often by a special ligament." ;
   oboInOwl:hasDbXref "FB:FBrf0056378" ,
                      "Wikipedia:Chordotonal_organ"
 ] .

