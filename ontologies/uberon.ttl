###  http://purl.obolibrary.org/obo/UBERON_0002538
obo:UBERON_0002538 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002530 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
