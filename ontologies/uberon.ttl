                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0003108
                                   ] ;
                   obo:IAO_0000115 "Endochondral element that is part of the suspensorium sometimes ossifying distally as the quadrate bone and linking the basal section of the braincase to the lower jaw." ;
                   terms:contributor <https://orcid.org/0000-0002-1810-9886> ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:4200139" ;
                   rdfs:comment "The palatoquadrate cartilage is the primary element of the suspensorium in larval amphibians and can ossify distally in some taxa, becoming the quadrate bone. In mammals the quadrate bone becomes the incus." ;
                   rdfs:label "palatoquadrate element" .

