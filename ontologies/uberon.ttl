###  http://purl.obolibrary.org/obo/UBERON_4200135
obo:UBERON_4200135 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004120 ,
                                   obo:UBERON_0005179 ,
                                   obo:UBERON_0007844 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0007832
                                   ] ;
                   obo:IAO_0000115 "A transverse flattened or cylindrical plate in the posterior body wall opposite the anterior ends of the pelvic fins, in front of the vent and at the posterior end of the body cavity, that supports a few anterior pelvic radials and a basal cartilage, the basipterygium.  from  Leonard J. V. Compagno. 2001. Sharks of the World: An Annotated and Illustrated Catalogue of Shark Species Known to Date. Volume 2." ;
                   terms:contributor <https://orcid.org/0000-0001-7972-3866> ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:4200135" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "Potentially homologous to the pelvic girdle." ;
                   rdfs:label "puboischiadic bar" .

