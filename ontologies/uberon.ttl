###  http://purl.obolibrary.org/obo/UBERON_2002162
obo:UBERON_2002162 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001095 ,
                                   obo:UBERON_0004376 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_4000167
                                   ] ;
                   obo:IAO_0000115 "Vertebra that is incomplete or rudimentary and may bear a rudimentary neural arch and sometimes a rudimentary spine or the neural arch and spine are completely absent. Ural vertebrae are one of the last bony elements of the vertebral column, usually smaller than the preural centra. Ural vertebrae are numbered beginning from anterior (1) to posterior (2, 3, 4, etc.). Ural vertebra is an unpaired median bone." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2002162" ;
                   rdfs:label "ural vertebra" ;
                   rdfs:seeAlso "http://purl.obolibrary.org/obo/uberon/tracker/294" .

