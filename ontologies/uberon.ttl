###  http://purl.obolibrary.org/obo/UBERON_0015241
obo:UBERON_0015241 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0003103 ,
                                   obo:UBERON_0004121 ;
                   obo:UBPROP_0000001 "An unpaired left-sided accessory organ which plays a role in establishing lateral brain left right asymmetry[ZFA:0001360, ZFIN:ZDB-PUB-030206-1]." ;
                   obo:UBPROP_0000008 "In lampreys and apparently in some fossil fish, the parapineal body and the pineal body (epiphysis) are a bilateral pair of structures rather than being located in series, one in front of the other. A pair of visual structures may have been the ancestral condition of this pineal complex (Weichert, 1970, p.622). The parapineal organs of lampreys, tadpoles, and lizards possess cells similar to rods and cones. Frogs possess a brow spot or frontal organ where ancestral pineal eye might have been (Weichert, 1970, p.622)" ;
                   oboInOwl:hasDbXref "TAO:0001360" ,
                                      "ZFA:0001360" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "parapineal gland" ;
                   oboInOwl:id "UBERON:0015241" ;
                   rdfs:label "parapineal organ" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0015241 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0003103 ;
   oboInOwl:source "ZFA"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0015241 ;
   owl:annotatedProperty obo:UBPROP_0000001 ;
   owl:annotatedTarget "An unpaired left-sided accessory organ which plays a role in establishing lateral brain left right asymmetry[ZFA:0001360, ZFIN:ZDB-PUB-030206-1]." ;
   oboInOwl:source "ZFA:0001360, ZFIN:ZDB-PUB-030206-1"
 ] .


