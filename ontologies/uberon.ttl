###  http://purl.obolibrary.org/obo/UBERON_2000602
obo:UBERON_2000602 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0003861 ,
                                   obo:UBERON_0004376 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_4000167
                                   ] ;
                   obo:IAO_0000115 "Neural arch that extends along the dorso-lateral surface of the last preural centra and/or ural centra and the notochord (Arratia & Schultze, 1992). An uroneural develops as a modification of the neural arch of an ural centrum (Patterson, 1968). The series of uroneurals may include from 7 to 1 elements that are numbered from rostrad to caudad. An uroneural is a paired membrane bone." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0000602" ;
                   oboInOwl:hasExactSynonym "uroneurals" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2000602" ;
                   rdfs:comment "The presence of modified ural neural arches or uroneurals is interpreted as a synapomorphy of Teleostei. Uroneurals present some modifications in certain teleost subgroups and such specialized structures are named pleurostyle (e.g., ostarioclupeomorphs) and stegural (e.g., salmonids)." ;
                   rdfs:label "uroneural" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000602 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Neural arch that extends along the dorso-lateral surface of the last preural centra and/or ural centra and the notochord (Arratia & Schultze, 1992). An uroneural develops as a modification of the neural arch of an ural centrum (Patterson, 1968). The series of uroneurals may include from 7 to 1 elements that are numbered from rostrad to caudad. An uroneural is a paired membrane bone." ;
   oboInOwl:hasDbXref "TAO:Arratia_Schultze_1992" ,
                      "TAO:Patterson_1968"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000602 ;
