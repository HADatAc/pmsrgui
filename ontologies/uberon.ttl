obo:UBERON_0010048 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0010047 ;
                   obo:IAO_0000115 "A gland situated on the upper lip posterior to the eye, found in non-venomous snakes. Releases secretion via duct adjacent to posterior maxillary teeth." ;
                   oboInOwl:hasDbXref "Wikipedia:Duvernoy's_gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0010048" ;
                   rdfs:comment "positioned posterior to the eye, encased in a thin cover of connective tissue, and consists mostly of serous cells. A single, short duct extends anteromedially from the lumen of the gland to the base of the posterior fangs.[WP]" ;
                   rdfs:label "Duvernoy's gland" .

