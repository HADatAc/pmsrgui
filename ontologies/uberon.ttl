###  http://purl.obolibrary.org/obo/UBERON_2001579
obo:UBERON_2001579 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_2002162 ;
                   obo:IAO_0000115 "Ural vertebra that is the second vertebra posterior to preural centrum 1. It may bear a rudimentary neural arch and sometimes a rudimentary spine or the neural arch and spine are completely absent and it may articulate or fuse with hypural 2 (polyural terminology). Ural vertebra 2 is an unpaired median bone." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0001579" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2001579" ;
                   rdfs:comment "Ural vertebrae 2 may be defined also as the second ural vertebrae bearing hypurals 3 or 3 and 4 or 3 plus more dorsal hypurals (diural terminology)." ;
                   rdfs:label "ural vertebra 2" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2001579 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Ural vertebra that is the second vertebra posterior to preural centrum 1. It may bear a rudimentary neural arch and sometimes a rudimentary spine or the neural arch and spine are completely absent and it may articulate or fuse with hypural 2 (polyural terminology). Ural vertebra 2 is an unpaired median bone." ;
   oboInOwl:hasDbXref "TAO:GA_TG"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2001579 ;
   owl:annotatedProperty obo:UBPROP_0000004 ;
   owl:annotatedTarget "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
   oboInOwl:source "http://purl.obolibrary.org/obo/tao.owl"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_2001581
obo:UBERON_2001581 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004247 ,
                                   obo:UBERON_2002085 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_2001579
                                   ] ;
                   obo:IAO_0000115 "A vertebral centrum that is located immediately posterior to ural centrum 1. Ural centrum 2 is an unpaired median bone." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0001581" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2001581" ;
                   rdfs:comment "Ural centrum 2 (polyural terminology) may articulate or fuse with its neural arch dorsally or the neural arch may be absent, and with hypural 2 ventrally. Ural centrum 2 may be defined also as the second ural centrum bearing hypurals 3 or 3 and 4 or 3, 4 and more dorsal hypurals (diural terminology)." ;
                   rdfs:label "ural centrum 2" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2001581 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A vertebral centrum that is located immediately posterior to ural centrum 1. Ural centrum 2 is an unpaired median bone." ;
   oboInOwl:hasDbXref "TAO:GA_TG"
 ] .

