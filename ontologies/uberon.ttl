###  http://purl.obolibrary.org/obo/UBERON_0011113
obo:UBERON_0011113 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0011112 ;
                   obo:IAO_0000115 "The inferior tibiofibular articulation (tibiofibular syndesmosis) is formed by the rough, convex surface of the medial side of the lower end of the fibula, and a rough concave surface on the lateral side of the tibia. Below, to the extent of about 4 mm. these surfaces are smooth, and covered with cartilage, which is continuous with that of the ankle-joint. The ligaments are: Anterior ligament of the lateral malleolus, Posterior ligament of the lateral malleolus, Inferior transverse ligament of the tibiofibular syndesmosis, Interosseous ligament." ;
                   oboInOwl:hasDbXref "FMA:10465" ,
                                      "SCTID:182209000" ,
                                      "Wikipedia:Inferior_tibiofibular_articulation" ;
                   oboInOwl:hasExactSynonym "distal tibiofibular joint" ,
                                            "syndesmosis tibiofibularis" ,
                                            "tibiofibular syndesmosis" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "inferior tibiofibular articulation" ;
                   oboInOwl:id "UBERON:0011113" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "inferior tibiofibular joint" .

