   owl:annotatedSource obo:UBERON_0016477 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The zygomatic process of the maxilla (malar process) is a rough triangular eminence, situated at the angle of separation of the anterior, zygomatic, and orbital surfaces. In front it forms part of the anterior surface. Behind it is concave, and forms part of the infratemporal fossa. Above it is rough and serrated for articulation with the zygomatic bone. Below it presents the prominent arched border which marks the division between the anterior and infratemporal surfaces." ;
   oboInOwl:hasDbXref "Wikipedia:Zygomatic_process_of_maxilla"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0016477 ;
   owl:annotatedProperty oboInOwl:hasBroadSynonym ;
   owl:annotatedTarget "malar process" ;
   oboInOwl:hasDbXref "Wikipedia:Zygomatic_process_of_maxilla"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0016477 ;
   owl:annotatedProperty oboInOwl:hasExactSynonym ;
   owl:annotatedTarget "malar process of maxilla" ;
   oboInOwl:hasDbXref "Wikipedia:Zygomatic_process_of_maxilla"
 ] .

