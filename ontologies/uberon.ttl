###  http://purl.obolibrary.org/obo/UBERON_0008537
obo:UBERON_0008537 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002000 ,
                                   _:genid11014 ;
                   obo:IAO_0000115 "The quadratus femoris is, as its name implies, a flat, quadrilateral skeletal muscle. Located on the posterior side of the hip joint, it is a strong lateral rotator and adductor of the thigh, but also acts to stabilize the femoral head in the Acetabulum." ;
                   oboInOwl:hasDbXref "EMAPA:36241" ,
                                      "FMA:22321" ,
                                      "SCTID:245020003" ,
                                      "Wikipedia:Quadratus_femoris_muscle" ;
