                                   _:genid13408 ;
                   obo:IAO_0000115 "Dermal bone of pectoral girdle that is median and ventral in position." ;
                   obo:IAO_0000116 "See discussion on pectoral girdles - change relationship to overlaps? Kardong: enlarged oval scale" ;
                   obo:UBPROP_0000008 "Present in therapids and monotremes, reduced in size in marsupials and placentals. In birds, the interclavicle is fused with the clavicles to form the furcula (wishbone); the furcula forms a 'Y' shape and the interclavicle is the stem of the 'Y'." ;
                   oboInOwl:hasDbXref "VSAO:0000161" ,
