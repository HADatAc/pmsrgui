###  http://purl.obolibrary.org/obo/UBERON_0009041
obo:UBERON_0009041 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0009026 ,
                                   _:genid11432 ;
                   obo:IAO_0000115 "The superficial iliac circumflex artery (or superficial circumflex iliac), the smallest of the cutaneous branches of the femoral artery, arises close to the superficial epigastric artery, and, piercing the fascia lata, runs lateralward, parallel with the inguinal ligament, as far as the crest of the ilium. It divides into branches which supply the integument of the groin, the superficial fascia, and the superficial subinguinal lymph glands, anastomosing with the deep iliac circumflex, the superior gluteal and lateral femoral circumflex arteries." ;
                   oboInOwl:hasDbXref "FMA:20737" ,
                                      "NCIT:C52864" ,
                                      "UMLS:C0738891" ,
                                      "Wikipedia:Superficial_circumflex_iliac_artery" ;
                   oboInOwl:hasExactSynonym "arteria circumflexa ilium superficialis" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "iliac circumflex artery" ,
                                              "superficial circumflex iliac artery" ;
                   oboInOwl:id "UBERON:0009041" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "superficial circumflex iliac artery" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/8/8b/Gray548.png"^^xsd:anyURI .

_:genid11432 rdf:type owl:Restriction ;
