                                     core:mouse_subset ;
                   rdfs:label "procoracoid bone" ;
                   rdfs:seeAlso "https://github.com/obophenotype/uberon/issues/119"^^xsd:anyURI ;
                   foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/7/79/P.gigas_forelimb.jpg"^^xsd:anyURI .

