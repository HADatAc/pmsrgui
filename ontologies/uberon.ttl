###  http://purl.obolibrary.org/obo/UBERON_2000557
obo:UBERON_2000557 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_2000734 ;
                   obo:IAO_0000115 "Last caudal vertebra identified as the point at which the caudal vessels bifurcate, leaving the protection of the haemal arches of the caudal vertebrae and running laterally to the hypurals. This vertebra bears, commonly, a well-developed haemal arch and its spine (parhypural)." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0000557" ;
                   oboInOwl:hasExactSynonym "penultimate vertebra" ,
                                            "preural centrum 1" ,
                                            "pu1" ,
                                            "second last vertebra" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2000557" ;
                   rdfs:comment "The haemal arch may be fused to the centrum or not. In contrast, the neural arch and spine may be well developed, or rudimentary or absent in different teleost subgroups." ;
                   rdfs:label "preural 1 vertebra" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000557 ;
