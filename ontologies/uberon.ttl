###  http://purl.obolibrary.org/obo/UBERON_0015865
obo:UBERON_0015865 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0015860 ;
                   obo:IAO_0000115 "Lymph nodes of the pancreatic tail and spleen, receiving afferents from both organs plus the greater curvature of the stomach; they drain to the celiac lymph nodes." ;
                   obo:IAO_0000116 "Consider obsoleting - this is apparently an obsolete term that regarded the pancreatic and splenic lymph nodes as a single anatomic unit.[http://medical-dictionary.thefreedictionary.com/pancreaticosplenic+lymph+nodes]" ;
                   oboInOwl:hasDbXref "FMA:12799" ,
                                      "SCTID:280723006" ;
