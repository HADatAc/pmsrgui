###  http://purl.obolibrary.org/obo/UBERON_8910001
obo:UBERON_8910001 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0011216 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_8910000
                                   ] ;
                   obo:IAO_0000115 "The stomatogastric ganglion (STG) consists of about 30 neurons that form two central pattern generator circuits in crustaceans. STG neurons have large soma (~50-100 um) and have complex branches. The STG contains the motor neurons that innervate the striated muscles that move the gastric mill and pyloric regions of the stomach." ;
                   terms:contributor <https://orcid.org/0000-0002-1909-7004> ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "STG" ;
                   oboInOwl:id "UBERON:8910001" ;
                   rdfs:label "stomatogastric ganglion" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8910001 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The stomatogastric ganglion (STG) consists of about 30 neurons that form two central pattern generator circuits in crustaceans. STG neurons have large soma (~50-100 um) and have complex branches. The STG contains the motor neurons that innervate the striated muscles that move the gastric mill and pyloric regions of the stomach." ;
   oboInOwl:hasDbXref "PMID:17009928"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8910001 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "STG" ;
   oboInOwl:hasDbXref "PMID:17009928" ;
   oboInOwl:hasSynonymType obo:OMO_0003000
 ] .


