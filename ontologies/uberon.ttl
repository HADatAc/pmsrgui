                                      "VHOG:0000293" ,
                                      "Wikipedia:Central_nervous_system" ,
                                      "XAO:0000215" ,
                                      "ZFA:0000012" ,
                                      "neuronames:854" ;
                   oboInOwl:hasExactSynonym "CNS" ,
                                            "systema nervosum centrale" ;
                   oboInOwl:hasNarrowSynonym "cerebrospinal axis" ;
                   oboInOwl:hasOBONamespace "uberon" ;
