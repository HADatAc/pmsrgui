###  http://purl.obolibrary.org/obo/UBERON_4200054
obo:UBERON_4200054 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_4000164 ;
                   obo:IAO_0000115 "Type of tail (caudal) fin in which the vertebral column turns upwards into the upper lobe which is longer than the lower. Asymmetrical externally as well as internally." ;
                   terms:contributor <https://orcid.org/0000-0001-7972-3866> ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:4200054" ;
                   rdfs:comment "Elasmobranchii, Acipenseridae, Polyodontidae and in many larval Teleostomi. May also be used for an asymmetrical caudal fin but with epicercal defining upper lobe longer and hypocercal the lower lobe longer. http://www.briancoad.com/dictionary/DicPics/heterorercal.htm" ;
                   rdfs:label "heterocercal tail" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_4200054 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Type of tail (caudal) fin in which the vertebral column turns upwards into the upper lobe which is longer than the lower. Asymmetrical externally as well as internally." ;
   oboInOwl:hasDbXref "PHENOSCAPE"
 ] .


