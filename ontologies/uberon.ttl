###  http://purl.obolibrary.org/obo/UBERON_0002383
obo:UBERON_0002383 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001482 ,
                                   obo:UBERON_0010891 ,
                                   obo:UBERON_0034908 ,
                                   _:genid4737 ,
                                   _:genid4739 ;
                   obo:IAO_0000115 "The supraspinatus is a relatively small muscle of the upper limb that takes its name from its origin from the supraspinous fossa superior to the spine of the scapula. It is one of the four rotator cuff muscles and also abducts the arm at the shoulder. The spine of the scapula separates the supraspinatus muscle from the infraspinatus muscle, which originates below the spine. [WP,unvetted]." ;
                   oboInOwl:hasDbXref "EHDAA2:0001967" ,
                                      "EHDAA:8319" ,
