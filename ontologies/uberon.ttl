                      "https://github.com/obophenotype/uberon/issues/614"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0015153
obo:UBERON_0015153 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0015152 ;
                   owl:disjointWith obo:UBERON_0015154 ;
                   obo:IAO_0000115 "A gland that is located in the ocular region, nearer the inner canthi. Typically associated with or part of the nictitating membrane, when present." ;
                   obo:UBPROP_0000008 "Rabbits, pigs and Mongolian gerbils have both a Harderian and a nictitans gland[ISBN:1118473523]" ,
                                      "the distinction between Harderian and nictitans gland is only valid in mammals - the medial ocular glands in other terapods are called Harderian glands regardless of their secretion[DOI:10.1007/978-3-642-76685-5_2]" ;
                   oboInOwl:hasExactSynonym "medial ocular gland" ,
                                            "medial orbital gland" ;
                   oboInOwl:hasNarrowSynonym "Harderian gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0015153" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "medial gland of ocular region" .

