                   rdfs:subClassOf obo:UBERON_0004120 ,
                                   obo:UBERON_0006590 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0000474
                                   ] ;
                   obo:IAO_0000115 "A patent pouch of peritoneum extending into the labia majora of women. It is analogous to the processus vaginalis in males. The pouch accompanies the gubernaculum during development of the urinary and reproductive organs, more specifically during the descent of the ovaries, and normally obliterates." ;
                   oboInOwl:hasDbXref "Wikipedia:Canal_of_Nuck" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "canal of nuck" ,
                                              "nuck%27s canal" ,
                                              "persistent processus vaginalis" ,
                                              "processus vaginalis peritonei femininus" ;
                   oboInOwl:id "UBERON:0013278" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "canal of Nuck" .

