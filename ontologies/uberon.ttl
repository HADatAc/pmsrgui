###  http://purl.obolibrary.org/obo/UBERON_0009054
obo:UBERON_0009054 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001009 ;
                   oboInOwl:hasDbXref "FBbt:00005057" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0009054" ;
                   rdfs:comment "The Open Circulatory System is a system in which fluid (called hemolymph) in a cavity called the hemocoel bathes the organs directly with oxygen and nutrients and there is no distinction between blood and interstitial fluid; this combined fluid is called hemolymph or haemolymph" ;
                   rdfs:label "open circulatory system" .

