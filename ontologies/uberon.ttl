###  http://purl.obolibrary.org/obo/UBERON_0009563
obo:UBERON_0009563 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002529 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0006050
                                   ] ;
                   obo:IAO_0000115 "A part of the leg of a horse between the fetlock and the top of the hoof. It incorporates the long pastern bone (proximal phalanx) and the short pastern bone (middle phalanx), which are held together by two sets of paired ligaments to form the pastern joint (proximal interphalangeal joint)." ;
                   obo:IAO_0000116 "in future this may be merged into a more species-neutral class for the distal and medial segments of a digit." ;
                   oboInOwl:hasDbXref "SCTID:370725009" ,
                                      "Wikipedia:Pastern" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0009563" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "pastern region of limb" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0009563 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A part of the leg of a horse between the fetlock and the top of the hoof. It incorporates the long pastern bone (proximal phalanx) and the short pastern bone (middle phalanx), which are held together by two sets of paired ligaments to form the pastern joint (proximal interphalangeal joint)." ;
