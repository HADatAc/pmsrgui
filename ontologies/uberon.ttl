                                     core:mouse_subset ,
                                     core:pheno_slim ;
                   rdfs:label "urorectal septum" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/f/fb/Gray992.png"^^xsd:anyURI .

