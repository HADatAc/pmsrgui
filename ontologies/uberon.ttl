###  http://purl.obolibrary.org/obo/UBERON_0006638
obo:UBERON_0006638 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004120 ,
                                   obo:UBERON_0006590 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0000916
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002202 ;
                                     owl:someValuesFrom obo:UBERON_0002068
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002495 ;
                                     owl:someValuesFrom obo:UBERON_0002068
                                   ] ;
                   obo:IAO_0000115 "The median umbilical ligament is a structure in human anatomy. It is a shrivelled piece of tissue that represents the remnant of the embryonic urachus. It extends from the apex of the bladder to the umbilicus, on the deep surface of the anterior abdominal wall. It is unpaired. It is covered by the median umbilical fold Lateral to this structure are the medial umbilical ligament (which is a different structure, not to be confused) and the lateral umbilical ligament." ;
                   oboInOwl:hasDbXref "EMAPA:29637" ,
                                      "FMA:16568" ,
                                      "SCTID:89583000" ,
                                      "Wikipedia:Median_umbilical_ligament" ;
                   oboInOwl:hasExactSynonym "median umbilical ligament" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "ligamentum umbilicale medianum" ,
                                              "median umbilical fold" ,
                                              "middle umbilical ligament" ;
                   oboInOwl:id "UBERON:0006638" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "remnant of urachus" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/e/ef/Gray1036.png"^^xsd:anyURI .

