 ] .


###  http://purl.obolibrary.org/obo/UBERON_2000735
obo:UBERON_2000735 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002513 ,
                                   obo:UBERON_0004247 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0006065
                                   ] ;
                   obo:IAO_0000115 "Paired, ventromedially directed processes on the posterior ends of the centra, ligamentously joined to the hemal postzygapophyses of the immediately posterior vertebra. The most posterior caudal vertebrae lack hemal postzygapophyses." ;
