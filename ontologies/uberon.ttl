###  http://purl.obolibrary.org/obo/UBERON_0013207
obo:UBERON_0013207 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004120 ,
                                   obo:UBERON_0005744 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002570 ;
                                     owl:someValuesFrom obo:UBERON_0001398
                                   ] ;
                   obo:IAO_0000115 "A canal through the medial epicondyle at the distal end of the vertebrate humerus, usually traversed by the median nerve and brachial artery." ;
                   obo:UBPROP_0000008 "It is often present in primitive placentals, such as the enigmatic Madagascan Plesiorycteropus. In most Neotominae and all Tylomyinae among cricetid rodents, it is located above the medial epicondyle of the humerus, but it is absent in all Sigmodontinae and Arvicolinae and this trait has been suggested as a synapomorphy for the former subfamily.[WP]" ,
                                      "Primitive amniote feature found in primitive reptil-like amphibians (Romeer) [http://www.jstor.org/discover/10.2307/2422468]" ;
                   oboInOwl:hasDbXref "Wikipedia:Entepicondylar_foramen" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0013207" ;
                   oboInOwl:inSubset core:mouse_subset ;
                   rdfs:label "entepicondylar foramen" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013207 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A canal through the medial epicondyle at the distal end of the vertebrate humerus, usually traversed by the median nerve and brachial artery." ;
   oboInOwl:hasDbXref "http://www.jstor.org/discover/10.2307/2422468"
 ] .


