###  http://purl.obolibrary.org/obo/UBERON_0009716
obo:UBERON_0009716 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000020 ;
                   obo:IAO_0000115 "Epithelial sense organ containing the cupula housing a gelatinous material elongated from the basement of the organ toward the atrial cavity. The basement of the cupular organ consists of two cell types: sensory cells and support cell." ;
                   obo:UBPROP_0000008 "possible homologues of neuromasts in the inner ear (Bone & Ryan, 1978; Wada et al 1998). In the tunicate cupular organ, the sensory cell is a primary neuron sending an axon to the CNS. The sensory cilium is within a deep indentation of the cell and is surrounded by a collar of short microvilli." ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0009716" ;
                   rdfs:label "cupular organ" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0009716 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Epithelial sense organ containing the cupula housing a gelatinous material elongated from the basement of the organ toward the atrial cavity. The basement of the cupular organ consists of two cell types: sensory cells and support cell." ;
   oboInOwl:hasDbXref "DOI:10.2108/zsj.27.842"
 ] .


