   oboInOwl:hasDbXref "https://orcid.org/0000-0002-6601-2165"
 ] .


###  http://purl.obolibrary.org/obo/UBPROP_0000110
obo:UBPROP_0000110 rdf:type owl:AnnotationProperty ;
                   obo:IAO_0000115 "x appendage_segment_number N if and only if (i) x is a appendage_segment, and (ii) x is appendage_segment number N in a series of appendage_segments repeated along an proximo-distal axis, with appendage_segment_number 1 being the proximalmost appendage_segment (in tetrapods this would be the stylopod, as we do not classify girdles as appendage segments)." ;
                   obo:UBPROP_0000100 obo:UBERON_0010758 ;
                   obo:UBPROP_0000101 obo:BSPO_0000100 ;
                   oboInOwl:hasDbXref "UBPROP:0000110" ;
                   oboInOwl:hasOBONamespace "uberon" ;
