###  http://purl.obolibrary.org/obo/UBERON_8600026
obo:UBERON_8600026 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004120 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_8600038
                                   ] ;
                   obo:IAO_0000115 "A tree-like structure formed by chorionic villi that sprouts from the chorionic plate in the placental disc. The arborous shape of the chorionic villous tree provides maximal contact area with maternal blood in the intervillous space." ;
