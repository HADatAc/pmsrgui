###  http://purl.obolibrary.org/obo/UBERON_2000594
obo:UBERON_2000594 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0007829 ,
                                   obo:UBERON_0008907 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0007831
                                   ] ;
                   obo:IAO_0000115 "Dermal bone that articulates dorsally with the posttemporal and ventrally with the cleithrum. Supracleithrum is part of the secondary pectoral girdle and commonly, carries part of the lateral line canal." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0000594" ;
