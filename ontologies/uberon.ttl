###  http://purl.obolibrary.org/obo/UBERON_3000794
obo:UBERON_3000794 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001075 ;
                   obo:IAO_0000115 "Vertebral column in which the first seven vertebrae have holochordal centra and the intervertebral cartilages are posteriorly subdivided in the procoelous manner. The eighth presacral vertebra has a holochordal centrum and the intervertebral cartilage is subdivided in the opisthocoelous manner. Thus, the first seven presacral vertebrae are concave anteriorly and convex posteriorly, whereas the eighth is biconcave." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (amphibian_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasOBONamespace "uberon" ;
