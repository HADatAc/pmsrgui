###  http://purl.obolibrary.org/obo/UBERON_4300223
obo:UBERON_4300223 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002412 ,
                                   obo:UBERON_4300224 ;
                   obo:IAO_0000115 "Vertebral bone lacking hemal spines (Weitzman, 1962), refers generally to the anterior vertebral region bounding the abdominal cavity. Alternate but not quite synonymous terms are abdominal or trunk vertebrae, which bear parapophyses and ribs. In many actinopterygians dorsal to the posterior abdominal cavity there are transitional vertebrae lacking ribs but also without hemal spines or sometimes even enclosed hemal arches. The primary definition would identify these vertebrae as precaudal. Bird and Mabee, 2003." ;
                   terms:contributor <https://orcid.org/0000-0003-3162-7490> ;
                   oboInOwl:hasDbXref "TAO:0000263" ,
                                      "ZFA:0000263" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:4300223" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "precaudal vertebra" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_4300223 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Vertebral bone lacking hemal spines (Weitzman, 1962), refers generally to the anterior vertebral region bounding the abdominal cavity. Alternate but not quite synonymous terms are abdominal or trunk vertebrae, which bear parapophyses and ribs. In many actinopterygians dorsal to the posterior abdominal cavity there are transitional vertebrae lacking ribs but also without hemal spines or sometimes even enclosed hemal arches. The primary definition would identify these vertebrae as precaudal. Bird and Mabee, 2003." ;
   oboInOwl:hasDbXref "https://doi.org/10.1002/dvdy.10387"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_4300224
obo:UBERON_4300224 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0010913 ;
                   obo:IAO_0000115 "Vertebral elements lacking hemal spines (Weitzman, 1962), refers generally to the anterior vertebral region bounding the abdominal cavity. Alternate but not quite synonymous terms are abdominal or trunk vertebrae, which bear parapophyses and ribs. In many actinopterygians dorsal to the posterior abdominal cavity there are transitional vertebrae lacking ribs but also without hemal spines or sometimes even enclosed hemal arches. The primary definition would identify these vertebrae as precaudal.(Bird and Mabee, 2003)." ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:4300224" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "precaudal vertebra endochondral element" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_4300224 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Vertebral elements lacking hemal spines (Weitzman, 1962), refers generally to the anterior vertebral region bounding the abdominal cavity. Alternate but not quite synonymous terms are abdominal or trunk vertebrae, which bear parapophyses and ribs. In many actinopterygians dorsal to the posterior abdominal cavity there are transitional vertebrae lacking ribs but also without hemal spines or sometimes even enclosed hemal arches. The primary definition would identify these vertebrae as precaudal.(Bird and Mabee, 2003)." ;
   oboInOwl:hasDbXref "https://doi.org/10.1002/dvdy.10387"
 ] .


