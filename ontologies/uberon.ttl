###  http://purl.obolibrary.org/obo/UBERON_0011508
obo:UBERON_0011508 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002377 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0013635
                                   ] ;
                   obo:IAO_0000115 "The sphincter colli superficialis is composed of transverse muscle fibers, and covers the entire area between the lower jaw and chest. The muscle is used to tighten the skin on the underside of the throat." ;
                   obo:UBPROP_0000008 "M. sphincter colli superficialis is present in Lagomorpha but absent in Rodentia (Meinertz, 1941, 1942; Ryan, 1989; Rinker, 1954). Some errouneous references of this muscle in rodents (e.g., Bezuidenhout and Evans, 2005) are due to decussating fibers of the deep sphincter, which creates a false superficial sphincter (Ryan, 1989)" ;
                   oboInOwl:hasDbXref "EMAPA:37699" ,
                                      "MA:0002380" ,
                                      "NCIT:C53016" ;
                   oboInOwl:hasExactSynonym "M. sphincter colli superficialis" ,
                                            "sphincter colli superficialis" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0011508" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "sphincter colli superficialis muscle" .

