###  http://purl.obolibrary.org/obo/UBERON_8410070
obo:UBERON_8410070 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002426 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002372 ;
                                     owl:someValuesFrom obo:UBERON_0001077
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002373 ;
                                     owl:someValuesFrom obo:UBERON_0002228
                                   ] ;
                   obo:IAO_0000115 "A chest muscle with a role in forceful inspiration. In human, there are twelve levatores costarum on either side of the chest; they are small tendinous and fleshy bundles arising from the ends of the transverse processes of the seventh cervical and upper eleven thoracic vertebrae. They pass obliquely downward and laterally, like the fibers of the intercostales externi, and each is inserted into the outer surface of the rib immediately below the vertebra from which it takes origin, between the tubercle and the angle (levatores costarum breves). Each of the four lower muscles divides into two fasciculi, one of which is inserted as above described; the other passes down to the second rib below its origin (levatores costarum longi)." ;
                   terms:contributor <https://orcid.org/0000-0002-2825-0621> ;
                   terms:date "2022-01-27T10:41:44Z"^^xsd:dateTime ;
                   oboInOwl:hasDbXref "FMA:71312" ;
                   oboInOwl:hasExactSynonym "levator costarum muscle" ,
                                            "levatores costarum" ,
                                            "levatores costarum muscles" ,
                                            "musculi levatores costarum" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:8410070" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "levator costarum" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8410070 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A chest muscle with a role in forceful inspiration. In human, there are twelve levatores costarum on either side of the chest; they are small tendinous and fleshy bundles arising from the ends of the transverse processes of the seventh cervical and upper eleven thoracic vertebrae. They pass obliquely downward and laterally, like the fibers of the intercostales externi, and each is inserted into the outer surface of the rib immediately below the vertebra from which it takes origin, between the tubercle and the angle (levatores costarum breves). Each of the four lower muscles divides into two fasciculi, one of which is inserted as above described; the other passes down to the second rib below its origin (levatores costarum longi)." ;
   oboInOwl:hasDbXref "WikipediaVersioned:Levatores_costarum_muscles&oldid=876138804"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8410070 ;
   owl:annotatedProperty oboInOwl:hasExactSynonym ;
   owl:annotatedTarget "musculi levatores costarum" ;
   oboInOwl:hasSynonymType obo:OMO_0003011
 ] .


