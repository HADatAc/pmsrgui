###  http://purl.obolibrary.org/obo/UBERON_0013715
obo:UBERON_0013715 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001630 ,
                                   obo:UBERON_0004120 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002372 ;
