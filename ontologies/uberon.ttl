###  http://purl.obolibrary.org/obo/UBERON_0001195
obo:UBERON_0001195 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004573 ,
                                   obo:UBERON_0009658 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0001182
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002252 ;
                                     owl:someValuesFrom obo:UBERON_0001182
                                   ] ;
                   obo:IAO_0000115 "The inferior pancreaticoduodenal artery is a branch of the superior mesenteric artery or from its first intestinal branch, opposite the upper border of the inferior part of the duodenum. It courses to the right between the head of the pancreas and duodenum, and then ascends to anastomose with the anterior and posterior superior pancreaticoduodenal artery. It distributes branches to the head of the pancreas and to the descending and inferior parts of the duodenum. [WP,unvetted]." ;
                   oboInOwl:hasDbXref "EMAPA:37086" ,
                                      "FMA:14805" ,
                                      "MA:0002014" ,
                                      "NCIT:C32786" ,
                                      "SCTID:244273004" ,
                                      "UMLS:C0226319" ,
                                      "Wikipedia:Inferior_pancreaticoduodenal_artery" ;
                   oboInOwl:hasExactSynonym "inferior pancreatico-duodenal artery" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "arteriae pancreaticoduodenales inferiores" ;
                   oboInOwl:id "UBERON:0001195" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ,
                                     core:uberon_slim ;
                   rdfs:label "inferior pancreaticoduodenal artery" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/3/3b/Gray533.png"^^xsd:anyURI .

