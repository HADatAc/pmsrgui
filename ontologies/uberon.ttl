###  http://purl.obolibrary.org/obo/UBERON_0004155
obo:UBERON_0004155 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002085 ;
                   obo:IAO_0000115 "Missing definition for term UBERON:0004155. Please replace it using linked reference." ;
                   obo:UBPROP_0000001 "The second of the two membranous sheets which partially separate the two atria during embryonic development. [TFD][VHOG]" ;
                   obo:UBPROP_0000003 "The tetrapod clade develops a complete atrial septum and loses the fifth aortic arch altogether.[well established][VHOG]" ;
                   oboInOwl:hasAlternativeId "UBERON:0004158" ;
                   oboInOwl:hasDbXref "EHDAA2:0001827" ,
                                      "EHDAA:3406" ,
                                      "EMAPA:17864" ,
                                      "FMA:63910" ,
                                      "NCIT:C34295" ,
                                      "SCTID:308850005" ,
                                      "UMLS:C0225838" ,
                                      "VHOG:0000021" ,
                                      "Wikipedia:Septum_secondum" ;
                   oboInOwl:hasExactSynonym "interatrial septum secundum" ,
                                            "septum secundum" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0004155" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "The septum secundum, semilunar in shape, grows downward from the upper wall of the atrium immediately to the right of the primary septum and ostium secundum. Shortly after birth it fuses with the septum primum, and consequently the foramen ovale is closed, but sometimes the fusion is incomplete and the upper part of the foramen remains patent. The limbus fossae ovalis denotes the free margin of the septum secundum." ;
                   rdfs:label "atrial septum secundum" .

