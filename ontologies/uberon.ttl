###  http://purl.obolibrary.org/obo/UBERON_0011905
obo:UBERON_0011905 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004256 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0003823
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002568 ;
                                     owl:someValuesFrom obo:UBERON_0001385
                                   ] ;
                   obo:IAO_0000115 "Plantaris is a vestigial structure and one of the superficial muscles of the posterior crural compartment of the leg. It is innervated by the tibial nerve (S1, S2) . It is composed of a thin muscle belly and a long thin tendon. It is approximately 2-4 inches long, and is absent in 7 - 10% of the human population. It is one of the plantar flexors in the superior compartment of the leg along with the gastrocnemius, and soleus. The plantaris is considered an unimportant muscle, it mainly acts with gastrocnemius[WP]." ;
                   obo:IAO_0000116 "todo - coordinate with phenoscape-ext on representation of amphibian plantaris longus and profundus" ;
                   oboInOwl:hasDbXref "BTO:0006312" ,
                                      "EFO:0001979" ,
                                      "EMAPA:36254" ,
                                      "FMA:22543" ,
                                      "Wikipedia:Plantaris_muscle" ;
                   oboInOwl:hasExactSynonym "musculus plantaris" ,
                                            "plantaris" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0011905" ;
                   oboInOwl:inSubset core:efo_slim ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "plantaris" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011905 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Plantaris is a vestigial structure and one of the superficial muscles of the posterior crural compartment of the leg. It is innervated by the tibial nerve (S1, S2) . It is composed of a thin muscle belly and a long thin tendon. It is approximately 2-4 inches long, and is absent in 7 - 10% of the human population. It is one of the plantar flexors in the superior compartment of the leg along with the gastrocnemius, and soleus. The plantaris is considered an unimportant muscle, it mainly acts with gastrocnemius[WP]." ;
   oboInOwl:hasDbXref "Wikipedia:Plantaris_muscle"
 ] .

