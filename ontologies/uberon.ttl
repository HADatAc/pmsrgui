###  http://purl.obolibrary.org/obo/UBERON_0001327
obo:UBERON_0001327 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001325 ,
                                   obo:UBERON_0015212 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BSPO_0000126 ;
                                     owl:someValuesFrom obo:UBERON_0002355
                                   ] ,
                                   _:genid2021 ;
                   obo:IAO_0000115 "The Coccygeus is a muscle of the pelvic wall (i.e. peripheral to the pelvic floor), situated behind the levator ani and in front of the sacrospinous ligament. It is a triangular plane of muscular and tendinous fibers, arising by its apex from the spine of the ischium and sacrospinous ligament, and inserted by its base into the margin of the coccyx and into the side of the lowest piece of the sacrum. It assists the Levator ani and Piriformis in closing in the back part of the outlet of the pelvis. [WP,unvetted]." ;
                   oboInOwl:hasDbXref "EMAPA:37482" ,
                                      "FMA:19088" ,
                                      "MA:0002277" ,
                                      "Wikipedia:Coccygeus_muscle" ;
                   oboInOwl:hasExactSynonym "coccygeus" ,
                                            "ischiococcygeus" ,
                                            "musculus ischiococcygeus" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "musculus coccygeus" ;
                   oboInOwl:id "UBERON:0001327" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ,
                                     core:organ_slim ,
                                     core:uberon_slim ;
                   rdfs:label "coccygeus muscle" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/6/63/Gray404.png"^^xsd:anyURI .

