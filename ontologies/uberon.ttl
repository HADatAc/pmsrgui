###  http://purl.obolibrary.org/obo/UBERON_0006870
obo:UBERON_0006870 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0003102 ;
                   obo:IAO_0000115 "An endostyle is a longitudinal ciliated groove on the ventral wall of the pharynx which produces mucus to gather food particles. It is found in urochordates and cephalochordates, and in the larvae of lampreys. It aids in transporting food to the esophagus. It is also called the hypopharyngeal groove. The endostyle in larval lampreys (ammocetes) metamorphoses into the thyroid gland in adults, and is regarded as being homologous to the thyroid gland in vertebrates. However, Dumont, et al. question whether the endostyle in ammocetes is homologous with that of the urochordates and cephalochordates. Since the endostyle is found in the three branches of chordates, it is presumed to have arisen in the common ancestor of these taxa, along with a shift to internal feeding for extracting suspended food from the water." ;
                   obo:UBPROP_0000007 "endostylar" ;
                   oboInOwl:hasDbXref "ANISEED:1235299" ,
                                      "BSA:0000064" ,
                                      "BTO:0003173" ,
                                      "Wikipedia:Endostyle" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "hypopharyngeal groove" ;
                   oboInOwl:id "UBERON:0006870" ;
                   rdfs:comment "Dumont, et al. question whether the endostyle in ammocetes is homologous with that of the urochordates and cephalochordates[WP]." ;
                   rdfs:label "endostyle" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0006870 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An endostyle is a longitudinal ciliated groove on the ventral wall of the pharynx which produces mucus to gather food particles. It is found in urochordates and cephalochordates, and in the larvae of lampreys. It aids in transporting food to the esophagus. It is also called the hypopharyngeal groove. The endostyle in larval lampreys (ammocetes) metamorphoses into the thyroid gland in adults, and is regarded as being homologous to the thyroid gland in vertebrates. However, Dumont, et al. question whether the endostyle in ammocetes is homologous with that of the urochordates and cephalochordates. Since the endostyle is found in the three branches of chordates, it is presumed to have arisen in the common ancestor of these taxa, along with a shift to internal feeding for extracting suspended food from the water." ;
   oboInOwl:hasDbXref "Wikipedia:Endostyle"
 ] .

