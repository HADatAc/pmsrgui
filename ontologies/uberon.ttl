###  http://purl.obolibrary.org/obo/UBERON_0004743
obo:UBERON_0004743 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002513 ,
                                   obo:UBERON_0007829 ,
                                   _:genid7852 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002202 ;
                                     owl:someValuesFrom obo:UBERON_0004753
                                   ] ;
                   obo:IAO_0000115 "Endochondral bone that is paired and forms part of the socket for the humerus in tetrapods and acts as base of the pectoral fin in fish." ;
                   obo:IAO_0000116 "check developmental relationships." ;
                   obo:UBPROP_0000001 "Endochondral bone that articulates dorsally with the scapula and with the mesocoracoid when the latter is present, posteriorly with the lower two or three proximal radials and antero-ventrally with the cleithrum. The coracoid develops from the scapulo-coracoid cartilage. The coracoid is paired.[TAO]" ,
                                      "Paired cartilaginous structures or endochondral bones located on the posterolateral portions of the zonal area of the pectoral girdle.[AAO]" ;
                   obo:UBPROP_0000002 "relationship loss: part_of zonal element (AAO:0000936)[AAO]" ;
                   obo:UBPROP_0000005 "The coracoid is a triangular shaped-bone that usually has an anteriorly directed long process that may joins its counterpart in some fish groups. It may be perforated by the coracoid foramen or it may be notched dorsally and forms the scapulo-coracoid foramen together with a similar notch of the ventral margin of the scapula.[TAO]" ;
                   obo:UBPROP_0000008 "In Theria, coracoid bones non-existent or fused with the shoulder blades to form coracoid processes[WP]. Procoracoid+coracoid are homologuous with coracoid of teleostomi. The coracoid is a triangular shaped-bone that usually has an anteriorly directed long process that may joins its counterpart in some fish groups. It may be perforated by the coracoid foramen or it may be notched dorsally and forms the scapulo-coracoid foramen together with a similar notch of the ventral margin of the scapula" ;
                   obo:UBPROP_0000013 "see discussion in Kardong - suggests using procoracoid (anterior coracoid) for the element in birds, reptiles, amphibians and fish, and reserving coracoid for the new synapsid/therian structure." ;
                   oboInOwl:hasDbXref "AAO:0000764" ,
                                      "TAO:0000332" ,
                                      "VSAO:0000158" ,
                                      "Wikipedia:Coracoid" ,
                                      "ZFA:0000332" ;
                   oboInOwl:hasExactSynonym "coracoid" ,
                                            "coracoids" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "clavicula" ,
                                              "clavicula posterior" ,
                                              "clavicula vera" ,
                                              "coracoideum" ,
                                              "coracoidien" ,
                                              "metacoracoid" ,
                                              "pars sternalis scapulae" ;
                   oboInOwl:id "UBERON:0004743" ;
                   rdfs:label "coracoid bone" .

