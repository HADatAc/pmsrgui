###  http://purl.obolibrary.org/obo/UBERON_0008450
obo:UBERON_0008450 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0008549 ,
                                   _:genid10938 ;
                   obo:IAO_0000115 "A powerful flexor of the thigh at the hip joint (psoas major) and a weak flexor of the trunk and lumbar spinal column (psoas minor). Psoas is derived from the Greek 'psoa', the plural meaning 'muscles of the loin'. It is a common site of infection manifesting as abscess (PSOAS ABSCESS). The psoas muscles and their fibers are also used frequently in experiments in muscle physiology." ;
                   oboInOwl:hasDbXref "BTO:0001140" ,
                                      "EMAPA:36157" ,
                                      "MA:0002553" ,
                                      "MESH:D016658" ,
