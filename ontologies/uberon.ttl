                                            "supracleithra" ,
                                            "supracleithrum" ,
                                            "épiclithrum" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2000594" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "The dorsalmost postcleithrum or postcleithrum 1 may lie medial to the ventral part of the supracleithrum. The postotic canal or lateral line may run close to the dorsal margin or in the upper third or in the lowest third of the bone depending on the fish group." ;
                   rdfs:label "supracleithrum" .

