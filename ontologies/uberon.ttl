###  http://purl.obolibrary.org/obo/UBERON_0005161
obo:UBERON_0005161 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000026 ,
                                   obo:UBERON_0005160 ;
                   obo:IAO_0000115 "Pelvic spurs are the externally visible portion of the vestigial remnants of legs found on each side of the vent in primitive snakes, such as boas and pythons. The remnants of a pelvis and femur, which have no connection with the spine, simply 'float' in the muscle mass. The femur protrudes from the snake's body and is covered by a corneal spur, which resembles a claw. Males' spurs are generally longer and more pointed than females', and are used for clasping and tickling during courtship and mating, as well as combat with other males in some species." ;
                   obo:IAO_0000232 "this class refers to the external portion and its corneal covering rather than the combined pelvis plus femur." ;
                   oboInOwl:hasDbXref "Wikipedia:Pelvic_spur" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "anal spur" ,
                                              "cloacal spur" ;
                   oboInOwl:id "UBERON:0005161" ;
                   rdfs:label "pelvic spur" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0005161 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Pelvic spurs are the externally visible portion of the vestigial remnants of legs found on each side of the vent in primitive snakes, such as boas and pythons. The remnants of a pelvis and femur, which have no connection with the spine, simply 'float' in the muscle mass. The femur protrudes from the snake's body and is covered by a corneal spur, which resembles a claw. Males' spurs are generally longer and more pointed than females', and are used for clasping and tickling during courtship and mating, as well as combat with other males in some species." ;
   oboInOwl:hasDbXref "Wikipedia:Pelvic_spur"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0005161 ;
   owl:annotatedProperty oboInOwl:hasRelatedSynonym ;
   owl:annotatedTarget "anal spur" ;
   oboInOwl:hasDbXref "Wikipedia:Anal_spur"
 ] .


