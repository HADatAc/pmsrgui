###  http://purl.obolibrary.org/obo/UBERON_0005094
obo:UBERON_0005094 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0003102 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0000033
                                   ] ;
                   obo:IAO_0000115 "The avian beak is an external anatomical structure, in the head region, that is adapted for feeding self and young, catching prey, probing, etc. It encompasses, but is not restricted to, the maxilla, mandible, maxillary ramaphotheca, mandibular ramaphotheca, nostril, nasal fossa, nasal bones, egg tooth and rictus[GO]. The beak, bill or rostrum is an external anatomical structure of birds which is used for eating and for grooming, manipulating objects, killing prey, probing for food, courtship and feeding young." ;
                   obo:IAO_0000116 "TODO - add superclass" ;
                   obo:UBPROP_0000013 "The term beak is also used to refer to a similar mouthpart in some Ornithischian dinosaurs, monotremes, cephalopods, cetaceans, pufferfishes, turtles, Anuran tadpoles and sirens" ;
                   oboInOwl:hasDbXref "MESH:D001502" ,
                                      "Wikipedia:Beak" ;
                   oboInOwl:hasExactSynonym "avian beak" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "bill" ,
                                              "rostrum" ;
                   oboInOwl:id "UBERON:0005094" ;
                   rdfs:label "beak" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0005094 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The avian beak is an external anatomical structure, in the head region, that is adapted for feeding self and young, catching prey, probing, etc. It encompasses, but is not restricted to, the maxilla, mandible, maxillary ramaphotheca, mandibular ramaphotheca, nostril, nasal fossa, nasal bones, egg tooth and rictus[GO]. The beak, bill or rostrum is an external anatomical structure of birds which is used for eating and for grooming, manipulating objects, killing prey, probing for food, courtship and feeding young." ;
   oboInOwl:hasDbXref "GO:0071728" ,
                      "Wikipedia:Beak"
 ] .

[ rdf:type owl:Axiom ;
