                                      "XAO:0000198" ,
                                      "ZFA:0000431" ;
                   oboInOwl:hasExactSynonym "semicircular canals" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "canalis semicircularis" ,
