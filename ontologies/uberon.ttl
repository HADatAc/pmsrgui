###  http://purl.obolibrary.org/obo/UBERON_0001326
obo:UBERON_0001326 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001325 ,
                                   _:genid2014 ;
                   obo:IAO_0000115 "The Levator ani is a broad, thin muscle, situated on the side of the pelvis. It is attached to the inner surface of the side of the lesser pelvis, and unites with its fellow of the opposite side to form the greater part of the floor of the pelvic cavity. It supports the viscera in pelvic cavity, and surrounds the various structures which pass through it. In combination with the Coccygeus muscle, it forms the pelvic diaphragm. [WP,unvetted]." ;
                   obo:UBPROP_0000008 "the levator ani muscle acts to lower the tail, in animals that have one" ;
                   oboInOwl:hasDbXref "EMAPA:19165" ,
                                      "FMA:19087" ,
                                      "MA:0002332" ,
                                      "NCIT:C32984" ,
                                      "SCTID:181753008" ,
                                      "UMLS:C0224384" ,
                                      "Wikipedia:Levator_ani" ;
                   oboInOwl:hasExactSynonym "levator ani" ,
                                            "musculus levator ani" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0001326" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ,
                                     core:uberon_slim ;
                   rdfs:label "levator ani muscle" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/6/63/Gray404.png"^^xsd:anyURI .

