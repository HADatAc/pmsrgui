###  http://purl.obolibrary.org/obo/UBERON_0013234
obo:UBERON_0013234 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0011252 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0007812
                                   ] ;
                   obo:IAO_0000115 "The violet gland or supracaudal gland is an important gland located on the upper surface of the tail of certain mammals, including European badgers and canids such as foxes, wolves the domestic dog, as well as the domestic cat. It is used for intra species signalling, scent marking, and contributes to the strong odor of foxes in particular." ;
                   oboInOwl:hasDbXref "Wikipedia:Violet_gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "supracaudal gland" ;
                   oboInOwl:id "UBERON:0013234" ;
                   oboInOwl:inSubset core:mouse_subset ;
                   rdfs:label "violet gland" .

[ rdf:type owl:Axiom ;
