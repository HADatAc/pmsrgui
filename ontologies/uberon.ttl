###  http://purl.obolibrary.org/obo/UBERON_2000549
obo:UBERON_2000549 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0007829 ,
                                   obo:UBERON_0008907 ,
                                   obo:UBERON_0011164 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0003110
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0003113
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0007831
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002131 ;
                                     owl:someValuesFrom obo:UBERON_2002059
                                   ] ;
                   obo:IAO_0000115 "Dermal bone of the secondary pectoral girdle that attaches the girdle to the skull. Its dorsal process attaches to the epiotic or epioccipital, the ventral process to the intercalar and the body articulates with the supracleithrum. The postotic sensory canal or lateral line runs within or lateral to bone." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0000549" ;
                   oboInOwl:hasExactSynonym "post-temporal" ,
                                            "postemporal" ,
                                            "posttemporale" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "suprascapula" ;
                   oboInOwl:id "UBERON:2000549" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "The posttemporal is commonly a Y-shaped bone with two elongate processes. The dorsal process may be equal or longer than the ventral process or the opposite. The ventral process may be absent in some teleosts." ;
                   rdfs:label "posttemporal" .

[ rdf:type owl:Axiom ;
