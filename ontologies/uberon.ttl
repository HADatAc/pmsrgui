###  http://purl.obolibrary.org/obo/UBERON_0005886
obo:UBERON_0005886 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0010912 ,
                                   _:genid5473 ;
                   obo:IAO_0000115 "The part of the pharyngeal arch skeleton that excludes the skeleton of arches 1 and 2." ;
                   obo:RO_0002171 obo:UBERON_0000033 ;
                   obo:UBPROP_0000001 "Skeletal and cartilage elements of the gill arches; the last five of the set of seven pharyngeal arches; the numbering system can be confusing; generally branchial arch #1 is the first gill arch, or the third pharyngeal arch, but some authors do not follow this convention. Kimmel et al, 1995.[TAO]" ;
                   obo:UBPROP_0000002 "relationship type change: subclass anatomical cluster (CARO:0000041) CHANGED TO: part_of anatomical cluster (UBERON:0000477)[TAO]" ;
                   obo:UBPROP_0000012 "XAO class belongs here, as it clearly refers to arches 3-7. In ZFA this is part_of the pharyngeal arches, but we retain this structure to refer to the embryonic structure" ;
                   oboInOwl:hasDbXref "SCTID:346439007" ,
                                      "TAO:0000095" ,
                                      "XAO:0003180" ,
                                      "ZFA:0000095" ;
                   oboInOwl:hasExactSynonym "gill arch 1-5 skeleton" ,
                                            "pharyngeal arch 3-7 skeleton" ;
                   oboInOwl:hasNarrowSynonym "gill arches 1-5 skeleton" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "branchial arch skeleton" ,
                                              "gill arch skeleton" ,
                                              "pharyngeal arch skeleton 3-7" ,
                                              "visceral arch skeleton" ;
                   oboInOwl:id "UBERON:0005886" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "post-hyoid pharyngeal arch skeleton" .

