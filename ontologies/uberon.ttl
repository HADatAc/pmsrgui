###  http://purl.obolibrary.org/obo/UBERON_0008201
obo:UBERON_0008201 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0007381 ;
                   obo:IAO_0000115 "A bony external plate or scale, as on the shell of a turtle, the skin of crocodilians, the feet of some birds. Scutes are similar to scales and serve the same function. Unlike the scales of fish and snakes, which are formed from the epidermis, scutes are formed in the lower vascular layer of the skin and the epidermal element is only the top surface. Forming in the living dermis, the scutes produce a horny outer layer, that is superficially similar to that of scales. Scutes will usually not overlap as snake scales (but see the pangolin). The outer keratin layer is shed piecemeal, and not in one continuous layer of skin as seen in snakes or lizards. The dermal base may contain bone and produce dermal armour. Scutes with a bony base are properly called osteoderms. Dermal scutes are also found in the feet of birds and tails of some mammals, and are believed to be the primitive form of dermal armour in reptiles. The term is also used to describe the heavy armour of the armadillo and the extinct glyptodon, and is occasionally used as an alternative to scales in describing snakes or certain fishes, such as sturgeons[WP]." ;
                   obo:IAO_0000116 "Currently being reviewed by PHENOSCAPE:ad" ;
                   obo:UBPROP_0000013 "we synonymize osteoderm and osteoscute with scute, see https://github.com/obophenotype/uberon/issues/516" ;
                   oboInOwl:hasDbXref "SCTID:17148007" ,
                                      "Wikipedia:Scute" ;
                   oboInOwl:hasExactSynonym "scuta" ,
                                            "scutae" ,
                                            "scutum" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "osteoderm" ,
                                              "osteoscute" ;
                   oboInOwl:id "UBERON:0008201" ;
                   rdfs:label "scute" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008201 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0007381 ;
   oboInOwl:quote "it is a fold in the epidermal surface hence it is an epidermal scale" ;
   oboInOwl:source "ISBN:0073040584"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0008201 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A bony external plate or scale, as on the shell of a turtle, the skin of crocodilians, the feet of some birds. Scutes are similar to scales and serve the same function. Unlike the scales of fish and snakes, which are formed from the epidermis, scutes are formed in the lower vascular layer of the skin and the epidermal element is only the top surface. Forming in the living dermis, the scutes produce a horny outer layer, that is superficially similar to that of scales. Scutes will usually not overlap as snake scales (but see the pangolin). The outer keratin layer is shed piecemeal, and not in one continuous layer of skin as seen in snakes or lizards. The dermal base may contain bone and produce dermal armour. Scutes with a bony base are properly called osteoderms. Dermal scutes are also found in the feet of birds and tails of some mammals, and are believed to be the primitive form of dermal armour in reptiles. The term is also used to describe the heavy armour of the armadillo and the extinct glyptodon, and is occasionally used as an alternative to scales in describing snakes or certain fishes, such as sturgeons[WP]." ;
   oboInOwl:hasDbXref "Wikipedia:Scute"
 ] .

