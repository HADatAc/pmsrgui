###  http://purl.obolibrary.org/obo/UBERON_0013213
obo:UBERON_0013213 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0006969 ;
                   obo:IAO_0000115 "Ossicones are horn-like protuberances on the heads of giraffes, male okapis, and their extinct relatives, such as Sivatherium, and the climacoceratids, such as Climacoceras. Only giraffids have true ossicones (as opposed to horns or antlers). The base that a deer's antlers grow from is very similar to ossicones. Ossicones are similar to the horns of antelopes and cattle, save that they are derived from ossified cartilage, and that the ossicones remain covered in skin and fur, rather than horn. Antlers (such as on deer) are derived from bone tissue: when mature, the skin and fur covering of the antlers, termed 'velvet,' is sloughed and scraped off to expose the bone of the antlers." ;
                   oboInOwl:hasDbXref "Wikipedia:Ossicone" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0013213" ;
                   rdfs:label "ossicone" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013213 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Ossicones are horn-like protuberances on the heads of giraffes, male okapis, and their extinct relatives, such as Sivatherium, and the climacoceratids, such as Climacoceras. Only giraffids have true ossicones (as opposed to horns or antlers). The base that a deer's antlers grow from is very similar to ossicones. Ossicones are similar to the horns of antelopes and cattle, save that they are derived from ossified cartilage, and that the ossicones remain covered in skin and fur, rather than horn. Antlers (such as on deer) are derived from bone tissue: when mature, the skin and fur covering of the antlers, termed 'velvet,' is sloughed and scraped off to expose the bone of the antlers." ;
   oboInOwl:hasDbXref "Wikipedia:Ossicone"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0013216
obo:UBERON_0013216 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000481 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0003100
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000051 ;
                                     owl:someValuesFrom obo:UBERON_0001911
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000051 ;
                                     owl:someValuesFrom obo:UBERON_0002030
                                   ] ,
                                   _:genid14267 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002180 ;
                                     owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                     owl:onClass obo:UBERON_0001911
                                   ] ;
                   obo:IAO_0000115 "A large pendulous organ consisting of two or more mammary glands enclosed in a common envelope and each provided with a single nipple." ;
                   obo:UBPROP_0000001 "An udder is an organ formed of the mammary glands of female quadruped mammals, especially ruminants such as cattle, goats, sheep and deer. The udder is a single mass hanging beneath the animal, consisting of pairs of mammary glands. In cattle there are normally two pairs, in sheep, goats and deer there is one pair, and in some animals such as pigs there are many pairs. Udder care and hygiene in cows is important in milking, aiding uninterrupted and untainted milk production, and preventing mastitis. Products exist to soothe the chapped skin of the udder. This helps prevent bacterial infection, and reduces irritation during milking by the cups, and so the cow is less likely to kick the cups off[Wikipedia:Udder]." ;
                   oboInOwl:hasDbXref "SCTID:27528008" ,
                                      "Wikipedia:Udder" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0013216" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "udder" .

_:genid14267 rdf:type owl:Restriction ;
              owl:onProperty obo:RO_0002180 ;
              owl:someValuesFrom obo:UBERON_0002030 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013216 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid14267 ;
   oboInOwl:cardonality "1"
 ] .

