###  http://purl.obolibrary.org/obo/UBERON_2002082
obo:UBERON_2002082 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_2002291 ;
                   obo:IAO_0000115 "Fulcrum that is large, laterally expanded, paired or unpaired, scale-like, and that precedes the base of a fin. Arratia, G. 2009. Identifying patterns of diversity of the actinopterygian fulcra. Acta Zoologica (Stockholm) 90 (Suppl. 1): 220-235." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasExactSynonym "basal fulcra" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2002082" ;
                   rdfs:comment "Basal fulcra may precede the median fins or both of the paired and median fins. Basal fulcra may be lanceolate, leaf-like or arrow-like in shape. The series of basal fulcra may be formed by unpaired plus paired elements depending on the fish group. Most teleosts lack basal fulcra. For additional information on basal fulcra see Arratia (2008, 2009)." ;
                   rdfs:label "basal fulcrum" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2002082 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Fulcrum that is large, laterally expanded, paired or unpaired, scale-like, and that precedes the base of a fin. Arratia, G. 2009. Identifying patterns of diversity of the actinopterygian fulcra. Acta Zoologica (Stockholm) 90 (Suppl. 1): 220-235." ;
   oboInOwl:hasDbXref "PSPUB:0000171" ,
                      "TAO:GA_TG"
 ] .

[ rdf:type owl:Axiom ;
