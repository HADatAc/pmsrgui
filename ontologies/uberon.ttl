###  http://purl.obolibrary.org/obo/UBERON_8600038
obo:UBERON_8600038 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004120 ;
                   obo:IAO_0000115 "A disc-shaped structure that is part of the placenta. A placental disc supports fetal development through the exchange of nutrients between maternal and fetal bloodstreams. The placental disc is structured to keep the blood streams separate, while maximizing surface area for the transport of nutrients between them, to maintain an immunological barrier." ;
                   terms:contributor <https://orcid.org/0000-0001-6677-8489> ;
                   terms:date "2024-01-16T17:50:20Z"^^xsd:dateTime ;
                   oboInOwl:hasExactSynonym "placental disk" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:8600038" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "placental disc" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8600038 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A disc-shaped structure that is part of the placenta. A placental disc supports fetal development through the exchange of nutrients between maternal and fetal bloodstreams. The placental disc is structured to keep the blood streams separate, while maximizing surface area for the transport of nutrients between them, to maintain an immunological barrier." ;
   oboInOwl:hasDbXref "PMID:35496035"
 ] .

[ rdf:type owl:Axiom ;
