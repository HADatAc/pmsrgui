###  http://purl.obolibrary.org/obo/UBERON_0016477
obo:UBERON_0016477 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004529 ;
                   obo:IAO_0000115 "The zygomatic process of the maxilla (malar process) is a rough triangular eminence, situated at the angle of separation of the anterior, zygomatic, and orbital surfaces. In front it forms part of the anterior surface. Behind it is concave, and forms part of the infratemporal fossa. Above it is rough and serrated for articulation with the zygomatic bone. Below it presents the prominent arched border which marks the division between the anterior and infratemporal surfaces." ;
                   oboInOwl:hasBroadSynonym "malar process" ;
                   oboInOwl:hasDbXref "FMA:52895" ,
                                      "SCTID:272684007" ,
                                      "Wikipedia:Zygomatic_process_of_maxilla" ;
                   oboInOwl:hasExactSynonym "malar process of maxilla" ,
                                            "processus zygomaticus (maxilla)" ,
                                            "processus zygomaticus maxillae" ,
                                            "zygomaticoorbital process of maxilla" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "zygomatic appendage of maxilla" ;
                   oboInOwl:id "UBERON:0016477" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "zygomatic process of maxilla" .

