###  http://purl.obolibrary.org/obo/UBERON_0006713
obo:UBERON_0006713 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004121 ,
                                   obo:UBERON_0013685 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0000209
                                   ] ;
                   obo:IAO_0000115 "The frontal crest of the frontal bone ends below in a small notch which is converted into a foramen, the foramen cecum, by articulation with the ethmoid. This foramen varies in size in different subjects, and is frequently impervious; when open, it transmits a vein from the nose to the superior sagittal sinus. This has clinical importance in that infections of the nose and nearby areas can be transmitted to the meninges and brain from what is known as the danger triangle of the face." ;
                   obo:IAO_0000116 "TODO - check if this is what the FMA ID really denotes" ;
                   oboInOwl:hasDbXref "FMA:57443" ,
                                      "Wikipedia:Foramen_cecum_(frontal_bone)" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "f. caecum ossis frontalis" ,
                                              "foramen caecum ossis frontalis" ;
                   oboInOwl:id "UBERON:0006713" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "foramen cecum of frontal bone" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/9/91/Gray135.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0006713 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The frontal crest of the frontal bone ends below in a small notch which is converted into a foramen, the foramen cecum, by articulation with the ethmoid. This foramen varies in size in different subjects, and is frequently impervious; when open, it transmits a vein from the nose to the superior sagittal sinus. This has clinical importance in that infections of the nose and nearby areas can be transmitted to the meninges and brain from what is known as the danger triangle of the face." ;
   oboInOwl:hasDbXref "Wikipedia:Foramen_cecum_(frontal_bone)" ,
                      "https://github.com/obophenotype/uberon/issues/281"
 ] .

