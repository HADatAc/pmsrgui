###  http://purl.obolibrary.org/obo/UBERON_0006587
obo:UBERON_0006587 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0006592 ;
                   obo:IAO_0000115 "The ligamentum venosum is the fibrous remnant of the ductus venosus of the fetal circulation. Usually, it is attached to the left branch of the portal vein within the porta hepatis (gateway to the liver). It may be continuous with the round ligament of liver (ligamentum teres hepatis). It is invested by the peritoneal folds of the lesser omentum within a fissure on the inferior surface of the liver between the caudate and main parts of the left lobe." ;
                   oboInOwl:hasDbXref "FMA:14080" ,
                                      "SCTID:80391004" ,
                                      "Wikipedia:Ligamentum_venosum" ;
                   oboInOwl:hasExactSynonym "ligament of arantius" ,
                                            "ligamentum venosum (ductus venosus)" ,
                                            "ligamentum venosum of liver" ,
                                            "ligamentum venosus" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0006587" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "ligamentum venosum" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/a/a3/Gray1087-liver.png"^^xsd:anyURI ,
                                  "https://cdn.humanatlas.io/digital-objects/ref-organ/liver-female/v1.2/assets/3d-vh-f-liver.glb"^^xsd:anyURI ,
                                  "https://cdn.humanatlas.io/digital-objects/ref-organ/liver-male/v1.2/assets/3d-vh-m-liver.glb"^^xsd:anyURI .

