###  http://purl.obolibrary.org/obo/UBERON_0004181
obo:UBERON_0004181 rdf:type owl:Class ;
                   obo:IAO_0000231 obo:IAO_0000227 ;
                   owl:deprecated "true"^^xsd:boolean .


###  http://purl.obolibrary.org/obo/UBERON_0004187
obo:UBERON_0004187 rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( obo:UBERON_0015153
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:RO_0003000 ;
                                                                owl:someValuesFrom obo:UBERON_0022282
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf obo:UBERON_0002365 ,
                                   obo:UBERON_0004121 ,
                                   obo:UBERON_0004859 ,
                                   obo:UBERON_0015153 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0000019
                                   ] ,
                                   _:genid6975 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0003000 ;
                                     owl:someValuesFrom obo:UBERON_0022282
                                   ] ;
                   obo:IAO_0000115 "The Harderian gland is an anterior orbital gland usually associated with the nictitating membrane, and produces and secretes a variety of substances to the eye, depending upon the species[GO]." ;
                   obo:UBPROP_0000008 "In mouse the HG appears in the posterior part of eye region, in the form of nonluminated tubules between the sixteenth and eighteenth days of gestation. At birth it is still not differentiated histologically. In birds the HG originates from the conjunctival epithelium at a late embryonic stage. In the English sparrow, Passer domesticus (incubation period of about 13 days), it appears between the seventh and the eighth days of incubation. In the chick embryo (incubation period of about 21 days) it originates between the eleventh and the twelfth days.[PMID:9156609]" ,
                                      "In the limbless, burrowing amphibian Apoda (Caecilians) the harderian gland is very large, filling much of the orbit and lubricating a retractile sensory tentacle rather than the eye (Walls, 1942; Wolff, 1948)." ;
                   obo:UBPROP_0000009 "In mammals, the gland excretes an oily substance used to preen the fur[WP]" ,
                                      "In some animals it acts as an accessory to the lacrimal gland, secreting fluid that eases movement of the nictitating membrane[WP]" ,
                                      "The functions attributed to the gland are many and diverse. Amongst these, it has been held to be a site of immune responses, a source of thermoregulatory lipids, a source of pheromones, a photoprotective organ and part of a retinal-pineal axis. It is arguably the last remaining large organ of widespread dis- tribution among the vertebrates to which we cannot confidently ascribe a confirmed function." ;
                   obo:UBPROP_0000010 "The harderian gland may be compound tubular (MacLeod, 1880; Paule, 1957) or compound tubuloacinar/tubuloalveolar (Aureli, 1957; Hoffman, 1971)." ;
                   oboInOwl:hasDbXref "BTO:0000557" ,
                                      "EMAPA:19153" ,
                                      "GAID:1219" ,
                                      "MA:0001247" ,
                                      "MESH:D006243" ,
                                      "NCIT:C77619" ,
                                      "SCTID:41474005" ,
                                      "UMLS:C0018597" ,
                                      "Wikipedia:Harderian_gland" ;
                   oboInOwl:hasExactSynonym "Hardarian gland" ,
                                            "Harder's gland" ,
                                            "gland of Hardarian" ,
                                            "glandula palpebra tertia profundus" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "deep gland of the nictitating membrane" ;
                   oboInOwl:id "UBERON:0004187" ;
                   oboInOwl:inSubset core:mouse_subset ,
                                     core:organ_slim ,
                                     core:pheno_slim ;
                   rdfs:label "Harderian gland" .

