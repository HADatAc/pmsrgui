###  http://purl.obolibrary.org/obo/UBERON_0003668
obo:UBERON_0003668 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000062 ;
                   obo:IAO_0000115 "A small fluid-filled sac lined by synovial membrane with an inner capillary layer of slimy fluid. It provides a cushion between bones and tendons and/or muscles around a joint. This helps to reduce friction between the bones and allows free movement. Bursae are filled with synovial fluid and are found around most major joints of the body." ;
                   oboInOwl:hasBroadSynonym "bursa" ;
                   oboInOwl:hasDbXref "FMA:9692" ,
                                      "GAID:252" ,
                                      "MESH:D002061" ,
                                      "NCIT:C33717" ,
                                      "SCTID:182483003" ,
                                      "UMLS:C0006441" ,
                                      "Wikipedia:Synovial_bursa" ,
                                      "galen:Bursa" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "bursa synovialis" ;
                   oboInOwl:id "UBERON:0003668" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ,
                                     core:organ_slim ;
                   rdfs:label "synovial bursa" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/b/b3/Gray350.png"^^xsd:anyURI .

