###  http://purl.obolibrary.org/obo/UBERON_0011288
obo:UBERON_0011288 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0000481 ;
                   obo:IAO_0000115 "A flexible, unpaired, hollow tube found in hemichordates that arises in embryonic development as an outpocketing from the roof of the embryonic gut anterior to the pharynx. In adults, they extend dorsally from the pharynx into the probiscis, and serve to communicate with the oral cavity." ;
                   obo:UBPROP_0000010 "Their walls are composed primarily of epithelial cells, but ciliated and glandular cells are also present." ;
                   oboInOwl:hasDbXref "Wikipedia:Stomochord" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "stomatochord" ;
                   oboInOwl:id "UBERON:0011288" ;
                   rdfs:label "stomochord" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011288 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A flexible, unpaired, hollow tube found in hemichordates that arises in embryonic development as an outpocketing from the roof of the embryonic gut anterior to the pharynx. In adults, they extend dorsally from the pharynx into the probiscis, and serve to communicate with the oral cavity." ;
   oboInOwl:hasDbXref "PMID:25214631" ,
                      "Wikipedia:Stomochord"
 ] .


