###  http://purl.obolibrary.org/obo/UBERON_0013511
obo:UBERON_0013511 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0003663 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0002103
                                   ] ;
                   obo:IAO_0000115 "A long muscle found in reptiles that originates on the ilium and crosses the acetabulum and the knee joint before being inserted on the tibia." ;
                   obo:UBPROP_0000001 "The tendon of the ambiens muscle passes obliquely over the knee joint. It assists in the control of the bird's toes. This muscle is present in some reptiles but not mammals. It is present in caiques and some other South American genera, but missing in most parrot genera. This was first noted by Garrod (1874) who proposed using this and other anatomical differences to classify parrots. For oproperty_value external_definitionanatomical differences among parrots see carotid arteries, furcula, and uropygial gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "ambiens" ;
                   oboInOwl:id "UBERON:0013511" ;
                   rdfs:label "ambiens muscle" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013511 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A long muscle found in reptiles that originates on the ilium and crosses the acetabulum and the knee joint before being inserted on the tibia." ;
   oboInOwl:hasDbXref "ISBN:0073040584"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013511 ;
   owl:annotatedProperty obo:UBPROP_0000001 ;
   owl:annotatedTarget "The tendon of the ambiens muscle passes obliquely over the knee joint. It assists in the control of the bird's toes. This muscle is present in some reptiles but not mammals. It is present in caiques and some other South American genera, but missing in most parrot genera. This was first noted by Garrod (1874) who proposed using this and other anatomical differences to classify parrots. For oproperty_value external_definitionanatomical differences among parrots see carotid arteries, furcula, and uropygial gland" ;
   oboInOwl:source "http://caiquesite.com/glossary.htm"
 ] .


