                   oboInOwl:hasNarrowSynonym "lobe of breast" ,
                                             "milk patch" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "Brustdruese" ,
                                              "dug" ,
                                              "glandula mammaria" ,
                                              "lobe of mammary gland" ,
