###  http://purl.obolibrary.org/obo/UBERON_0006972
obo:UBERON_0006972 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0006555 ;
                   obo:IAO_0000115 "An exceretory tubule that usually opens to the exterior by a nephridiopore. The inner end of the tubule may be blind, ending in flame cells (protonephridium) or may open into the coelom through a ciliated funnel (metanephridium)." ;
                   oboInOwl:hasDbXref "BTO:0000923" ,
                                      "Wikipedia:Nephridium" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0006972" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "nephridium" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0006972 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An exceretory tubule that usually opens to the exterior by a nephridiopore. The inner end of the tubule may be blind, ending in flame cells (protonephridium) or may open into the coelom through a ciliated funnel (metanephridium)." ;
   oboInOwl:hasDbXref "Wikipedia:Nephridium"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0006973
obo:UBERON_0006973 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0006972 ;
                   obo:IAO_0000115 "A network of dead-end tubules lacking internal openings found in the Phylums Platyhelminthes, kinorhyncha and Rotifera." ;
                   oboInOwl:hasDbXref "BILA:0000126" ,
                                      "Wikipedia:Nephridium#Metanephridia" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0006973" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "The ends are called flame cells (if cilliated) or solenocytes (if flagellated); they function in osmoregulation and ionoregulation. The terminal cells are located at the blind end of the protonephridium. Each cell has one or more cilia and their beating inside the protonephridial tube creates an outward going current and hence a partial pressurization in the blind of the tube. Because of this pressurization drives waste fluids from the inside of the animal, they are pulled through small perforations in the terminal cells and into the protonephridium. The perforations in the terminal cell are large enough for small molecules to pass, but larger proteins are retained within the animal. From the bottom of the protonephridium the solutes are led through the tube, formed by the canal cells, and exits the animal from a small opening formed by the nephridiopore. Selective reabsorption of useful molecules by the canal cells occurs as the solutes pass down the tubule. Protonephridia are generally found in basal organisms such as flatworms. Protonephridia likely first arose as a way to cope with a hypotonic environment by removing excess water from the organism (osmoregulation). Their use as excretory/ionoregulatory structures likely arose secondarily" ;
                   rdfs:label "protonephridium" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0006973 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A network of dead-end tubules lacking internal openings found in the Phylums Platyhelminthes, kinorhyncha and Rotifera." ;
   oboInOwl:hasDbXref "Wikipedia:Nephridium#Metanephridia"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0006974
obo:UBERON_0006974 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0006972 ;
                   obo:IAO_0000115 "A type of excretory gland or nephridium found in many types of invertebrates such as Annelids, Arthropods and Molluscs. It typically consists of a ciliated funnel opening into the body cavity or coelom connected to a duct which may be variously glandularized, folded or expanded (vesiculate) and which typically opens to the organism's exterior. These ciliated tubules pump water carrying surplus ions, metabolic waste, toxins from food, and useless hormones out of the organism through openings known as nephrostomes. This waste is passed out of the body at the nephridiopore. The primary urine produced by filtration of blood (or a similar functioning fluid) is modified into secondary urine through selective reabsorption by the cells lining the metanephridium. In many earthworms the nephridial ducts open into the digestive tract instead, a condition known as enteronephry." ;
                   oboInOwl:hasDbXref "BILA:0000127" ,
                                      "Wikipedia:Nephridium#Metanephridia" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0006974" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "metanephridium" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0006974 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A type of excretory gland or nephridium found in many types of invertebrates such as Annelids, Arthropods and Molluscs. It typically consists of a ciliated funnel opening into the body cavity or coelom connected to a duct which may be variously glandularized, folded or expanded (vesiculate) and which typically opens to the organism's exterior. These ciliated tubules pump water carrying surplus ions, metabolic waste, toxins from food, and useless hormones out of the organism through openings known as nephrostomes. This waste is passed out of the body at the nephridiopore. The primary urine produced by filtration of blood (or a similar functioning fluid) is modified into secondary urine through selective reabsorption by the cells lining the metanephridium. In many earthworms the nephridial ducts open into the digestive tract instead, a condition known as enteronephry." ;
   oboInOwl:hasDbXref "Wikipedia:Nephridium#Metanephridia"
 ] .


