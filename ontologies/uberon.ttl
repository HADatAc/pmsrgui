###  http://purl.obolibrary.org/obo/UBERON_0011048
obo:UBERON_0011048 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0011043 ,
                                   _:genid12548 ;
                   obo:IAO_0000115 "The obturator internus muscle originates on the medial surface of the obturator membrane, the ischium near the membrane, and the rim of the pubis. It exits the pelvic cavity through the lesser sciatic foramen. The obturator internus is situated partly within the lesser pelvis, and partly at the back of the hip-joint. It functions to help laterally rotate extended thigh and abduct flexed thigh, as well as to steady the femoral head in the acetabulum." ;
                   obo:UBPROP_0000001 "Originates on the entire lateral surface of the pelvic rim. Dorsal fibers insert distally to the dorso-medial surface of the caput femoris and ventral fibers extend around the acetabulum to insert on the tendon of the caput femoris.[AAO]" ;
                   obo:UBPROP_0000012 "Definition generalized to accommodate AAO class - 'Originates on the entire lateral surface of the pelvic rim. Dorsal fibers insert distally to the dorso-medial surface of the caput femoris and ventral fibers extend around the acetabulum to insert on the tendon of the caput femoris.' [AAO:0010052]" ;
                   oboInOwl:hasDbXref "AAO:0010052" ,
                                      "EMAPA:36237" ,
                                      "FMA:22298" ,
                                      "NCIT:C33192" ,
                                      "SCTID:245025008" ,
                                      "UMLS:C1518529" ,
                                      "Wikipedia:Obturator_internus_muscle" ;
                   oboInOwl:hasExactSynonym "internal obturator" ,
                                            "musculus obturator internus" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "internus obturator" ,
                                              "musculus obturatorius internus" ,
                                              "obturator internus muscle" ,
                                              "obturatorius internus" ;
                   oboInOwl:id "UBERON:0011048" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "obturator internus" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/5/55/Posterior_Hip_Muscles_1.PNG"^^xsd:anyURI .

_:genid12548 rdf:type owl:Restriction ;
              owl:onProperty obo:BFO_0000050 ;
