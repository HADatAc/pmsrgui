###  http://purl.obolibrary.org/obo/UBERON_0011187
obo:UBERON_0011187 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004120 ,
                                   obo:UBERON_0005813 ,
                                   obo:UBERON_4100000 ;
                   obo:IAO_0000115 "The greater tubercle of the humerus is situated lateral to the head of the humerus and posteriolateral to the lesser tubercle. Its upper surface is rounded and marked by three flat impressions. the highest of these gives ('superior facet') insertion to the Supraspinatus the middle ('middle facet') to the Infraspinatus. the lowest one ('inferior facet'), and the body of the bone for about 2.5 cm. below it, to the Teres minor. The lateral surface of the greater tubercle is convex, rough, and continuous with the lateral surface of the body. Between the greater tubercle and the lesser tubercle is the intertubercular sulcus (bicipital groove)." ;
                   oboInOwl:hasDbXref "FMA:23390" ,
                                      "NCIT:C32700" ,
                                      "SCTID:181934009" ,
                                      "UMLS:C1512275" ,
                                      "Wikipedia:Greater_tubercle" ;
                   oboInOwl:hasExactSynonym "greater tubercle" ,
                                            "greater tubercle of humerus" ,
                                            "greater tuberosity of humerus" ,
                                            "tuberculum majus" ,
                                            "tuberculum majus humeri" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "greater tubercle of the humerus" ,
                                              "greater tuberosity" ;
                   oboInOwl:id "UBERON:0011187" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "ventral tubercle of humerus" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/3/3b/Gray326.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0011187 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0005813 ;
   oboInOwl:source "FMA"
 ] .

