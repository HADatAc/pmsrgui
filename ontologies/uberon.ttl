###  http://purl.obolibrary.org/obo/UBERON_0015881
obo:UBERON_0015881 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0015877 ,
                                   obo:UBERON_8470001 ;
                   obo:IAO_0000115 "The internal iliac lymph nodes (or hypogastric) surround the internal iliac artery and its branches (the hypogastric vessels), and receive the lymphatics corresponding to the distribution of the branches of it, i. e. , they receive lymphatics from all the pelvic viscera, from the deeper parts of the perineum, including the membranous and cavernous portions of the urethra, and from the buttock and back of the thigh. It does not receive lymph from the ovary, testis, or superior half of the rectum; the gonads drain to the paraaortic lymph nodes, while the superior half of the rectum drains to the pararectal lymph nodes." ;
                   oboInOwl:hasDbXref "FMA:16654" ,
                                      "NCIT:C88142" ,
                                      "SCTID:245357003" ,
                                      "UMLS:C0447192" ,
                                      "Wikipedia:Internal_iliac_lymph_nodes" ;
                   oboInOwl:hasExactSynonym "internal iliac node" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0015881" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "internal iliac lymph node" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0015881 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0015877 ;
   oboInOwl:source "FMA"
 ] .

