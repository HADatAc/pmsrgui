###  http://purl.obolibrary.org/obo/UBERON_0011866
obo:UBERON_0011866 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002217 ;
                   obo:IAO_0000115 "In a condyloid joint (condyloid articulation, ellipsoidal joint) an ovoid articular surface, or condyle, is received into an elliptical cavity. This permits movement in two planes, allowing flexion, extension, adduction, abduction, and circumduction." ;
                   oboInOwl:hasDbXref "FMA:75300" ,
                                      "SCTID:335493003" ,
