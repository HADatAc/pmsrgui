###  http://purl.obolibrary.org/obo/UBERON_0009964
obo:UBERON_0009964 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0009962 ;
                   obo:IAO_0000115 "Excretory organ in maxillary segment with duct opening on maxilla." ;
                   obo:IAO_0000116 "cede this term to Arthropod AO" ;
                   obo:UBPROP_0000008 "consider generalizing to include millipedes, centipedes. Function: Two different excretory organs are found among crustaceans: the antennal gland and the maxillary gland. Both have the same basic structure: an end sac and a convoluted duct that may expand into a bladder before opening to the outside. In most adult crustaceans only one or the other gland functions. The functional gland may change during the life cycle. Terminology note: http://crustacea.nhm.org/glossary/define.html?termID=327 suggests green gland as the generic term and antennal as the decapoda term" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0009964" ;
                   rdfs:label "crustacean maxillary gland" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0009964 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0009962 ;
   oboInOwl:source "BTO"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0009964 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Excretory organ in maxillary segment with duct opening on maxilla." ;
   oboInOwl:hasDbXref "http://crustacea.nhm.org/glossary/define.html"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0009965
obo:UBERON_0009965 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0009962 ;
                   obo:IAO_0000115 "A gland found in some arthropods, for collecting and excreting urine. The gland comprises an end sac (saccule), a long duct (labyrinth) and a terminal bladder (reservoir). There is generally only one pair (two in some spiders), and they open on the coxae of the walking legs[WP]." ;
                   obo:IAO_0000116 "cede this term to Arthropod AO" ;
                   obo:UBPROP_0000008 "They are found in all arachnids (with the exception of some Acari), and in other chelicerates, such as horseshoe crabs. Homology: The coxal gland is thought to be homologous with the antennal gland of crustaceans" ;
                   oboInOwl:hasDbXref "SPD:0000116" ,
                                      "TADS:0000080" ,
                                      "Wikipedia:Coxal_gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0009965" ;
                   rdfs:label "coxal gland" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0009965 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0009962 ;
   oboInOwl:source "BTO"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0009965 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A gland found in some arthropods, for collecting and excreting urine. The gland comprises an end sac (saccule), a long duct (labyrinth) and a terminal bladder (reservoir). There is generally only one pair (two in some spiders), and they open on the coxae of the walking legs[WP]." ;
   oboInOwl:hasDbXref "Wikipedia:Coxal_gland"
 ] .


