###  http://purl.obolibrary.org/obo/UBERON_0004154
obo:UBERON_0004154 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002085 ;
                   obo:IAO_0000115 "In the developing heart, the cavity of the primitive atrium becomes subdivided into right and left chambers by a septum, the septum primum, which grows downward into the cavity. The increasingly smaller gap below it (before it fuses with the endocardial cushion) is known as the ostium primum. The septum primum eventually fuses with the endocardial cushion, closing the ostium primum off completely. Meanwhile, perforations appear in the superior part of the septum primum, forming the ostium secundum. This will eventually form part of the fossa ovalis." ;
                   obo:UBPROP_0000001 "The first of the two membranous sheets which partially separate the two atria during embryonic development. [TFD][VHOG]" ;
                   obo:UBPROP_0000003 "The tetrapod clade develops a complete atrial septum and loses the fifth aortic arch altogether.[well established][VHOG]" ;
                   obo:UBPROP_0000012 "part_of IAS in EHDAA2" ;
                   oboInOwl:hasAlternativeId "UBERON:0004157" ;
                   oboInOwl:hasDbXref "EHDAA2:0001825" ,
                                      "EHDAA:1900" ,
                                      "EMAPA:17013" ,
                                      "FMA:63909" ,
                                      "NCIT:C34294" ,
                                      "SCTID:362017007" ,
                                      "UMLS:C0225837" ,
                                      "VHOG:0000020" ,
                                      "Wikipedia:Septum_primum" ;
                   oboInOwl:hasExactSynonym "atrial septum primum" ,
                                            "interatrial septum primum" ,
                                            "septum primum" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0004154" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "atrial septum primum" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/c/c7/Gray465.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0004154 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "In the developing heart, the cavity of the primitive atrium becomes subdivided into right and left chambers by a septum, the septum primum, which grows downward into the cavity. The increasingly smaller gap below it (before it fuses with the endocardial cushion) is known as the ostium primum. The septum primum eventually fuses with the endocardial cushion, closing the ostium primum off completely. Meanwhile, perforations appear in the superior part of the septum primum, forming the ostium secundum. This will eventually form part of the fossa ovalis." ;
   oboInOwl:hasDbXref "GO:0003284"
 ] .

