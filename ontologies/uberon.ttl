###  http://purl.obolibrary.org/obo/UBERON_0001561
obo:UBERON_0001561 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004573 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BSPO_0000099 ;
                                     owl:someValuesFrom obo:UBERON_0014478
                                   ] ;
                   obo:IAO_0000115 "An artery that runs along the bottom of the lowest rib. They constitute the lowest pair of branches derived from the thoracic aorta, and are in series with the intercostal arteries. Each passes along the lower border of the twelfth rib behind the kidney and in front of the Quadratus lumborum muscle, and is accompanied by the twelfth thoracic nerve. It then pierces the posterior aponeurosis of the Transversus abdominis, and, passing forward between this muscle and the Obliquus internus, anastomoses with the superior epigastric, lower intercostal, and lumbar arteries. Each subcostal artery gives off a posterior branch which has a similar distribution to the posterior ramus of an intercostal artery. [WP,unvetted]." ;
                   oboInOwl:hasDbXref "EMAPA:19097" ,
                                      "FMA:4613" ,
                                      "MA:0002048" ,
                                      "NCIT:C53000" ,
                                      "SCTID:244243008" ,
                                      "UMLS:C0226293" ,
                                      "Wikipedia:Subcostal_artery" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0001561" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ,
                                     core:uberon_slim ;
                   rdfs:label "subcostal artery" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001561 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An artery that runs along the bottom of the lowest rib. They constitute the lowest pair of branches derived from the thoracic aorta, and are in series with the intercostal arteries. Each passes along the lower border of the twelfth rib behind the kidney and in front of the Quadratus lumborum muscle, and is accompanied by the twelfth thoracic nerve. It then pierces the posterior aponeurosis of the Transversus abdominis, and, passing forward between this muscle and the Obliquus internus, anastomoses with the superior epigastric, lower intercostal, and lumbar arteries. Each subcostal artery gives off a posterior branch which has a similar distribution to the posterior ramus of an intercostal artery. [WP,unvetted]." ;
   oboInOwl:hasDbXref "Wikipedia:Subcostal_artery"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001561 ;
   owl:annotatedProperty oboInOwl:hasDbXref ;
   owl:annotatedTarget "UMLS:C0226293" ;
   oboInOwl:source "ncithesaurus:Subcostal_Artery"
 ] .


