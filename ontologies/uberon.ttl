###  http://purl.obolibrary.org/obo/UBERON_2000476
obo:UBERON_2000476 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0008907 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0011153
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_4300150
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002131 ;
                                     owl:someValuesFrom obo:UBERON_2001849
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002131 ;
                                     owl:someValuesFrom obo:UBERON_2001850
                                   ] ;
                   obo:IAO_0000115 "Dermal bone that is a flattened element that supports the branchiostegal membrane. Branchiostegal rays are generally present in a series articulating ventrally or ventro-medially with the anterior and posterior ceratobranchials whereas the most posterior ray articulates with the subopercle. The branchiostegal ray is paired." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0000476" ;
                   oboInOwl:hasExactSynonym "branchiostegal rays" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2000476" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "Although the branchiostegals are articulated or attached to the hyoid arch, they belong to the opercular series. Branchiostegal rays are of variable shape and number and their homology is problematic. Usually they are numbered from anterior to posterior elements, instead from posterior to anteriorly considering that the last element of the series is consistently associated to the subopercle. For a survey of branchiostegal rays see Mc Allister (1968)." ;
                   rdfs:label "branchiostegal ray" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000476 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Dermal bone that is a flattened element that supports the branchiostegal membrane. Branchiostegal rays are generally present in a series articulating ventrally or ventro-medially with the anterior and posterior ceratobranchials whereas the most posterior ray articulates with the subopercle. The branchiostegal ray is paired." ;
   oboInOwl:hasDbXref "ZFIN:curator"
 ] .

