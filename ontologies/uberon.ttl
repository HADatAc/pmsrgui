###  http://purl.obolibrary.org/obo/UBERON_8410078
obo:UBERON_8410078 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001473 ;
                   obo:IAO_0000115 "A great lymphatic vessel that empties lymph into one of the subclavian veins. In humans, there are two lymph ducts in the body: the right lymphatic duct and the thoracic duct. The right lymphatic duct drains lymph from the right upper limb, right side of thorax and right halves of head and neck. The thoracic duct drains lymph into the circulatory system at the left brachiocephalic vein between the left subclavian and left internal jugular veins." ;
                   terms:contributor <https://orcid.org/0000-0002-2825-0621> ;
                   terms:date "2022-03-25T10:41:22Z"^^xsd:dateTime ;
                   oboInOwl:hasDbXref "FMA:5832" ;
                   oboInOwl:hasExactSynonym "ductus lymphaticus dexter" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:8410078" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "This term ('right lymphatic duct') would not need a 'left' counterpart; the other great lymph duct in the human body is represented by UBERON:0001631 'thoracic duct'." ;
                   rdfs:label "right lymphatic duct" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8410078 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A great lymphatic vessel that empties lymph into one of the subclavian veins. In humans, there are two lymph ducts in the body: the right lymphatic duct and the thoracic duct. The right lymphatic duct drains lymph from the right upper limb, right side of thorax and right halves of head and neck. The thoracic duct drains lymph into the circulatory system at the left brachiocephalic vein between the left subclavian and left internal jugular veins." ;
   oboInOwl:hasDbXref "Wikipedia:Lymph_duct"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8410078 ;
   owl:annotatedProperty oboInOwl:hasExactSynonym ;
   owl:annotatedTarget "ductus lymphaticus dexter" ;
   oboInOwl:hasSynonymType obo:OMO_0003011
 ] .


###  http://purl.obolibrary.org/obo/UBERON_8410081
obo:UBERON_8410081 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001981 ,
                                   obo:UBERON_0010523 ;
                   obo:IAO_0000115 "Any of the smallest blood vessels where blood circulates within organ tissues. Microvessels include terminal arterioles, metarterioles, capillaries, and venules (but exclude lymphatic capillaries). Arterioles carry oxygenated blood to the capillaries, and blood flows out of the capillaries through venules into veins." ;
                   obo:UBPROP_0000007 "microvascular" ;
                   oboInOwl:created_by "http://orcid.org/0000-0002-2825-0621" ;
                   oboInOwl:hasBroadSynonym "microvasculature" ,
                                            "microvessel" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:8410081" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "blood microvessel" ;
                   rdfs:seeAlso "https://github.com/obophenotype/uberon/issues/2186" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_8410081 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Any of the smallest blood vessels where blood circulates within organ tissues. Microvessels include terminal arterioles, metarterioles, capillaries, and venules (but exclude lymphatic capillaries). Arterioles carry oxygenated blood to the capillaries, and blood flows out of the capillaries through venules into veins." ;
   oboInOwl:hasDbXref "Wikipedia:Microcirculation" ,
                      "http://orcid.org/0000-0002-7073-9172"
 ] .


