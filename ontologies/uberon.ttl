###  http://purl.obolibrary.org/obo/UBERON_0008549
obo:UBERON_0008549 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004518 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002371 ;
                                     owl:someValuesFrom obo:UBERON_0002412
                                   ] ;
                   obo:IAO_0000115 "One of the muscles deep to the prevertebral fascia on the anterior surface of the cervical and superior three thoracic vertebrae, symmetrically placed on each side of the median plane, including the longus colli, longus capitis, rectus capitis anterior, and rectus capitis lateralis muscles. innervated by anterior rami of cervical spinal nerves." ;
                   oboInOwl:hasDbXref "FMA:32514" ,
                                      "Wikipedia:Prevertebral_muscles" ;
                   oboInOwl:hasExactSynonym "flexor muscle of vertebral column" ,
                                            "prevertebral muscle" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0008549" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:comment "some authorities define the group as medial to the plane of the cervicobrachial plexus, and thus also include the anterior scalene muscle. Action notes: flexors of the head and neck" ;
                   rdfs:label "prevertebral muscle" ;
                   foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/b/b0/Prevertebral_muscles.png"^^xsd:anyURI .

