   owl:annotatedProperty obo:UBPROP_0000008 ;
   owl:annotatedTarget "The spiracle is still found in all cartilaginous fish except chimaeras, and in bony fishes in the coelacanth, sturgeon, paddlefish and bichirs. It is also seen as an otic notch in the skull of the extinct labyrinthodonts, and is thought to be associated with the ear opening in amniotes and frogs" ;
   oboInOwl:source "WP"
 ] .

[ rdf:type owl:Axiom ;
