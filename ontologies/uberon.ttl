                                      "celiac" ;
                   oboInOwl:hasDbXref "BTO:0000020" ,
                                      "CALOHA:TS-0001" ,
                                      "EFO:0000968" ,
                                      "EMAPA:35102" ,
                                      "EV:0100011" ,
