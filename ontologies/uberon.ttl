###  http://purl.obolibrary.org/obo/UBERON_2000660
obo:UBERON_2000660 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001076 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_4000167
                                   ] ;
                   obo:IAO_0000115 "A free, modified neural spine of a preural or a ural vertebra that is placed between the last developed neural spine of a preural centrum and the dorsal axis (= anterior margin of first uroneural) of the caudal skeleton . An epural commonly supports one or more dorsal procurrent rays. An epural is an unpaired median perichondrally ossified bone." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (teleost_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasDbXref "ZFA:0000660" ;
                   oboInOwl:hasExactSynonym "epiural" ,
                                            "epiural apophysis" ,
                                            "epurals" ,
                                            "éphural" ,
                                            "épural" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:2000660" ;
                   rdfs:comment "The origin of the epurals is unclear, three hypotheses have been proposed: 1) The epurals are modified radials or dorsal radials; 2) the epurals are detached neural spines and may support fin rays; and 3) the epurals are a serial homologue of the supraneuralia. At least in teleosts the epural is a detached neural spine. For details see Schultze and Arratia (1989) and Arratia and Schultze (1992)." ;
                   rdfs:label "epural" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_2000660 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A free, modified neural spine of a preural or a ural vertebra that is placed between the last developed neural spine of a preural centrum and the dorsal axis (= anterior margin of first uroneural) of the caudal skeleton . An epural commonly supports one or more dorsal procurrent rays. An epural is an unpaired median perichondrally ossified bone." ;
   oboInOwl:hasDbXref "DOI:10.1002/jmor.1052140209"
 ] .

