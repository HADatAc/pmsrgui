###  http://purl.obolibrary.org/obo/UBERON_0006641
obo:UBERON_0006641 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0004120 ,
                                   obo:UBERON_0005160 ;
                   obo:IAO_0000115 "On the head of the epididymis is a small stalked appendage (sometimes duplicated). It is named the appendix of the epididymis (or pedunculated hydatid), and is usually regarded as a detached efferent duct. This structure is derived from the Wolffian duct as opposed to the appendix testis which is derived from the mullerian duct remnant." ;
                   oboInOwl:hasDbXref "EMAPA:19086" ,
                                      "FMA:18268" ,
                                      "MA:0003245" ,
                                      "Wikipedia:Appendix_of_epididymidis" ;
                   oboInOwl:hasExactSynonym "appendix of epididymis" ,
                                            "epididymal appendix" ,
                                            "epididymis appendix" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "appendix epididymidis" ,
                                              "appendix epididymis" ,
                                              "appendix of the epididymis" ;
