                                     core:pheno_slim ,
                                     core:uberon_slim ,
                                     core:vertebrate_core ;
                   rdfs:comment "EDITOR_NOTE In various sources such as Encyclopedia Britannica, the excretory and urinary systems are indeed the same system (see wikipedia talk page); we merge two BTO classes here" ;
                   rdfs:label "renal system" .

