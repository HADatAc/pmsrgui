###  http://purl.obolibrary.org/obo/UBERON_0010019
obo:UBERON_0010019 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0003102 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0001004
                                   ] ;
                   obo:IAO_0000115 "A small hole behind each eye that opens to the mouth in some fish. In the primitive jawless fish the first gill opening immediately behind the mouth is essentially similar to the other gill openings." ;
                   obo:UBPROP_0000008 "In elasmobranchs (sharks and rays), a spiracle is found behind each eye, and is often used to pump water through the gills while the animal is at rest (Fouts, 2003). A spiracle is also found in primitive bony fishes as the chirrups." ,
                                      "The spiracle is still found in all cartilaginous fish except chimaeras, and in bony fishes in the coelacanth, sturgeon, paddlefish and bichirs. It is also seen as an otic notch in the skull of the extinct labyrinthodonts, and is thought to be associated with the ear opening in amniotes and frogs" ;
                   obo:UBPROP_0000012 "GO term spiracle morphogenesis, open tracheal system - does not refer to this structure" ;
                   oboInOwl:hasBroadSynonym "spiracle" ;
                   oboInOwl:hasDbXref "Wikipedia:Spiracle#Vertebrates" ;
                   oboInOwl:hasExactSynonym "vertebrate spiracle" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0010019" ;
                   rdfs:label "spiracle (sensu Vertebrata)" .

