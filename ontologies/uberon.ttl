obo:UBERON_0013219 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002530 ;
                   obo:IAO_0000115 "The parotoid gland (alternatively, paratoid gland) is an external skin gland on the back, neck, and shoulder of toads and some frogs and salamanders. It secretes a milky alkaloid substance to deter predators. The substance produced acts as a neurotoxin. Parotoid glands are sometimes said to be wart-like in appearance, though warts are abnormal growths caused by viral infections while parotoid glands are normal, healthy parts of the animals that bear them. The vague similarity in appearance, however, is the reason behind the mistaken belief that touching a toad causes warts." ;
                   oboInOwl:hasDbXref "Wikipedia:Parotoid_gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "paratoid gland" ;
                   oboInOwl:id "UBERON:0013219" ;
                   rdfs:label "parotoid gland" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013219 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The parotoid gland (alternatively, paratoid gland) is an external skin gland on the back, neck, and shoulder of toads and some frogs and salamanders. It secretes a milky alkaloid substance to deter predators. The substance produced acts as a neurotoxin. Parotoid glands are sometimes said to be wart-like in appearance, though warts are abnormal growths caused by viral infections while parotoid glands are normal, healthy parts of the animals that bear them. The vague similarity in appearance, however, is the reason behind the mistaken belief that touching a toad causes warts." ;
   oboInOwl:hasDbXref "Wikipedia:Parotoid_gland"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0013221
obo:UBERON_0013221 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0003663 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:BFO_0000050 ;
                                     owl:someValuesFrom obo:UBERON_0002103
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002372 ;
                                     owl:someValuesFrom obo:UBERON_0035102
                                   ] ;
                   obo:IAO_0000115 "The caudofemoralis (from the latin cauda, tail and femur, thighbone) is a muscle found in the pelvic limb of mostly all animals possessing a tail, since it is a synapomorphy appeared on the Archosauria clade. It is thus found in felids (cats) and Mustela ('Weasels'), but also on crocodiles and birds." ;
                   obo:RO_0002175 obo:NCBITaxon_399537 ;
                   obo:UBPROP_0000014 "The Caudofemoralis acts to flex the tail laterally to its respective side when the pelvic limb is bearing weight. When the pelvic limb is lifted off the ground, contraction of the Caudofemoralis causes the limb to abduct and the shank to extend by extending the hip joint (acetabulofemoral or coxofemoral joint)" ;
                   oboInOwl:hasDbXref "EMAPA:36226" ,
                                      "Wikipedia:Caudofemoralis" ;
                   oboInOwl:hasExactSynonym "M. caudofemoralis" ,
                                            "caudofemoralis muscle" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0013221" ;
                   oboInOwl:inSubset core:mouse_subset ;
                   rdfs:label "caudofemoralis" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013221 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The caudofemoralis (from the latin cauda, tail and femur, thighbone) is a muscle found in the pelvic limb of mostly all animals possessing a tail, since it is a synapomorphy appeared on the Archosauria clade. It is thus found in felids (cats) and Mustela ('Weasels'), but also on crocodiles and birds." ;
   oboInOwl:hasDbXref "Wikipedia:Caudofemoralis"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013221 ;
   owl:annotatedProperty obo:RO_0002175 ;
   owl:annotatedTarget obo:NCBITaxon_399537 ;
   oboInOwl:source "DOI:10.1002/ar.22919"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0013223
obo:UBERON_0013223 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0002530 ;
                   obo:IAO_0000115 "In contrast to tubular glands, in the second main variety of gland, the secretory portion is enlarged and the lumen variously increased in size. These are termed alveolar glands (or saccular glands, or acinar glands, or acinous glands). Some sources draw a clear distinction between acinar and alveolar glands, based upon the shape of the lumen. A further complication in the case of the alveolar glands may occur in the form of still smaller saccular diverticuli growing out from the main sacculi. These are termed alveoli. The term 'tubulo-alveolar' (or 'tubulo-acinar', or 'compound tubulo-acinar', or 'compound tubulo-alveolar') is used to describe glands that start out as branched tubular, and branch further to terminate in alveoli. This type of gland is found in the salivary glands, esophagus, and mammary glands. The term 'racemose gland' is used to describe a 'compound alveolar gland' or 'compound acinar gland'." ;
                   oboInOwl:hasDbXref "Wikipedia:Alveolar_gland" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:hasRelatedSynonym "acinar gland" ,
                                              "acinous gland" ,
                                              "alveolar gland" ,
                                              "saccular gland" ;
                   oboInOwl:id "UBERON:0013223" ;
                   oboInOwl:inSubset core:human_subset ,
                                     core:mouse_subset ;
                   rdfs:label "alveolar gland" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/9/99/Gray1105.png"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013223 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget obo:UBERON_0002530 ;
   oboInOwl:source "Wikipedia"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013223 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "In contrast to tubular glands, in the second main variety of gland, the secretory portion is enlarged and the lumen variously increased in size. These are termed alveolar glands (or saccular glands, or acinar glands, or acinous glands). Some sources draw a clear distinction between acinar and alveolar glands, based upon the shape of the lumen. A further complication in the case of the alveolar glands may occur in the form of still smaller saccular diverticuli growing out from the main sacculi. These are termed alveoli. The term 'tubulo-alveolar' (or 'tubulo-acinar', or 'compound tubulo-acinar', or 'compound tubulo-alveolar') is used to describe glands that start out as branched tubular, and branch further to terminate in alveoli. This type of gland is found in the salivary glands, esophagus, and mammary glands. The term 'racemose gland' is used to describe a 'compound alveolar gland' or 'compound acinar gland'." ;
   oboInOwl:hasDbXref "Wikipedia:Alveolar_gland"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0013223 ;
