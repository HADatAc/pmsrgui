###  http://purl.obolibrary.org/obo/UBERON_4000172
obo:UBERON_4000172 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0008907 ,
                                   obo:UBERON_4300037 ;
                   obo:IAO_0000115 "Dermal bone that is rod-like, formed and usually contained in a fin membrane, and jointed to or adjacent to distal radials. Lepidotrichia are formed from paired hemitrichia surrounding actinotrichia. There are usually two more lepidotrichia than distal radials." ;
                   obo:UBPROP_0000004 "This class was sourced from an external ontology (vertebrate_skeletal_anatomy). Its definitions, naming conventions and relationships may need to be checked for compatibility with uberon" ;
                   oboInOwl:hasBroadSynonym "fin ray" ;
                   oboInOwl:hasDbXref "ZFA:0001554" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:4000172" ;
                   rdfs:comment "Need to review develops_from relationship to actinotrichia. Lepidotrichia require actinotrichia for development, but develops_from may not be appropriate relationship.  See Zhang et al 2010 for details.  doi:10.1038/nature09137" ;
                   rdfs:label "lepidotrichium" .

