###  http://purl.obolibrary.org/obo/UBERON_0001406
obo:UBERON_0001406 rdf:type owl:Class ;
                   rdfs:subClassOf obo:UBERON_0001637 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0002170 ;
                                     owl:someValuesFrom obo:UBERON_0001398
                                   ] ;
                   obo:IAO_0000115 "The ulnar artery is the main blood vessel, with oxygenated blood, of the medial aspect of the forearm. It arises from the brachial artery and terminates in the superficial palmar arch, which joins with the superficial branch of the radial artery. It is palpable on the anterior and medial aspect of the wrist. Along its course, it is accompanied by a similarly named vein or veins, the ulnar vein or ulnar veins. The ulnar artery, the larger of the two terminal branches of the brachial, begins a little below the bend of the elbow in the cubital fossa, and, passing obliquely downward, reaches the ulnar side of the forearm at a point about midway between the elbow and the wrist. It then runs along the ulnar border to the wrist, crosses the transverse carpal ligament on the radial side of the pisiform bone, and immediately beyond this bone divides into two branches, which enter into the formation of the superficial and deep volar arches. [WP,unvetted]." ;
                   oboInOwl:hasDbXref "EMAPA:37675" ,
                                      "FMA:22796" ,
                                      "GAID:515" ,
                                      "MA:0002069" ,
                                      "MESH:D017535" ,
                                      "NCIT:C12839" ,
                                      "SCTID:181333006" ,
                                      "UMLS:C0162858" ,
                                      "Wikipedia:Ulnar_artery" ,
                                      "galen:UlnarArtery" ;
                   oboInOwl:hasExactSynonym "arteria ulnaris" ;
                   oboInOwl:hasOBONamespace "uberon" ;
                   oboInOwl:id "UBERON:0001406" ;
                   oboInOwl:inSubset core:human_reference_atlas ,
                                     core:human_subset ,
                                     core:mouse_subset ,
                                     core:uberon_slim ;
                   rdfs:label "ulnar artery" ;
                   foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/a/a9/Gray1237.svg"^^xsd:anyURI .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UBERON_0001406 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The ulnar artery is the main blood vessel, with oxygenated blood, of the medial aspect of the forearm. It arises from the brachial artery and terminates in the superficial palmar arch, which joins with the superficial branch of the radial artery. It is palpable on the anterior and medial aspect of the wrist. Along its course, it is accompanied by a similarly named vein or veins, the ulnar vein or ulnar veins. The ulnar artery, the larger of the two terminal branches of the brachial, begins a little below the bend of the elbow in the cubital fossa, and, passing obliquely downward, reaches the ulnar side of the forearm at a point about midway between the elbow and the wrist. It then runs along the ulnar border to the wrist, crosses the transverse carpal ligament on the radial side of the pisiform bone, and immediately beyond this bone divides into two branches, which enter into the formation of the superficial and deep volar arches. [WP,unvetted]." ;
   oboInOwl:hasDbXref "Wikipedia:Ulnar_artery"
 ] .

[ rdf:type owl:Axiom ;
