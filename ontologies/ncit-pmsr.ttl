###  http://purl.obolibrary.org/obo/NCIT_A5
obo:NCIT_A5 rdf:type owl:AnnotationProperty ;
            obo:IAO_0000115 "An association that connects the base form of a drug with its various salt forms." ;
            obo:NCIT_NHC0 "A5" ;
            obo:NCIT_P106 "Conceptual Entity" ;
            obo:NCIT_P107 "Has Salt Form" ;
            obo:NCIT_P108 "Has_Salt_Form" ;
            obo:NCIT_P98 "USAGE NOTE: A salt form of a drug consists of 2 parts, one acidic and one basic group that are readily disassociated in liquid phase. Salt forms are either salts of strong acids and basic drugs (e.g. Atropine Sulfate, Cetirizine Hydrochloride) or salts of strong bases and acidic drugs (Allopurinol Sodium). This association is usually used in conjunction with Has_Free_Acid_Or_Base_Form." ;
            oboInOwl:hasExactSynonym "Has_Salt_Form" ;
            rdfs:label "Has_Salt_Form" ;
            rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A6
obo:NCIT_A6 rdf:type owl:AnnotationProperty ;
            obo:IAO_0000115 "An association that connects the salt form of a drug with its free acid or free base." ;
            obo:NCIT_NHC0 "A6" ;
            obo:NCIT_P106 "Conceptual Entity" ;
            obo:NCIT_P107 "Has Free Acid Or Base Form" ;
            obo:NCIT_P108 "Has_Free_Acid_Or_Base_Form" ;
            obo:NCIT_P98 "The free acid or base is responsible for the drug's therapeutic effect. Hence, the salt form of a drug has the same mechanism of action as the free acid or base form." ;
            oboInOwl:hasExactSynonym "Has_Free_Acid_Or_Base_Form" ;
            rdfs:label "Has_Free_Acid_Or_Base_Form" ;
            rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A7
obo:NCIT_A7 rdf:type owl:AnnotationProperty ;
            obo:IAO_0000115 "An association that connects a drug or other agent to a clinically intended, molecular-scale target. The target value may be a gene, gene product, anatomic structure, cell, biological process, or other concept, where the effect of the agent on the target is thought to be of therapeutic, diagnostic, or other clinical relevance to a disease process. The effect is most often direct, as defined at a molecular scale, but may also be indirect and/or defined at a larger scale." ;
            obo:NCIT_NHC0 "A7" ;
            obo:NCIT_P106 "Conceptual Entity" ;
            obo:NCIT_P107 "Has Target" ;
            obo:NCIT_P108 "Has_Target" ;
            oboInOwl:hasExactSynonym "Has_Target" ;
            rdfs:label "Has_Target" ;
            rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A8
obo:NCIT_A8 rdf:type owl:AnnotationProperty ;
            obo:IAO_0000115 "An association that connects the concept defining a particular terminology subset with concepts that belong to this subset." ;
            obo:NCIT_NHC0 "A8" ;
            obo:NCIT_P106 "Conceptual Entity" ;
            obo:NCIT_P107 "Concept Is In Subset" ;
            obo:NCIT_P108 "Concept_In_Subset" ;
            oboInOwl:hasExactSynonym "Concept_In_Subset" ;
            rdfs:label "Concept_In_Subset" ;
            rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A9
obo:NCIT_A9 rdf:type owl:AnnotationProperty ;
            obo:IAO_0000115 "An association that is asserted when there is a relationship or association between the therapeutic moiety and the endogenous gene product." ;
            obo:NCIT_NHC0 "A9" ;
            obo:NCIT_P106 "Conceptual Entity" ;
