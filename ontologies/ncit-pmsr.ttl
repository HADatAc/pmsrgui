             rdfs:range xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_P97
obo:NCIT_P97 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "A property representing the English language definitions of what NCI means by the concept. They may also include information about the definition's source and attribution in a form that can easily be interpreted by software." ;
             obo:NCIT_NHC0 "P97" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P107 "Definition" ;
             obo:NCIT_P108 "DEFINITION" ;
