###  http://purl.obolibrary.org/obo/NCIT_C159425
obo:NCIT_C159425 rdf:type owl:Class ;
                 rdfs:subClassOf obo:NCIT_C16830 ;
                 obo:IAO_0000115 "A system for the repair of bone fractures comprised of a PET or Dacron balloon mounted on an insertion catheter. The balloon catheter is delivered through a small pathway into the intramedullary canal transiting the fracture site and is then infused with a biocompatible monomer, causing it to expand, fill, and conform to the patient's intramedullary canal. The monomer infused balloon is activated to cure by visible light. The cured implant provides both longitudinal strength and rotational stability to allow for fracture repair and stabilization." ;
                 obo:NCIT_NHC0 "C159425" ;
                 obo:NCIT_P106 "Manufactured Object" ;
                 obo:NCIT_P107 "Photodynamic Bone Stabilization System" ;
                 obo:NCIT_P108 "Photodynamic Bone Stabilization System" ;
                 obo:NCIT_P208 "CL951703" ;
                 obo:NCIT_P322 "CTRP" ;
                 oboInOwl:hasExactSynonym "PBSS" ,
                                          "Photodynamic Bone Stabilization System" ;
                 oboInOwl:inSubset obo:NCIT_C116977 ,
                                   obo:NCIT_C118169 ;
                 rdfs:label "Photodynamic Bone Stabilization System" .


###  http://purl.obolibrary.org/obo/NCIT_C159518
obo:NCIT_C159518 rdf:type owl:Class ;
                 rdfs:subClassOf obo:NCIT_C16742 ;
                 obo:IAO_0000115 "A proprietary combination of PET/CT hardware and software designed to provide relatively motion-free images with higher count statistics for improved image quality and small lesion conspicuity. Using a highly automated, amplitude-based gating technology, HD Chest adapts to every patients breathing and automatically selects the optimal data range with the least amount of motion and the highest count statistics, producing images the chest and upper abdomen in high-definition without respiratory motion." ;
                 obo:NCIT_NHC0 "C159518" ;
                 obo:NCIT_P106 "Manufactured Object" ;
                 obo:NCIT_P107 "HD Chest" ;
                 obo:NCIT_P108 "HD Chest" ;
                 obo:NCIT_P208 "CL951416" ;
                 obo:NCIT_P322 "CTRP" ;
                 oboInOwl:hasExactSynonym "HD Chest" ,
                                          "HD Chest System" ,
                                          "High Definition Chest Software" ;
                 oboInOwl:inSubset obo:NCIT_C116977 ,
                                   obo:NCIT_C118169 ;
                 rdfs:label "HD Chest" .


