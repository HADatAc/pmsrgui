###  http://purl.obolibrary.org/obo/NCIT_A17
obo:NCIT_A17 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association that specifies the physical conditions describing the molecular form of a product. The target value should belong to the EDQM-HC State of Matter Terminology." ;
             obo:NCIT_NHC0 "A17" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Has_Pharmaceutical_State_Of_Matter" ;
             oboInOwl:hasExactSynonym "Has_Pharmaceutical_State_Of_Matter" ,
                                      "State of Matter" ;
             rdfs:label "Has_Pharmaceutical_State_Of_Matter" ;
             rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A18
obo:NCIT_A18 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association that specifies the category of the pharmaceutical dose form, used to group together related pharmaceutical dose forms. The target value should belong to the EDQM-HC Basic Dose Form Terminology." ;
             obo:NCIT_NHC0 "A18" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Has_Pharmaceutical_Basic_Dose_Form" ;
             oboInOwl:hasExactSynonym "Basic Dose Form" ,
                                      "Has_Pharmaceutical_Basic_Dose_Form" ;
             rdfs:label "Has_Pharmaceutical_Basic_Dose_Form" ;
             rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A19
obo:NCIT_A19 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association that specifies the methods by which a pharmaceutical product is intended to be administered to the patient. The target value should belong to the EDQM-HC Administration Method Terminology." ;
             obo:NCIT_NHC0 "A19" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Has_Pharmaceutical_Administration_Method" ;
             oboInOwl:hasExactSynonym "Administration Method" ,
                                      "Has_Pharmaceutical_Administration_Method" ;
             rdfs:label "Has_Pharmaceutical_Administration_Method" ;
             rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A2
obo:NCIT_A2 rdf:type owl:AnnotationProperty ;
            obo:IAO_0000115 "An association that specifies  the parent of the branch encompassing the role's range." ;
            obo:NCIT_NHC0 "A2" ;
