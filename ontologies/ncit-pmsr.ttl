###  http://purl.obolibrary.org/obo/NCIT_C42796
obo:NCIT_C42796 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16830 ;
                obo:IAO_0000115 "A material used in medical and dental practice for filling a natural cavity or deep or tunneled wound. The packing absorbs drainage from the wound so the tissues can heal from the inside out. Without the packing, the wound could close without healing the deep areas of the wound." ;
                obo:NCIT_NHC0 "C42796" ;
