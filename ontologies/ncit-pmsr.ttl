###  http://purl.obolibrary.org/obo/NCIT_C43190
obo:NCIT_C43190 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C43164 ;
                obo:IAO_0000115 "A container, usually made of glass or metal, that has at least two walls with the space between each wall evacuated so as to prevent the transfer of heat. The inside of the container often has a coating (as silvering) on the inside to reduce heat transfer, and is used especially for storing liquefied gases or for experiments at low temperatures. The size can vary from that of a small thermos bottle up to that which may be mounted upon a large truck (also known as a 'cryogenic truck')." ;
                obo:NCIT_NHC0 "C43190" ;
                obo:NCIT_P106 "Manufactured Object" ;
                obo:NCIT_P108 "Dewar" ;
                obo:NCIT_P207 "C1707728" ;
                obo:NCIT_P317 "Package Type (C-DRG-00907)" ;
                obo:NCIT_P322 "FDA" ;
                obo:NCIT_P325 "A container, usually made of glass or metal, that has at least two walls with the space between each wall evacuated so as to prevent the transfer of heat. The inside of the container often has a coating (as silvering) on the inside to reduce heat transfer, and is used especially for storing liquefied gases or for experiments at low temperatures. The size can vary from that of a small thermos bottle up to that which may be mounted upon a large truck (also known as a 'cryogenic truck')." ;
                obo:NCIT_P366 "Dewar" ;
                oboInOwl:hasExactSynonym "DEWAR" ,
                                         "Dewar" ;
                oboInOwl:inSubset obo:NCIT_C133805 ,
                                  obo:NCIT_C133853 ,
                                  obo:NCIT_C54452 ,
                                  obo:NCIT_C54457 ;
                rdfs:label "Dewar" .


