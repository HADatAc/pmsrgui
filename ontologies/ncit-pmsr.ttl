###  http://purl.obolibrary.org/obo/NCIT_P399
obo:NCIT_P399 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the numerical CDR ID, which is the NCI Drug Dictionary identifier for a chemical or pharmaceutical agent." ;
              obo:NCIT_NHC0 "P399" ;
              obo:NCIT_P106 "Conceptual Entity" ;
              obo:NCIT_P108 "NCI_Drug_Dictionary_ID" ;
              oboInOwl:hasExactSynonym "NCI_Drug_Dictionary_ID" ;
              rdfs:label "NCI_Drug_Dictionary_ID" ;
