###  http://purl.obolibrary.org/obo/NCIT_A16
obo:NCIT_A16 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association created to allow the source INC to assign a parent to each concept with the intent of creating a hierarchy that includes only terms in which they are the contributing source." ;
             obo:NCIT_NHC0 "A16" ;
