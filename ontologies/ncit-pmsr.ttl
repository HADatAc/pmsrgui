                rdfs:subClassOf obo:NCIT_C42734 ;
                obo:IAO_0000115 "A medical device that is inserted into the uterus to prevent pregnancy." ;
                obo:NCIT_NHC0 "C92758" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Contraceptive Coil" ;
                obo:NCIT_P207 "C0419518" ;
                obo:NCIT_P325 "A contraceptive device, which is shaped like a coil, and is inserted into the uterus to prevent pregnancy." ;
                oboInOwl:hasExactSynonym "Contraceptive Coil" ;
                rdfs:label "Contraceptive Coil" .


