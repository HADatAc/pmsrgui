obo:NCIT_C92759 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C41075 ,
                                obo:NCIT_C42734 ;
                obo:IAO_0000115 "A drug implant that acts as a birth control device and which is inserted under the skin for drug delivery into the body." ;
