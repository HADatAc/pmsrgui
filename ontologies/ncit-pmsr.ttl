                 rdfs:subClassOf obo:NCIT_C203665 ;
                 obo:IAO_0000115 "A system for whole-genome sequencing that uses a massively parallel sequencing platform that combines an open flow cell design on a circular wafer with a large surface area and mostly natural nucleotides that allow optical end-point detection without reversible terminators. The platform allows for iteratively flowing one nucleotide at a time in order, ensuring that only one nucleotide is responsible for the signal and not requiring the blocking of the other nucleotides, in contrast to traditional technologies that flow all four nucleotides simultaneously." ;
                 obo:NCIT_NHC0 "C203671" ;
                 obo:NCIT_P106 "Manufactured Object" ;
                 obo:NCIT_P108 "Ultima Sequencing Platform" ;
                 oboInOwl:hasExactSynonym "Ultima" ,
                                          "Ultima Genomics" ,
                                          "Ultima Sequencing Platform" ;
                 rdfs:label "Ultima Sequencing Platform" .


