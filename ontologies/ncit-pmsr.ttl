###  http://purl.obolibrary.org/obo/NCIT_C139306
obo:NCIT_C139306 rdf:type owl:Class ;
                 rdfs:subClassOf obo:NCIT_C16462 ;
                 obo:IAO_0000115 "Refers to computer systems capable of a quintillion (10^18) calculations each second. This computing power is expected to facilitate the analysis of data sets that would require too much time with currently available systems. Such analysis would allow more realistic simulations of the complex processes and relationships behind many natural processes. This will have practical applications in everything from precision medicine to regional climate, water use to materials science, nuclear physics to national security." ;
                 obo:NCIT_NHC0 "C139306" ;
                 obo:NCIT_P106 "Manufactured Object" ;
                 obo:NCIT_P108 "Exascale Computer System" ;
                 obo:NCIT_P208 "CL526690" ;
