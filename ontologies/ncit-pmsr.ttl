@prefix : <http://purl.obolibrary.org/obo/ncit.owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ncit: <http://purl.obolibrary.org/obo/ncit#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix protege: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@base <http://purl.obolibrary.org/obo/ncit.owl> .

<http://purl.obolibrary.org/obo/ncit.owl> rdf:type owl:Ontology ;
                                           owl:versionIRI <http://purl.obolibrary.org/obo/ncit/releases/2024-05-07/ncit.owl> ;
                                           protege:defaultLanguage "en" ;
                                           dcterms:description "The NCIt OBO Edition project aims to increase integration of the NCIt with OBO Library ontologies. NCIt is a reference terminology that includes broad coverage of the cancer domain, including cancer related diseases, findings and abnormalities." ;
                                           dcterms:isVersionOf <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl> ;
                                           dcterms:title "NCI Thesaurus OBO Edition" ;
                                           rdfs:comment "NCI Thesaurus, a controlled vocabulary in support of NCI administrative and scientific activities. Produced by the Enterprise Vocabulary System (EVS), a project by the NCI Center for Biomedical Informatics and Information Technology. National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, U.S.A." ;
                                           owl:versionInfo "24.04e" .

#################################################################
#    Annotation properties
#################################################################

###  http://protege.stanford.edu/plugins/owl/protege#defaultLanguage
protege:defaultLanguage rdf:type owl:AnnotationProperty .


###  http://protege.stanford.edu/plugins/owl/protege#readOnly
protege:readOnly rdf:type owl:AnnotationProperty ;
                 rdfs:range xsd:boolean .


###  http://purl.obolibrary.org/obo/IAO_0000115
obo:IAO_0000115 rdf:type owl:AnnotationProperty ;
                obo:IAO_0000115 "A property representing the English language definitions of what NCI means by the concept. They may also include information about the definition's source and attribution in a form that can easily be interpreted by software." ;
                oboInOwl:hasExactSynonym "DEFINITION" ;
                rdfs:label "definition" .


###  http://purl.obolibrary.org/obo/NCIT_A1
obo:NCIT_A1 rdf:type owl:AnnotationProperty ;
            obo:IAO_0000115 "An association that specifies the parent of the branch encompassing a role's domain." ;
            obo:NCIT_NHC0 "A1" ;
            obo:NCIT_P106 "Conceptual Entity" ;
            obo:NCIT_P107 "Role Has Domain" ;
            obo:NCIT_P108 "Role_Has_Domain" ;
            oboInOwl:hasExactSynonym "Role_Has_Domain" ;
            rdfs:label "Role_Has_Domain" ;
            rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A10
obo:NCIT_A10 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association created to allow the source CDRH to assign a parent to each concept with the intent of creating a hierarchy that includes only terms in which they are the contributing source." ;
             obo:NCIT_NHC0 "A10" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P107 "Has CDRH Parent" ;
             obo:NCIT_P108 "Has_CDRH_Parent" ;
             oboInOwl:hasExactSynonym "Has_CDRH_Parent" ;
             rdfs:label "Has_CDRH_Parent" ;
             rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A11
obo:NCIT_A11 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association created to allow the source NICHD to assign a parent to each concept with the intent of creating a hierarchy that includes only terms in which they are a contributing source." ;
             obo:NCIT_NHC0 "A11" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Has_NICHD_Parent" ;
             oboInOwl:hasExactSynonym "Has_NICHD_Parent" ;
             rdfs:label "Has_NICHD_Parent" ;
             rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A12
obo:NCIT_A12 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association created to relate a data element concept to the codelist term that is used to bundle its subset of valid value concepts." ;
             obo:NCIT_NHC0 "A12" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P107 "Has Data Element" ;
             obo:NCIT_P108 "Has_Data_Element" ;
             oboInOwl:hasExactSynonym "Has_Data_Element" ;
             rdfs:label "Has_Data_Element" ;
             rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A13
obo:NCIT_A13 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association that indicates that a finding or lab test is related to a gene, possibly through a variant or product." ;
             obo:NCIT_NHC0 "A13" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Related_To_Genetic_Biomarker" ;
             oboInOwl:hasExactSynonym "Related_To_Genetic_Biomarker" ;
             rdfs:label "Related_To_Genetic_Biomarker" ;
             rdfs:range xsd:anyURI .


###  http://purl.obolibrary.org/obo/NCIT_A14
obo:NCIT_A14 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association that indicates that a neoplastic disease can have the characteristics defined by a Neoplasm by Special Category concept." ;
             obo:NCIT_NHC0 "A14" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Neoplasm_Has_Special_Category" ;
             oboInOwl:hasExactSynonym "Neoplasm_Has_Special_Category" ;
