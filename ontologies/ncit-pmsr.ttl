###  http://purl.obolibrary.org/obo/NCIT_P387
obo:NCIT_P387 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing a unique zero-padded seven digit identifier supplied by the Gene Ontology (GO) that has no inherent meaning or relation to the position of the term in GO and is prefixed by \"GO:\"." ;
              obo:NCIT_NHC0 "P387" ;
              obo:NCIT_P108 "go-id" ;
              obo:NCIT_required "true"^^xsd:boolean ;
              rdfs:label "go-id" ;
              rdfs:range xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:NCIT_P387 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A property representing a unique zero-padded seven digit identifier supplied by the Gene Ontology (GO) that has no inherent meaning or relation to the position of the term in GO and is prefixed by \"GO:\"." ;
   obo:NCIT_P378 "NCI" ;
   obo:NCIT_P381 "http://www.geneontology.org/page/ontology-structure"
 ] .


###  http://purl.obolibrary.org/obo/NCIT_P388
obo:NCIT_P388 rdf:type owl:AnnotationProperty ;
              obo:NCIT_NHC0 "P388" ;
              obo:NCIT_P108 "go-term" ;
              rdfs:label "go-term" .


###  http://purl.obolibrary.org/obo/NCIT_P389
obo:NCIT_P389 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing a three letter code that indicates the type of supporting evidence for each GO_Annotation associated with a concept." ;
              obo:NCIT_NHC0 "P389" ;
              obo:NCIT_P108 "go-evi" ;
              obo:NCIT_required "true"^^xsd:boolean ;
              rdfs:label "go-evi" ;
              rdfs:range xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_P390
obo:NCIT_P390 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the organization that is the supplier or owner of each GO_Annotation associated with a concept." ;
              obo:NCIT_NHC0 "P390" ;
              obo:NCIT_P108 "go-source" ;
              obo:NCIT_required "true"^^xsd:boolean ;
              rdfs:label "go-source" ;
              rdfs:range obo:NCIT_go-source-enum .


###  http://purl.obolibrary.org/obo/NCIT_P391
obo:NCIT_P391 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the date each GO_Annotation was added to a concept." ;
              obo:NCIT_NHC0 "P391" ;
              obo:NCIT_P108 "source-date" ;
              obo:NCIT_required "true"^^xsd:boolean ;
              rdfs:label "source-date" ;
              rdfs:range xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_P392
obo:NCIT_P392 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the term in an outside source that has been mapped to a term within the NCI Thesaurus." ;
              obo:NCIT_NHC0 "P392" ;
              obo:NCIT_P108 "Target_Term" ;
              rdfs:label "Target_Term" ;
              rdfs:range xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_P393
obo:NCIT_P393 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the relationship of the NCI Thesaurus (NCIt) concept to the term from the outside source. There are four possibilities: 1) Has Synonym: the two terms are synonymous; 2) Broader Than: the NCIt concept is broader than the mapped (target) term; 3) Narrower Than: the NCIt concept is narrower than the mapped (target) term; 4) Related To: the NCIt concept is somehow related to the mapped (target) term." ;
              obo:NCIT_NHC0 "P393" ;
              obo:NCIT_P106 "Conceptual Entity" ;
              obo:NCIT_P108 "Relationship_to_Target" ;
              obo:NCIT_required "true"^^xsd:boolean ;
              oboInOwl:hasExactSynonym "Relationship_to_Target" ;
              rdfs:label "Relationship_to_Target" ;
              rdfs:range obo:NCIT_Relationshipt_to_Target-enum .


###  http://purl.obolibrary.org/obo/NCIT_P394
obo:NCIT_P394 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the term type designation in the mapped (target) database." ;
              obo:NCIT_NHC0 "P394" ;
              obo:NCIT_P106 "Conceptual Entity" ;
              obo:NCIT_P108 "Target_Term_Type" ;
              obo:NCIT_required "true"^^xsd:boolean ;
              oboInOwl:hasExactSynonym "Target_Term_Type" ;
              rdfs:label "Target_Term_Type" ;
              rdfs:range obo:NCIT_Target_Term_Type-enum .


###  http://purl.obolibrary.org/obo/NCIT_P395
obo:NCIT_P395 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the code assigned to the target term in the mapped (target) database. Some databases may not have codes." ;
              obo:NCIT_NHC0 "P395" ;
              obo:NCIT_P106 "Conceptual Entity" ;
              obo:NCIT_P108 "Target_Code" ;
              obo:NCIT_P378 "NCI" ;
              obo:NCIT_required "true"^^xsd:boolean ;
              oboInOwl:hasExactSynonym "Target_Code" ;
              rdfs:label "Target_Code" ;
              rdfs:range xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_P396
obo:NCIT_P396 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the name of the terminology to which the NCI Thesaurus term is being mapped." ;
              obo:NCIT_NHC0 "P396" ;
              obo:NCIT_P106 "Conceptual Entity" ;
              obo:NCIT_P108 "Target_Terminology" ;
              obo:NCIT_required "true"^^xsd:boolean ;
              oboInOwl:hasExactSynonym "Target_Terminology" ;
              rdfs:label "Target_Terminology" ;
              rdfs:range obo:NCIT_Target_Terminology-enum .


###  http://purl.obolibrary.org/obo/NCIT_P397
obo:NCIT_P397 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the version of the terminology to which the NCI Thesaurus term is being mapped." ;
