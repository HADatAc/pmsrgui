                 rdfs:range xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_required
obo:NCIT_required rdf:type owl:AnnotationProperty ;
                  rdfs:range xsd:boolean .


###  http://purl.obolibrary.org/obo/NCIT_xref-source
obo:NCIT_xref-source rdf:type owl:AnnotationProperty ;
