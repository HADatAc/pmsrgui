###  http://purl.obolibrary.org/obo/NCIT_A21
obo:NCIT_A21 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association that specifies the timing by which an active ingredient is made available in the body after administration of the pharmaceutical product, in comparison with a conventional, direct release of the active ingredient. The target value should belong to the EDQM-HC Release Characteristics Terminology." ;
             obo:NCIT_NHC0 "A21" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Has_Pharmaceutical_Release_Characteristics" ;
