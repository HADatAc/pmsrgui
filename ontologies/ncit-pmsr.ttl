###  http://purl.obolibrary.org/obo/NCIT_C92760
obo:NCIT_C92760 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C42734 ;
                obo:IAO_0000115 "A dermal patch that contains estrogen and progestin hormones for release and absorption through the skin and into the body to prevent pregnancy." ;
                obo:NCIT_NHC0 "C92760" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Contraceptive Patch" ;
                obo:NCIT_P207 "C2985284" ;
                obo:NCIT_P325 "A medicated adhesive patch that is placed on the skin to deliver estrogen and progestin hormones for release and absorption through the skin and into the body to prevent pregnancy." ;
                oboInOwl:hasExactSynonym "Contraceptive Patch" ;
                rdfs:label "Contraceptive Patch" .


###  http://purl.obolibrary.org/obo/NCIT_C93049
obo:NCIT_C93049 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C50226 ;
                obo:NCIT_NHC0 "C93049" ;
                obo:NCIT_P106 "Manufactured Object" ;
                obo:NCIT_P108 "Ultrasound Transducer" ;
                obo:NCIT_P207 "C2985411" ;
                obo:NCIT_P325 "A device that produces sound waves that bounce off body tissues and make echoes. The transducer also receives the echoes and sends them to a computer that uses them to create a picture called a sonogram. Transducers (probes) come in different shapes and sizes for use in making pictures of different parts of the body. The transducer may be passed over the surface of the body or inserted into an opening such as the rectum or vagina." ;
                oboInOwl:hasExactSynonym "Ultrasound Transducer" ,
                                         "ultrasound transducer" ;
                rdfs:label "Ultrasound Transducer" .


###  http://purl.obolibrary.org/obo/NCIT_C93050
obo:NCIT_C93050 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C49936 ;
                obo:NCIT_NHC0 "C93050" ;
                obo:NCIT_P106 "Manufactured Object" ;
                obo:NCIT_P108 "Gel Electrode" ;
                obo:NCIT_P207 "C3204501" ;
                obo:NCIT_P325 "A device that uses a gel to carry an electric current from the skin to a measuring instrument. A sticky patch may hold the gel electrode on the skin so that the electrical activity of the heart or brain can be measured." ;
                oboInOwl:hasExactSynonym "Gel Electrode" ,
                                         "gel electrode" ;
                rdfs:label "Gel Electrode" .


###  http://purl.obolibrary.org/obo/NCIT_C93052
obo:NCIT_C93052 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16742 ;
                obo:NCIT_NHC0 "C93052" ;
                obo:NCIT_P106 "Manufactured Object" ;
                obo:NCIT_P108 "Autoclave" ;
                obo:NCIT_P207 "C0179177" ;
                obo:NCIT_P325 "A device that uses steam under high pressure to sterilize medical and laboratory supplies and equipment." ;
                oboInOwl:hasExactSynonym "Autoclave" ,
                                         "autoclave" ;
                rdfs:label "Autoclave" .


###  http://purl.obolibrary.org/obo/NCIT_C93053
obo:NCIT_C93053 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16830 ;
                obo:NCIT_NHC0 "C93053" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "CerviPrep" ;
                obo:NCIT_P207 "C2985413" ;
                obo:NCIT_P325 "A device used to deliver drugs directly to the cervix (the lower, narrow end of the uterus that forms a canal between the uterus and vagina). The CerviPrep covers the cervix and protects surrounding tissue. Drugs may be injected into the inner part of the cervix through a syringe attached to the device." ;
                oboInOwl:hasExactSynonym "CerviPrep" ;
                rdfs:label "CerviPrep" .


###  http://purl.obolibrary.org/obo/NCIT_C93054
obo:NCIT_C93054 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C49940 ;
                obo:NCIT_NHC0 "C93054" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Capsule Endoscope" ;
                obo:NCIT_P207 "C1721049" ;
                obo:NCIT_P325 "A device used to look at tissues in the esophagus, stomach, and intestines. It is a capsule with a lens, a light, a camera, a radio transmitter, and a battery inside. The patient swallows the capsule and it takes video pictures of the inner walls of the esophagus, stomach, and intestines as it travels through the digestive tract. The pictures are sent to a small wireless receiver that is worn on the waist of the patient and are later viewed on a computer. The capsule endoscope is passed from the body in the stool." ;
                oboInOwl:hasExactSynonym "Capsule Endoscope" ,
                                         "capsule endoscope" ,
                                         "wireless capsule endoscope" ;
                rdfs:label "Capsule Endoscope" .


###  http://purl.obolibrary.org/obo/NCIT_C93056
obo:NCIT_C93056 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C49940 ;
                obo:NCIT_NHC0 "C93056" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P107 "Tethered Capsule Endoscope" ;
                obo:NCIT_P108 "Tethered Capsule Endoscope" ;
                obo:NCIT_P208 "CL412332" ;
                obo:NCIT_P322 "CTRP" ;
                obo:NCIT_P325 "A device used to look at tissues in the esophagus.  It is a tiny capsule with a laser scanner inside and a very thin cord attached to it. The patient swallows the capsule and the thin cord helps keep the capsule in a specific area in the esophagus.  The cord is also used to remove the capsule. Pictures are taken by the laser scanner and sent to a computer for viewing. A tethered capsule endoscope is used to find early cancers of the esophagus and other parts of the body." ;
                oboInOwl:hasExactSynonym "TCE" ,
                                         "Tethered Capsule Endoscope" ,
                                         "tethered capsule endoscope" ;
                oboInOwl:inSubset obo:NCIT_C116977 ,
                                  obo:NCIT_C118169 ;
                rdfs:label "Tethered Capsule Endoscope" .


###  http://purl.obolibrary.org/obo/NCIT_C93057
obo:NCIT_C93057 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C62103 ;
                obo:NCIT_NHC0 "C93057" ;
                obo:NCIT_P106 "Manufactured Object" ;
                obo:NCIT_P108 "Tourniquet" ;
                obo:NCIT_P207 "C0040519" ;
                obo:NCIT_P325 "A device, such as a strip of cloth or a band of rubber, that is wrapped tightly around a leg or an arm to prevent the flow of blood to the leg or the arm for a period of time. A tourniquet may be used when drawing blood or to stop bleeding after an injury." ;
                oboInOwl:hasExactSynonym "Tourniquet" ,
                                         "tourniquet" ;
                rdfs:label "Tourniquet" .


###  http://purl.obolibrary.org/obo/NCIT_C93088
obo:NCIT_C93088 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C41075 ;
                obo:IAO_0000115 "An implanted device that enables the penis to become erect." ;
                obo:NCIT_NHC0 "C93088" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Penile Implant" ;
                obo:NCIT_P207 "C0030850" ;
                obo:NCIT_P322 "OORO" ;
                obo:NCIT_P325 "A firm rod or inflatable device that is placed in the penis (an external male reproductive organ) during a surgical procedure. The implant makes it possible to have and keep an erection. Penile implants are used to treat erectile dysfunction or impotence." ;
                oboInOwl:hasExactSynonym "Penile Implant" ,
                                         "Penile implant" ,
                                         "penile implant" ;
                oboInOwl:inSubset obo:NCIT_C192234 ;
                rdfs:label "Penile Implant" .


###  http://purl.obolibrary.org/obo/NCIT_C93146
obo:NCIT_C93146 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C69013 ;
                obo:NCIT_NHC0 "C93146" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Jamshidi Needle" ;
                obo:NCIT_P207 "C2985462" ;
                obo:NCIT_P325 "A long, hollow needle with a tapered cutting edge on one end and a handle with a place to attach a syringe on the other end. It is used to remove a sample of tissue from the bone marrow. The needle is inserted through the bone into the bone marrow and the syringe is attached to the top to remove the sample or to deliver drugs or fluid into the bone." ;
                oboInOwl:hasExactSynonym "Jamshidi Needle" ,
                                         "Jamshidi needle" ;
                rdfs:label "Jamshidi Needle" .


###  http://purl.obolibrary.org/obo/NCIT_C93147
obo:NCIT_C93147 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C50128 ;
                obo:IAO_0000115 "A system comprised of a programmable pneumatic compressor controller and appendage-specific air-chambered garments designed to stimulate the lymphatic system and treat lymphedema." ;
                obo:NCIT_NHC0 "C93147" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Compression Pump" ;
                obo:NCIT_P207 "C1314305" ;
                obo:NCIT_P325 "A machine used to keep blood and lymph flowing by pushing air through bands or sleeves that are placed on the arms or legs." ;
                oboInOwl:hasExactSynonym "Compression Pump" ,
                                         "Pneumatic Compression Device" ,
                                         "Pneumatic Compression Pump" ,
                                         "compression pump" ;
                rdfs:label "Compression Pump" .


###  http://purl.obolibrary.org/obo/NCIT_C93155
obo:NCIT_C93155 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16830 ;
                obo:NCIT_NHC0 "C93155" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Endo-Pat 2000" ;
                obo:NCIT_P207 "C2985468" ;
                obo:NCIT_P325 "A medical device that tests to see if endothelial cells are damaged. Endothelial cells line the inner walls of blood vessels, lymph vessels, and the heart, and damage to them may be an early sign of heart disease. Endo-Pat 2000 looks for heart disease by using sensors that measure blood flow through a patient's fingers. It is also being used to check blood vessels in patients treated for breast cancer." ;
                oboInOwl:hasExactSynonym "Endo-Pat 2000" ,
                                         "EndoPat" ;
                rdfs:label "Endo-Pat 2000" .


###  http://purl.obolibrary.org/obo/NCIT_C93237
obo:NCIT_C93237 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C49936 ;
                obo:NCIT_NHC0 "C93237" ;
                obo:NCIT_P106 "Manufactured Object" ;
                obo:NCIT_P108 "Surface Electrode" ;
                obo:NCIT_P207 "C2985511" ;
                obo:NCIT_P325 "A small device that is attached to the skin to measure or cause electrical activity in the tissue under it. Surface electrodes may be used to look for problems with muscles and nerves." ;
                oboInOwl:hasExactSynonym "Surface Electrode" ,
                                         "surface electrode" ;
                rdfs:label "Surface Electrode" .


###  http://purl.obolibrary.org/obo/NCIT_C93238
obo:NCIT_C93238 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C41075 ,
                                obo:NCIT_C80461 ;
                obo:NCIT_NHC0 "C93238" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P107 "Implantable Cardioverter-Defibrillator" ;
                obo:NCIT_P108 "Implantable Cardioverter-Defibrillator" ;
                obo:NCIT_P207 "C0162589" ;
                obo:NCIT_P322 "CTRP" ;
                obo:NCIT_P325 "A small device used to correct a heartbeat that is abnormal (too fast, too slow, or irregular). The device is placed by surgery in the chest or abdomen. Wires are passed through a vein to connect the device to the heart. When it detects abnormal heartbeats, it sends an electrical shock to the heart to restore the heartbeat to normal." ;
                oboInOwl:hasExactSynonym "ICD" ,
                                         "Implantable Cardioverter-Defibrillator" ,
                                         "implantable cardioverter-defibrillator" ;
                oboInOwl:inSubset obo:NCIT_C116977 ,
                                  obo:NCIT_C118169 ;
                rdfs:label "Implantable Cardioverter-Defibrillator" .


###  http://purl.obolibrary.org/obo/NCIT_C93242
obo:NCIT_C93242 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C50344 ;
                obo:NCIT_NHC0 "C93242" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Peripheral Venous Catheter" ;
                obo:NCIT_P207 "C2985513" ;
                obo:NCIT_P325 "A small, flexible tube used to deliver fluids into the body. A needle is used to insert the catheter into a vein, usually in the back of the hand or in the forearm. The tubing is then taped to the skin to hold it in place." ;
                oboInOwl:hasExactSynonym "Peripheral Venous Catheter" ,
                                         "peripheral venous catheter" ;
                rdfs:label "Peripheral Venous Catheter" .


###  http://purl.obolibrary.org/obo/NCIT_C93247
obo:NCIT_C93247 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C69013 ;
                obo:NCIT_NHC0 "C93247" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Acupuncture Needle" ;
                obo:NCIT_P207 "C0181956" ;
                obo:NCIT_P325 "A stainless steel needle that is slightly thicker than a human hair. Acupuncture needles are inserted through the skin at specific points on the body to control pain and other symptoms." ;
                oboInOwl:hasExactSynonym "Acupuncture Needle" ,
                                         "acupuncture needle" ;
                rdfs:label "Acupuncture Needle" .


###  http://purl.obolibrary.org/obo/NCIT_C93277
obo:NCIT_C93277 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16830 ;
                obo:NCIT_NHC0 "C93277" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Trephine" ;
                obo:NCIT_P207 "C0184073" ;
                obo:NCIT_P325 "A surgical tool used to cut out circular pieces of bone or other tissue." ;
                oboInOwl:hasExactSynonym "Trephine" ,
                                         "trephine" ;
                rdfs:label "Trephine" .


###  http://purl.obolibrary.org/obo/NCIT_C93293
obo:NCIT_C93293 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C49940 ;
                obo:NCIT_NHC0 "C93293" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Thoracoscope" ;
                obo:NCIT_P207 "C0183932" ;
                obo:NCIT_P325 "A thin tube-like instrument used to examine the inside of the chest. A thoracoscope has a light and a lens for viewing and may have tool to remove tissue." ;
                oboInOwl:hasExactSynonym "Thoracoscope" ,
                                         "thoracoscope" ;
                rdfs:label "Thoracoscope" .


###  http://purl.obolibrary.org/obo/NCIT_C93294
obo:NCIT_C93294 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C49940 ;
                obo:NCIT_NHC0 "C93294" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Nasoscope" ;
                obo:NCIT_P207 "C0183044" ;
                obo:NCIT_P325 "A thin, tube-like instrument used to examine the inside of the nose. A rhinoscope has a light and a lens for viewing and may have a tool to remove tissue." ;
                oboInOwl:hasExactSynonym "Nasoscope" ,
                                         "nasoscope" ,
                                         "rhinoscope" ;
                rdfs:label "Nasoscope" .


###  http://purl.obolibrary.org/obo/NCIT_C93295
obo:NCIT_C93295 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C49940 ;
                obo:NCIT_NHC0 "C93295" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Mediastinoscope" ;
                obo:NCIT_P207 "C0181792" ;
                obo:NCIT_P325 "A thin, tube-like instrument used to examine the tissues and lymph nodes in the area between the lungs. These tissues include the heart and its large blood vessels, trachea, esophagus, and bronchi. The mediastinoscope has a light and a lens for viewing and may also have a tool to remove tissue. It is inserted into the chest through a cut above the breastbone." ;
                oboInOwl:hasExactSynonym "Mediastinoscope" ,
                                         "mediastinoscope" ;
                rdfs:label "Mediastinoscope" .


###  http://purl.obolibrary.org/obo/NCIT_C93296
obo:NCIT_C93296 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C49940 ;
                obo:NCIT_NHC0 "C93296" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Resectoscope" ;
                obo:NCIT_P207 "C0182966" ;
                obo:NCIT_P325 "A thin, tube-like instrument used to remove tissue from inside the body. A resectoscope has a light and lens for viewing. It also has a tool to remove tissue using an electrical current. It is inserted through the urethra to treat prostate disease in men and through the vagina and cervix to treat abnormal uterine bleeding in women." ;
                oboInOwl:hasExactSynonym "Resectoscope" ,
                                         "resectoscope" ;
                rdfs:label "Resectoscope" .


###  http://purl.obolibrary.org/obo/NCIT_C93299
