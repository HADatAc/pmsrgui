###  http://purl.obolibrary.org/obo/NCIT_P398
obo:NCIT_P398 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property that indicates whether or not a value set is part of a paired set of codelists for publication processing purposes." ;
              obo:NCIT_NHC0 "P398" ;
              obo:NCIT_P106 "Conceptual Entity" ;
              obo:NCIT_P108 "Value_Set_Pair" ;
