###  http://purl.obolibrary.org/obo/NCIT_C17892
obo:NCIT_C17892 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C19747 ;
                obo:IAO_0000115 "Imaging Phantoms are used for the assessment of image quality.  Within these functional categories phantoms can be further defined.  (1) Body Phantoms: have the shape and composition of the human body or part of it.  They are also referred to as anthropomorphic phantoms.  (2) Phantoms that are used for standardization and inter-comparison of various radiation conditions are often referred to as Standards.  (3) Reference Phantoms include phantoms used to derive radiation dose calculations, mineral density equivalences or other similar type measurements.  They can further be defined by their intended modality such as Ultrasound, Mammography, Computed Tomography (CT), etc." ;
                obo:NCIT_NHC0 "C17892" ;
                obo:NCIT_P106 "Manufactured Object" ;
                obo:NCIT_P107 "Imaging Phantoms" ;
                obo:NCIT_P108 "Imaging Phantom" ;
                obo:NCIT_P207 "C0282611" ;
                obo:NCIT_P322 "CTRP" ;
                obo:NCIT_P366 "Imaging_Phantoms" ;
                oboInOwl:hasExactSynonym "Imaging Phantom" ,
                                         "Imaging Phantoms" ,
                                         "Phantom" ;
                oboInOwl:inSubset obo:NCIT_C116977 ,
                                  obo:NCIT_C118169 ;
                rdfs:label "Imaging Phantom" .


