###  http://purl.obolibrary.org/obo/NCIT_P400
obo:NCIT_P400 rdf:type owl:AnnotationProperty ;
              obo:IAO_0000115 "A property representing the numerical Variation ID assigned to a molecular abnormality entry by ClinVar." ;
              obo:NCIT_NHC0 "P400" ;
              obo:NCIT_P106 "Conceptual Entity" ;
              obo:NCIT_P108 "ClinVar_Variation_ID" ;
              oboInOwl:hasExactSynonym "ClinVar_Variation_ID" ;
              rdfs:label "ClinVar_Variation_ID" ;
              rdfs:range xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_P90
obo:NCIT_P90 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "A property representing a fully qualified synonym, contains the string, term type, source, and an optional source code if appropriate. Each subfield is deliniated to facilitate interpretation by software." ;
             obo:NCIT_NHC0 "P90" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P107 "Term & Source Data" ;
             obo:NCIT_P108 "FULL_SYN" ;
             oboInOwl:hasExactSynonym "FULL_SYN" ,
                                      "Synonym with Source Data" ;
             rdfs:label "FULL_SYN" ;
             rdfs:range obo:NCIT_textArea .


###  http://purl.obolibrary.org/obo/NCIT_P92
obo:NCIT_P92 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "A property used by MMHCC to identify the source of various mouse disease concepts." ;
