             obo:NCIT_P107 "Subsource" ;
             obo:NCIT_P108 "Subsource" ;
             oboInOwl:hasExactSynonym "Subsource" ;
             rdfs:label "Subsource" ;
             rdfs:range xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_P93
obo:NCIT_P93 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "A property representing the accession number for a protein within the Swiss-Prot database." ;
             obo:NCIT_NHC0 "P93" ;
