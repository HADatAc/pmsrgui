###  http://purl.obolibrary.org/obo/NCIT_A15
obo:NCIT_A15 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association created to allow the source CTCAE 5.0 to assign a parent to each concept with the intent of creating a hierarchy that includes only terms in which CTCAE is the contributing source." ;
             obo:NCIT_NHC0 "A15" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Has_CTCAE_5_Parent" ;
