###  http://purl.obolibrary.org/obo/NCIT_P96
obo:NCIT_P96 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "A property representing the protein or RNA product expressed by a gene." ;
             obo:NCIT_NHC0 "P96" ;
