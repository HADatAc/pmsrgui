###  http://purl.obolibrary.org/obo/NCIT_A22
obo:NCIT_A22 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association that specifies the procedures that are carried out in order to convert a manufactured item that requires such a procedure into a pharmaceutical product. The target value should belong to the EDQM-HC Transformation Terminology." ;
             obo:NCIT_NHC0 "A22" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Has_Pharmaceutical_Transformation" ;
