###  http://purl.obolibrary.org/obo/NCIT_A20
obo:NCIT_A20 rdf:type owl:AnnotationProperty ;
             obo:IAO_0000115 "An association that specifies the general body sites at which a pharmaceutical product is intended to be administered. The target value should belong to the EDQM-HC Intended Site of Administration Terminology." ;
             obo:NCIT_NHC0 "A20" ;
             obo:NCIT_P106 "Conceptual Entity" ;
             obo:NCIT_P108 "Has_Pharmaceutical_Intended_Site" ;
