obo:NCIT_C42860 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16830 ;
                obo:IAO_0000115 "A plug of absorbent material, e.g. cotton inserted into a body cavity or wound during the surgical intervention to check a flow of blood and arrest hemorrhaging, or to absorb body fluid secretions. Particularly, the concept refers to commercially manufactured small cylinder of cotton or other material which is placed in vagina to absorb menstrual blood." ;
