###  http://purl.obolibrary.org/obo/NCIT_C16738
obo:NCIT_C16738 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C43164 ;
                obo:IAO_0000115 "A device by means of which a medicinal product can be administered by inspiration through the nose or the mouth." ;
                obo:NCIT_NHC0 "C16738" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Inhaler" ;
                obo:NCIT_P207 "C0021461" ;
                obo:NCIT_P317 "Package Type (C-DRG-00907)" ;
                obo:NCIT_P322 "EDQM-HC" ,
                              "FDA" ;
                obo:NCIT_P325 "A device by means of which a medicinal product can be administered by inspiration through the nose or the mouth." ,
                              "A device for giving medicines in the form of a spray that is inhaled (breathed in) through the nose or mouth. Inhalers are used to treat medical problems such as bronchitis, angina, emphysema, and asthma. They are also used to help relieve symptoms that occur when a person is trying to quit smoking." ,
                              "Device for administration of a medicinal product for inhalation. Nebuliser is excluded." ;
                obo:NCIT_P366 "Inhaler" ;
                oboInOwl:hasExactSynonym "INHALER" ,
                                         "Inhaler" ,
                                         "inhaler" ;
                oboInOwl:inSubset obo:NCIT_C133805 ,
                                  obo:NCIT_C133853 ,
                                  obo:NCIT_C148636 ,
                                  obo:NCIT_C150110 ,
                                  obo:NCIT_C54452 ,
                                  obo:NCIT_C54457 ;
                rdfs:label "Inhaler" .


