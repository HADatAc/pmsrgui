###  http://purl.obolibrary.org/obo/NCIT_C42767
obo:NCIT_C42767 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C42734 ;
                obo:IAO_0000115 "A medical contraceptive device of soft flexible material, usually of thin rubber, that is designed to cover the cervix uteri prior to sexual intercourse to prevent the entry of spermatozoa. To enhance efficacy, a spermicidal agent is often placed within the device. Antimicrobial agent(s) can also be used to prevent sexually transmitted diseases. Efficacy of vaginal diaphragm against infections is very limited." ;
                obo:NCIT_NHC0 "C42767" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Vaginal Diaphragm" ;
                obo:NCIT_P207 "C0042241" ;
                obo:NCIT_P325 "A contraceptive device made of soft flexible material, usually of thin rubber, that is designed to cover the cervix uteri prior to sexual intercourse to prevent the entry of spermatozoa." ;
                obo:NCIT_P366 "Vaginal_Diaphragm" ;
                oboInOwl:hasExactSynonym "Diaphragm" ,
                                         "Vaginal Diaphragm" ;
                rdfs:label "Vaginal Diaphragm" .


###  http://purl.obolibrary.org/obo/NCIT_C42769
obo:NCIT_C42769 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16830 ;
                obo:IAO_0000115 "The material used for protecting the wound site from external factors that disrupt healing and cause infection and pain. Effective dressing protects and manages the microenvironment of the healing wound. Management of the wound environment includes consideration of moisture, temperature and the presence of pathogens." ;
                obo:NCIT_NHC0 "C42769" ;
                obo:NCIT_P106 "Medical Device" ;
                obo:NCIT_P108 "Wound Dressing Material" ;
                obo:NCIT_P207 "C1710682" ;
                obo:NCIT_P366 "Wound_Dressing_Material" ;
                oboInOwl:hasExactSynonym "Wound Dressing" ,
                                         "Wound Dressing Material" ;
                rdfs:label "Wound Dressing Material" .


###  http://purl.obolibrary.org/obo/NCIT_C42770
obo:NCIT_C42770 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16830 ;
                obo:NCIT_NHC0 "C42770" ;
                obo:NCIT_P106 "Manufactured Object" ;
                obo:NCIT_P108 "Generator" ;
                obo:NCIT_P207 "C0237638" ;
